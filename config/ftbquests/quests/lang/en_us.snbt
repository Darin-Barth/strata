{
	file.0000000000000001.title: "Strata"
	reward_table.27B22058501FC0DC.title: "Common Supply Bag"
	reward_table.2C273A09128CA2CE.title: "Uncommon Supply Bag"
	reward_table.210FC6DF600A063E.title: "Rare Treasure Bag"
	reward_table.26C01AE3B31659CD.title: "Epic Treasure Bag"
	chapter_group.2EAA9718BAF5A32A.title: "Tech"
	chapter_group.03203A1312E25E36.title: "Magic"
	chapter_group.76581968F62E459A.title: "Exploration"
	chapter_group.2EC6052336A88AD1.title: "Bosses & Combat"
	chapter_group.46FD3EC1FE1391C7.title: "Life & Cozy"
	quest.7B00515BF7869680.title: "Welcome to Strata!"
	quest.7B00515BF7869680.quest_desc: [
		"&6Build. Fly. Explore.&r"
		""
		"Strata is a big modpack with three paths: &bTech&r (machines, trains and airships),"
		"&dMagic&r (spells, rituals and spirits) and &aExploration&r (new dimensions, dungeons and bosses)."
		"There's also a cozy side (farming, cooking, pets, decorating) and a whole Pokémon world."
		""
		"This quest book is your guide. Each chapter on the left covers one big mod."
		"Nothing is locked: jump to whatever looks fun. Quests inside a chapter open up in order."
		""
		"Open the book any time with the book button at the top-left of your inventory."
		"Click the checkmark below to get started!"
	]
	quest.4707DC7691146290.title: "What's That Recipe?"
	quest.4707DC7691146290.quest_desc: [
		"With 400 mods you'll never remember every recipe. You don't have to!"
		""
		"Hover over any item (in your inventory or the item list on the right) and press"
		"&eR&r to see how to make it, or &eU&r to see what it's used for."
		""
		"Type in the search bar to find items. Start with &e@&r to search by mod (&e@create&r)."
		"Just Enough Resources shows what mobs drop and the best heights to mine each ore."
	]
	quest.05FD01447273E1AF.title: "Timber!"
	quest.05FD01447273E1AF.quest_desc: [
		"Chop down a tree: break the bottom log and the whole tree falls (FallingTree)."
		""
		"&eFTB Ultimine&r: hold the &e`&r key (below Esc) while mining to break a whole vein of ore"
		"or a patch of blocks at once. It costs extra hunger, so bring snacks."
	]
	quest.3EDE2ED0C4B6720C.title: "Iron Age"
	quest.3EDE2ED0C4B6720C.quest_desc: [
		"Iron opens almost every mod. Ores show up in big veins deep underground."
		""
		"&eTip:&r Jade (the little box at the top of your screen) tells you what you're looking at"
		"and which tool you need to break it."
		""
		"Weapons swing differently here (&eBetter Combat&r): each weapon has its own combo and reach."
		"&eCombat Roll&r lets you dodge-roll out of trouble (set its key in Options > Controls)."
	]
	quest.3CBEAA09E0AA8A33.title: "A Bag for Everything"
	quest.3CBEAA09E0AA8A33.quest_desc: [
		"Inventory full already? Craft a &eSophisticated Backpack&r."
		""
		"Wear it on your back (or place it down) and press its key (&eB&r by default) to open it."
		"Upgrades go in the slots on its side: pickup, magnet, auto-feeding, crafting, and more."
		"Later, upgrade the backpack itself to iron, gold, diamond and netherite for more room."
		""
		"Inventory Profiles Next adds a &esort&r button to every chest."
	]
	quest.4DC634514C9F61B6.title: "Find Your Way"
	quest.4DC634514C9F61B6.quest_desc: [
		"&eXaero's Minimap&r sits in the corner. Press &eM&r for the full world map."
		""
		"Add waypoints for your base, a cool village or a dungeon (&eU&r opens the waypoint list)."
		"Waystones you discover show up on the map too."
		""
		"&ePing Wheel&r: press the side mouse button to ping a spot for your friends."
		"Voice chat is built in: hold &eV&r (Simple Voice Chat) to talk to players near you."
	]
	quest.74CDBCF76E1C34D2.title: "Better Together"
	quest.74CDBCF76E1C34D2.quest_desc: [
		"Make a team with your friends: open the &eTeams&r button at the top-left of your inventory,"
		"or type &e/ftbteams party create <name>&r and invite the others."
		""
		"Teammates share quest progress (complete a quest once for everyone) and land claims."
		"Each player still claims their own rewards."
	]
	quest.772EB687B23B503B.title: "Home Sweet Claim"
	quest.772EB687B23B503B.quest_desc: [
		"Protect your base with &eFTB Chunks&r. Open its map with the &eMap&r button at the"
		"top-left of your inventory."
		""
		"&eLeft-drag&r over chunks to claim them, &eright-drag&r to unclaim."
		"&eShift + left-drag&r force-loads a chunk so your farms and machines keep running"
		"while you're away (you get a limited number, so pick the important ones)."
		""
		"Claimed land is safe from griefing and explosions."
	]
	quest.2C4E55E84F4EC03E.title: "When Things Go Wrong"
	quest.2C4E55E84F4EC03E.quest_desc: [
		"Dying isn't the end:"
		""
		"&eGraveStone&r: your items wait in a grave where you died. Walk back and open it."
		"&ePlayerRevive&r: when you go down, a friend has a little while to revive you."
		"&eRedomesticate&r: if your tamed pet dies, it can be brought back, so it's never lost for good."
	]
	task.353E403B56265797.title: "Visit the tavern village"
	quest.341779864971F73C.title: "A Tavern Town"
	quest.341779864971F73C.quest_desc: [
		"You start next to a village with a big tavern. It's a good first home base."
		""
		"Villagers trade useful stuff. &eGuard Villagers&r protect them from raids."
		"Look for the &eBounty Board&r: villagers post small jobs (bring items, defeat mobs)"
		"and pay in emeralds and loot."
	]
	quest.4FCC1D07B97286E2.title: "Odd Jobs"
	quest.4FCC1D07B97286E2.quest_desc: [
		"Craft your own &eBounty Board&r for your base, or use one in a village."
		"Right-click it to see the jobs on offer. Finish a bounty by handing in what it asks for."
		"New bounties appear over time."
	]
	quest.318FBADF9FE10E66.title: "Rules of the Road"
	quest.318FBADF9FE10E66.quest_desc: [
		"Strata is built around travel, so a few things are different here:"
		""
		"&cNo free teleporting.&r There's no /home, /back, /rtp or /tpa."
		"&cFlight costs something:&r fuel, power, mana, stamina or durability."
		"No \"wear it and fly forever\" items."
		""
		"That's why trains, airships, elytra, mounts and roads are worth building."
		"You can still earn teleporting later: Mekanism teleporters, Ars Nouveau warps and"
		"blink spells all have a cost."
	]
	task.1ACB2AE8005A5872.title: "Find or craft a Waystone"
	quest.43B65B6F74E24201.title: "Waystones"
	quest.43B65B6F74E24201.quest_desc: [
		"Waystones stand in many villages. Right-click one to activate it: it stays on your list."
		"Using a waystone takes you to any other one you've activated."
		""
		"&eThe catch:&r each trip costs &aXP&r. The farther you go, the more it costs,"
		"and jumping to another dimension costs extra. Short hops are cheap; long trips add up."
		""
		"You can also craft your own (look it up with &eR&r)."
	]
	quest.15654BD960144D8E.title: "The World Gets Harder"
	quest.15654BD960144D8E.quest_desc: [
		"Strata's difficulty rises in steps, for everyone on the server at once:"
		""
		"&aNormal&r: the start."
		"&eExpert&r: after anyone first enters &cthe Nether&r. Mobs hit a bit harder."
		"&cMaster&r: after the &5Ender Dragon&r is defeated."
		""
		"Other dimensions (the End, Twilight Forest, Deeper and Darker) are tougher than home."
		"Bosses always keep their own designed strength."
		"Rare &6elite&r mobs (Apotheosis) carry better gear and drop it. They're rare near spawn."
	]
	quest.65459A133D3C4EFE.title: "Into the Nether"
	quest.65459A133D3C4EFE.quest_desc: [
		"Build a portal from obsidian and light it. Bring armor, food and blocks!"
		""
		"Entering the Nether moves the server to &eExpert&r difficulty."
		"It also unlocks the middle tier of wireless tech: Flux Networks, AE2 wireless terminals"
		"and Mekanism quantum entangloporters."
		""
		"See the &cThe Nether&r chapter for what's out there."
	]
	quest.7542BEE2CB678999.title: "Pick a Path"
	quest.7542BEE2CB678999.quest_desc: [
		"You've got the basics. Now choose what sounds fun. You can do all of them, in any order,"
		"with friends or alone. Each path below points to a chapter."
	]
	quest.5715BCB30A38CA73.title: "Path: Tech"
	quest.5715BCB30A38CA73.quest_desc: [
		"Like building machines? Start with &eCreate&r: spinning shafts, belts, presses, trains"
		"and real airships you build block by block."
		""
		"Make your first &eAndesite Alloy&r, then open &bCreate: Getting Moving&r."
	]
	quest.446B8E87AB946F62.title: "Path: Magic"
	quest.446B8E87AB946F62.quest_desc: [
		"Want to cast spells? &eArs Nouveau&r lets you design your own spells from glyphs."
		""
		"Craft a &eNovice Spell Book&r, then open the &dArs Nouveau&r chapter."
		"Iron's Spells, Occultism and more hook into it later."
	]
	quest.7667ED91A5A376BD.title: "Path: Exploration"
	quest.7667ED91A5A376BD.quest_desc: [
		"The world is huge and full of dungeons, ruins, towers and sky islands."
		""
		"An &eExplorer's Compass&r points to the nearest structure you choose; a &eNature's Compass&r"
		"finds biomes. Open &aExplorer's Guide&r for where to start."
	]
	quest.003414113D5BA7F2.title: "Path: Cozy Life"
	quest.003414113D5BA7F2.quest_desc: [
		"Prefer farming, cooking, pets and decorating? Strata has lots of it."
		""
		"Craft a &eCooking Pot&r and open &aFarming & Food&r."
		"Pets & Critters and Building & Decorating are right next to it."
	]
	quest.65BD001383487C33.title: "Path: The Pokémon World"
	quest.65BD001383487C33.quest_desc: [
		"Pokémon live in their own world, reached through a portal you build yourself."
		""
		"First you need a &eBell Fragment&r: they're rare finds in chests of dungeons, temples,"
		"mineshafts, ancient cities and woodland mansions."
		"Open the &cPokémon World&r chapter for the rest."
	]
	chapter.793E32936A23A83E.title: "Welcome to Strata"
	chapter.793E32936A23A83E.chapter_subtitle: ["Build. Fly. Explore. Start here!"]
	quest.04608463819B44C3.title: "What is Create?"
	quest.04608463819B44C3.quest_desc: [
		"&eCreate&r machines run on &brotation&r: spinning shafts and cogs, like a real workshop."
		"A water wheel or windmill spins a shaft, the shaft runs a press, a belt carries the"
		"results away. No magic boxes: you can see every part move."
		""
		"Everything in Strata's tech path starts here: trains, airships, power and big factories."
		"Take it one machine at a time. This chapter walks you through the basics."
	]
	quest.3A6DACA01A464DD5.title: "Ponder Everything"
	quest.3A6DACA01A464DD5.quest_desc: [
		"Create has a built-in picture book called &ePonder&r."
		""
		"Hover over almost any Create item (in your inventory or the item list) and"
		"&ehold W&r. A little animated scene shows how the block works, step by step."
		"Use it whenever a quest says \"place this next to that\"."
		""
		"Press &eR&r on an item for its recipe and &eU&r for its uses, as always."
	]
	quest.046A8745E864491C.title: "Grab a Wrench"
	quest.046A8745E864491C.quest_desc: [
		"The &eWrench&r is your best friend:"
		"- &eRight-click&r a Create block to rotate it."
		"- &eSneak + right-click&r to pick it up instantly (no breaking, no lost items)."
		""
		"Most mistakes are fixed with one click of the wrench."
	]
	quest.338517D331B64692.title: "Andesite Alloy"
	quest.338517D331B64692.quest_desc: [
		"&eAndesite Alloy&r is the backbone of early Create. Almost every early machine uses it."
		"Mix andesite with iron (or zinc) nuggets: look it up with &eR&r."
		""
		"Tip: a &eMechanical Mixer&r makes it in bulk later."
	]
	quest.397E12F47A1696F9.title: "Shafts and Cogs"
	quest.397E12F47A1696F9.quest_desc: [
		"&eShafts&r carry rotation in a straight line. &eCogwheels&r pass it sideways to the"
		"next cog."
		""
		"A &eLarge Cogwheel&r next to a small one changes the speed: big to small spins"
		"&afaster&r, small to big spins &cslower&r. Speed is measured in &bRPM&r."
	]
	quest.30C4A0BA51427A64.title: "Water Power"
	quest.30C4A0BA51427A64.quest_desc: [
		"Your first real power source. Place a &eWater Wheel&r where flowing water hits its"
		"blades (Ponder it with &eW&r) and it spins forever, for free."
		""
		"Several wheels on one shaft add their strength together."
		"The &eLarge Water Wheel&r is slower but much stronger."
	]
	quest.0C19E96A818B3CBB.title: "Windmills"
	quest.0C19E96A818B3CBB.quest_desc: [
		"Not near water? Build a &eWindmill&r."
		""
		"Place a &eWindmill Bearing&r, build a cross of &eSails&r on the block in front of it,"
		"then right-click the bearing to start it. More sails make more power."
		"Sails can be dyed for fun."
	]
	quest.4783FCDC3A3D4865.title: "Stress and Goggles"
	quest.4783FCDC3A3D4865.quest_desc: [
		"Every power source gives a fixed amount of &bStress Units (SU)&r. Every machine uses"
		"some. If your machines need more SU than you make, the whole network stops"
		"(it's \"overstressed\")."
		""
		"Wear &eEngineer's Goggles&r and look at a block: they show how much SU a source makes,"
		"how much a machine uses, and what's left. Faster spinning machines cost more SU."
	]
	quest.50E893A0FAFD1656.title: "Andesite Casing"
	quest.50E893A0FAFD1656.quest_desc: [
		"Right-click a stripped log or stripped wood with &eAndesite Alloy&r to make"
		"&eAndesite Casing&r. Casings are the bodies of most machines."
		""
		"You can also encase shafts and cogs in casing to tidy up your builds."
	]
	quest.73D37279BAB42206.title: "Mechanical Press"
	quest.73D37279BAB42206.quest_desc: [
		"The &eMechanical Press&r stamps things flat. Put a &eDepot&r (or a belt) under it,"
		"drop iron ingots on, and out come &eIron Sheets&r."
		""
		"Sheets of iron, copper, gold and brass are used everywhere."
	]
	quest.20175D3B7A5EC04A.title: "Mixer and Basin"
	quest.20175D3B7A5EC04A.quest_desc: [
		"A &eMechanical Mixer&r over a &eBasin&r mixes items and fluids, like a giant"
		"crafting bowl. A Press over a Basin &ecompacts&r things instead."
		""
		"Throw ingredients into the basin and let it spin. Recipes that need heat want a"
		"burner under the basin (more on that with brass)."
	]
	quest.52ED050E4CCE07DD.title: "Wash, Smelt, Haunt"
	quest.52ED050E4CCE07DD.quest_desc: [
		"An &eEncased Fan&r blows air. Air passing through a block processes items on the"
		"ground or on a belt in front of it:"
		""
		"&bWater&r: &eBulk Washing&r (sand, gravel, crushed ores)."
		"&6Lava or fire&r: &eBulk Smelting&r (like a furnace with no fuel)."
		"&dSoul fire&r: &eBulk Haunting&r (spooky transformations)."
		"&7Campfire&r: &eBulk Smoking&r (cooks food)."
		""
		"Press &eU&r on an item to see what each fan type does with it."
	]
	quest.43AE6FA2F77C658E.title: "Crushing Ores"
	quest.43AE6FA2F77C658E.quest_desc: [
		"A &eMillstone&r grinds things slowly. Two &eCrushing Wheels&r side by side, spinning"
		"toward each other, crush fast."
		""
		"Crushed ores give extra nuggets when washed and smelted: much more metal per ore."
		"Crushing wheels are hungry for stress, so check your goggles."
	]
	quest.5EB98A332DF8D3FD.title: "Belts and Depots"
	quest.5EB98A332DF8D3FD.quest_desc: [
		"&eMechanical Belts&r connect two shafts and carry items along. Right-click one shaft,"
		"then the other, with the belt in hand."
		""
		"A &eDepot&r holds one stack for a machine to work on."
		"&eFunnels&r put items onto belts and pull them off into chests."
	]
	quest.202B8168C3A6D7AD.title: "Moving Machines"
	quest.202B8168C3A6D7AD.quest_desc: [
		"Create can move whole groups of blocks: these are &eContraptions&r."
		"A &eMechanical Piston&r, &eBearing&r or &eCart Assembler&r moves everything stuck"
		"to it. Use &eSuper Glue&r (drag a box) to stick blocks together."
		""
		"Contraptions are how you build drills, farms, elevators, trains and airships."
	]
	quest.21522309B5319DDD.title: "Drills and Saws"
	quest.21522309B5319DDD.quest_desc: [
		"A &eMechanical Drill&r breaks the block in front of it. On a moving piston or bearing,"
		"it digs tunnels or quarries. Glue a chest to the contraption and it collects the loot."
		""
		"A &eMechanical Saw&r fells trees in front of it, or (facing up, under a belt) cuts"
		"logs into planks and stone into stonecutter shapes. Great for a tree farm."
	]
	quest.13593286B566085E.title: "Farming Machines"
	quest.13593286B566085E.quest_desc: [
		"&eMechanical Harvesters&r on a moving contraption cut ripe crops and leave the"
		"plant to regrow. A &eMechanical Plough&r tills soil as it passes."
		""
		"Put them on a piston or a cart that sweeps over your fields."
	]
	quest.2B21940EBDCD3028.title: "Zinc"
	quest.2B21940EBDCD3028.quest_desc: [
		"&eZinc&r is Create's own ore. Look for it underground (Just Enough Resources shows the"
		"best heights: press &eR&r on zinc ore)."
		""
		"Smelt it into ingots. Crushing it first gives more."
	]
	quest.5D211A040922E5D2.title: "Catch a Blaze"
	quest.5D211A040922E5D2.quest_desc: [
		"Some recipes need heat. Make an &eEmpty Blaze Burner&r, take it to the Nether and"
		"right-click a &cBlaze&r with it to catch it."
		""
		"Put the &eBlaze Burner&r under a basin and feed it fuel (coal, logs, etc.)."
		"A &eBlaze Cake&r makes it &csuperheated&r for the hottest recipes."
	]
	quest.76248815D192799C.title: "Brass"
	quest.76248815D192799C.quest_desc: [
		"Mix &ecopper&r and &ezinc&r in a heated basin (Mixer over Basin over Blaze Burner)"
		"to get &6Brass&r."
		""
		"Brass opens Create's smart parts: filters, arms, deployers, trains and airship parts."
	]
	quest.1FA04D186DC68711.title: "Brass Casing and Tubes"
	quest.1FA04D186DC68711.quest_desc: [
		"Right-click stripped logs with a &eBrass Ingot&r to make &eBrass Casing&r,"
		"just like andesite casing."
		""
		"&eElectron Tubes&r: polish &eRose Quartz&r (quartz + redstone) with &eSand Paper&r,"
		"then craft it with an iron sheet. Tubes go into smart blocks like brass funnels,"
		"tunnels and display links."
	]
	quest.0FC36C389D5FBDF9.title: "Precision Mechanism"
	quest.0FC36C389D5FBDF9.quest_desc: [
		"Your first &eSequenced Assembly&r: an item built step by step on a belt."
		"A golden sheet goes past &eDeployers&r (adding cogwheels and nuggets) and a"
		"&ePress&r, around and around several times. Sometimes it fails and gives scrap."
		""
		"Ponder it with &eW&r and check the steps with &eR&r. Many airship and train parts"
		"need these."
	]
	quest.5914BF8AF325EA7D.title: "Deployers"
	quest.5914BF8AF325EA7D.quest_desc: [
		"A &eDeployer&r is a robot hand: it uses, places or applies whatever it holds,"
		"like a player clicking."
		""
		"Deployers are key for sequenced assembly, auto-casing, farms and even fights."
	]
	quest.275DC84AC05CBE23.title: "Smart Logistics"
	quest.275DC84AC05CBE23.quest_desc: [
		"&eBrass Funnels&r and &eBrass Tunnels&r can be filtered: put an item (or a"
		"&eList Filter&r) in their slot and only that item passes."
		""
		"Tunnels on a belt split items evenly between several belts or machines."
	]
	quest.601D16FD4780110C.title: "Mechanical Arm"
	quest.601D16FD4780110C.quest_desc: [
		"The &eMechanical Arm&r picks items up and puts them down anywhere in its reach."
		"Hold the arm and right-click the blocks it should take from and deliver to,"
		"then place it."
		""
		"It feeds machines from chests, depots and belts with no belts at all."
	]
	quest.46E0C7ACAAD0D347.title: "Mechanical Crafters"
	quest.46E0C7ACAAD0D347.quest_desc: [
		"Some big recipes (up to 9x9!) only work in &eMechanical Crafters&r. Place them in a"
		"grid, point their arrows toward one output corner (wrench), fill the slots and"
		"give them a redstone pulse."
		""
		"Jetpacks, drilling machines and some airship parts need them."
	]
	quest.52A33FE103E57AA3.title: "Pipes and Pumps"
	quest.52A33FE103E57AA3.quest_desc: [
		"&eFluid Pipes&r carry water, lava and other fluids. A &eMechanical Pump&r on the pipe"
		"(powered by rotation) pushes the fluid along. &eFluid Tanks&r stack into big tanks."
		""
		"Fluids feed mixers, steam engines and fuel lines. A &eSpout&r pours fluid into items"
		"under it (filling buckets and bottles); an &eItem Drain&r empties them again."
	]
	quest.570D23C41DB5CB6D.title: "Hidden Ore Veins"
	quest.570D23C41DB5CB6D.quest_desc: [
		"&eCreate Ore Excavation&r adds huge ore veins deep under some chunks. You can't see them;"
		"you drill them with a machine."
		""
		"Right-click with the &eOre Vein Finder&r to learn which vein is in your chunk or"
		"nearby. A &eSample Drill&r (with a copper backtank on top) records a vein's details in"
		"an &eOre Vein Atlas&r."
	]
	quest.193828CB66117C38.title: "Drilling Machine"
	quest.193828CB66117C38.quest_desc: [
		"The &eDrilling Machine&r sits on top of a vein and mines it with rotation, forever or"
		"until the vein runs out. Put a &eDrill&r head in it and give it lots of stress."
		""
		"Some veins need drilling fluid, and the richest need a better drill head."
		"The &eFluid Well Extractor&r works the same way for fluid veins."
	]
	quest.48C35B32C447AC13.title: "Where Next?"
	quest.48C35B32C447AC13.quest_desc: [
		"You know the basics of Create. Pick what's next:"
		""
		"&bCreate: Power & Wires&r: steam engines, electricity and the power ladder."
		"&bCreate: Trains & Trade&r: railways, stations and shops."
		"&bCreate: Airships&r: build a ship and fly it!"
		"&bCreate: Extras&r: enchanting, cannons, kitchens and decoration."
	]
	chapter.1CF3B4AD59E77993.title: "Create: Getting Moving"
	chapter.1CF3B4AD59E77993.chapter_subtitle: ["Rotation, belts, presses and your first machines"]
	quest.442546B4A909B082.title: "Two Kinds of Power"
	quest.442546B4A909B082.quest_desc: [
		"Create runs on &brotation&r (stress, SU). Most other tech mods (Mekanism, AE2, IE) run on"
		"&eelectricity&r (FE). This chapter shows how to make both, and how to turn one into"
		"the other."
		""
		"Strata has a &6power ladder&r. Each step is better than the last:"
		"1. Rotation into a &eCrafts & Additions Alternator&r (easy, but weak)."
		"2. &eCreate: New Age&r generators with coils and magnets (much better)."
		"3. &eNew Age nuclear&r heat into steam engines (huge), next to Mekanism fission and fusion."
	]
	quest.34320614FF714AC8.title: "Steam Engines"
	quest.34320614FF714AC8.quest_desc: [
		"The strongest early rotation in Create. Build a &eboiler&r: Fluid Tanks with a"
		"&eBlaze Burner&r under them, pump in water, and put &eSteam Engines&r on the tank's"
		"sides with a shaft in front."
		""
		"Bigger boilers with more heat run more engines. Look at the tank with Engineer's"
		"Goggles: it tells you what's missing (heat, water or size). Ponder it with &eW&r."
		"A &eBlaze Cake&r makes a burner &csuperheated&r for even more steam."
	]
	quest.659475EAD835359E.title: "The Alternator"
	quest.659475EAD835359E.quest_desc: [
		"&eCrafts & Additions&r turns rotation into electricity. The &eAlternator&r needs at"
		"least &e32 RPM&r; faster spinning gives more FE."
		""
		"In Strata the alternator is kept &cweak on purpose&r: it's your starter generator,"
		"not your power plant. It's still great for charging tools and running a few machines."
	]
	quest.03C705C8EFA48A6A.title: "Electric Motor"
	quest.03C705C8EFA48A6A.quest_desc: [
		"The other direction: the &eElectric Motor&r eats FE and spins a shaft. Scroll on its"
		"back panel to set the RPM; higher RPM uses more power."
		""
		"Handy where water wheels can't go, like deep underground."
	]
	quest.73F1792127FBD31F.title: "Rolling Mill"
	quest.73F1792127FBD31F.quest_desc: [
		"The &eRolling Mill&r presses ingots and plates into &erods&r and &ewires&r with"
		"rotation. Drop ingots on top, or feed it from a belt with funnels."
		""
		"Wires go onto &eSpools&r, and spools make the power lines in the next quest."
	]
	quest.76AE93D8F67D983B.title: "Local Wiring"
	quest.76AE93D8F67D983B.quest_desc: [
		"&eConnectors&r go on generators and machines. Right-click two connectors with a"
		"&eCopper Spool&r to string a wire between them."
		""
		"Wrench a connector to set its mode: &ePull&r on a generator, &ePush&r on a machine."
		"These wires are for &elocal&r use, inside and around your base."
		"(Large Connectors reach farther.)"
	]
	quest.5757813214CF91AA.title: "Storing Power"
	quest.5757813214CF91AA.quest_desc: [
		"The &eAccumulator&r is a battery that grows when you place several together."
		"Give it an input connector and an output connector."
		""
		"Store power from a windmill at night or from a slow generator over time."
	]
	quest.007DB1648C8C6342.title: "Long-Distance Lines"
	quest.007DB1648C8C6342.quest_desc: [
		"For power lines between bases or across the map, Strata uses &eImmersive"
		"Engineering&r wires: &eLV&r (copper), &eMV&r (electrum) and &eHV&r (steel) on poles"
		"with connectors and transformers."
		""
		"Rule of thumb: Crafts & Additions wires inside the base, IE lines between places."
		"See the &bImmersive Engineering&r chapter to build them."
	]
	quest.224A064BF2E49955.title: "Magnets"
	quest.224A064BF2E49955.quest_desc: [
		"&eCreate: New Age&r is the next step up. Its generators need &emagnets&r."
		"&eRedstone Magnets&r are the first kind; stronger magnets come later."
	]
	quest.3CB88CF176CF3433.title: "Coil Generator"
	quest.3CB88CF176CF3433.quest_desc: [
		"Stack &eGenerator Coils&r on a spinning shaft and surround them with magnets."
		"&eCarbon Brushes&r collect the electricity and push it into the block next to them."
		""
		"Stronger magnets turn more of your stress into power, but the coils also use more SU."
		"Ponder it with &eW&r. This beats the alternator by a lot."
		"(New Age's own wires aren't used in Strata: hook the brushes to Crafts & Additions"
		"or IE connectors.)"
	]
	quest.6733AFE7D7E837E3.title: "Stronger Magnets"
	quest.6733AFE7D7E837E3.quest_desc: [
		"&eLayered Magnets&r make your coils far more efficient, and &eNetherite Magnets&r are"
		"the best of all. Swap them in around your coils and watch the output climb."
	]
	quest.5D003A4C921FF808.title: "Energiser"
	quest.5D003A4C921FF808.quest_desc: [
		"The &eEnergiser&r uses electricity and rotation to charge items on a depot or belt"
		"below it. Iron becomes &eOvercharged Iron&r, a key New Age material."
	]
	quest.5A49C2E5C9EFA330.title: "Thorium"
	quest.5A49C2E5C9EFA330.quest_desc: [
		"&eThorium Ore&r is the fuel source for New Age nuclear power. Find it underground"
		"(press &eR&r on thorium ore to see where)."
	]
	quest.6FD133978E33405F.title: "Nuclear Reactor"
	quest.6FD133978E33405F.quest_desc: [
		"A reactor makes &cenormous&r heat. It needs &eReactor Rods&r, a &eFuel Acceptor&r"
		"(feed it &eNuclear Fuel&r) and a &eHeat Vent&r that sends the heat into pipes."
		""
		"&cWarning:&r a running reactor gives off deadly radiation. Wear leather armor or fully"
		"enclose it in Reactor Casing and Reactor Glass. And always use its heat, or it melts"
		"down. Ponder every part with &eW&r before you start."
	]
	quest.437BE2D8AAB411AB.title: "Nuclear Steam"
	quest.437BE2D8AAB411AB.quest_desc: [
		"A &eBoiler Heater&r works like a Blaze Burner under a boiler, but uses heat from pipes"
		"instead of fuel. Pipe your reactor's heat into heaters under a big boiler and run a"
		"wall of steam engines."
		""
		"That's the top of Create's power ladder. Mekanism fission and fusion sit at the same"
		"level."
	]
	quest.7D014BE737860BFA.title: "Plant Oil"
	quest.7D014BE737860BFA.quest_desc: [
		"&eCreate: Diesel Generators&r adds engines that burn liquid fuel for rotation."
		"The easiest fuel is &ePlant Oil&r: compact seeds with a Press over a Basin."
	]
	quest.1340B11137596A5C.title: "Diesel Engine"
	quest.1340B11137596A5C.quest_desc: [
		"Pipe fuel into a &eDiesel Engine&r and it spins a shaft. A redstone signal stops it."
		"Small, strong and portable: great on trains, boats and remote outposts."
		""
		"Better fuels make it stronger: plant oil is the weakest, &eethanol&r and"
		"&ebiodiesel&r are better, &ediesel&r and &egasoline&r from crude oil are best."
		"&eModular&r engines stack, and the &eHuge Diesel Engine&r is the biggest of all."
	]
	quest.1116CAFDF4E6282A.title: "Strike Oil"
	quest.1116CAFDF4E6282A.quest_desc: [
		"Some chunks hide &eCrude Oil&r deep below: right-click an &eOil Scanner&r to see how"
		"much is under you (some biomes have more)."
		""
		"A &ePumpjack&r is a glued contraption that rocks up and down over an oil chunk."
		"Run a straight vertical pipe down to bedrock, cap it with a &ePumpjack Hole&r, and"
		"pump the oil out. Ponder it with &eW&r: it has a few parts."
	]
	quest.1BE520E66CC7FECB.title: "Distillation"
	quest.1BE520E66CC7FECB.quest_desc: [
		"Put a &eDistillation Controller&r on a fluid tank at least 3 blocks tall, heat it and"
		"pump crude oil in at the bottom. Out come &eDiesel&r and &eGasoline&r, the best"
		"engine fuels."
	]
	quest.1027AC0BE5534143.title: "Where Next?"
	quest.1027AC0BE5534143.quest_desc: [
		"Plenty of power? Spend it:"
		""
		"&bImmersive Engineering&r: long power lines and big industrial machines."
		"&bMekanism&r: ore processing, generators, fission and fusion."
		"&bApplied Energistics 2&r: digital storage that runs on FE."
		"&bCreate: Airships&r: engines and thrusters to fly what you build."
	]
	chapter.4524E39579EE697A.title: "Create: Power & Wires"
	chapter.4524E39579EE697A.chapter_subtitle: ["Steam, electricity and the Strata power ladder"]
	quest.28007822CBD71855.title: "Why Trains?"
	quest.28007822CBD71855.quest_desc: [
		"Strata has &cno free teleporting&r, so getting people and stuff around is a big deal."
		"&eCreate trains&r are the answer: you build the train yourself, block by block,"
		"and it drives your tracks on a timetable."
		""
		"Trains carry players, chests and tanks between your bases, mines and farms."
		"Later, they're how goods cross between far-away places before wireless exists."
		""
		"You'll need brass for most train parts (see &bCreate: Getting Moving&r)."
	]
	quest.304038F24BD2CD75.title: "Lay Some Track"
	quest.304038F24BD2CD75.quest_desc: [
		"&eTrain Track&r is placed like rails, but it curves and slopes smoothly."
		"Click one spot, then click where the track should end: it builds the whole curve."
		"Ponder it with &eW&r for the rules on curves and slopes."
		""
		"Train tracks don't need power; trains do the work."
	]
	quest.1E5E7FC155E9A1FA.title: "Train Station"
	quest.1E5E7FC155E9A1FA.quest_desc: [
		"Hold a &eTrain Station&r, right-click a track, then place the station beside it."
		"Stations are where trains are &eassembled&r, &edisassembled&r and where they stop."
		"Name each station: schedules use the names."
	]
	quest.4FE45EB0201EAAFB.title: "Build a Train"
	quest.4FE45EB0201EAAFB.quest_desc: [
		"Right-click the track at the station with &eTrain Casing&r to place a &ebogey&r."
		"Build your train on top, add &eTrain Controls&r facing the front, glue it with"
		"Super Glue, and click &eAssemble&r on the station."
		""
		"Sit at the controls and drive with your movement keys. Start small!"
		"&eChairs&r (Bits 'n' Bobs, Interiors) keep passengers seated; &eHeadlamps&r and"
		"Steam 'n' Rails smokestacks and whistles make it look the part."
	]
	quest.42995CFE0F4D1F80.title: "Timetables"
	quest.42995CFE0F4D1F80.quest_desc: [
		"A &eTrain Schedule&r tells a train where to go and how long to wait."
		"Write stops into it, then right-click a mob sitting at the controls (or yourself"
		"seated) with it. That mob becomes the &econductor&r and the train runs by itself."
		""
		"Loop between two stations and you have a shuttle."
	]
	quest.58AF49BE06074724.title: "Signals"
	quest.58AF49BE06074724.quest_desc: [
		"More than one train on a line? Use &eTrain Signals&r to split track into sections."
		"A train waits until the section ahead is empty, so trains don't crash."
		""
		"&eSemaphores&r from Steam 'n' Rails go on a pole above a signal and show its state"
		"like a real railway. A &eDisplay Link&r on a station can write the next arrival"
		"onto &eDisplay Boards&r or Bits 'n' Bobs &eNixie Boards&r."
	]
	quest.61924917FA8A581C.title: "Handcar"
	quest.61924917FA8A581C.quest_desc: [
		"&eSteam 'n' Rails&r adds lots of train extras. The &eHandcar&r is a tiny ready-made"
		"rail vehicle: put it on a track and ride. Pick it up again with a wrench."
		"It also adds &enarrow&r, &ewide&r and &emonorail&r tracks, each with its own bogeys."
	]
	quest.13DEF8CF86B973A3.title: "Coupling Cars"
	quest.13DEF8CF86B973A3.quest_desc: [
		"The &eTrain Coupler&r joins two trains into one, or splits them apart, without"
		"disassembling anything. Select a track, place the coupler next to it and power it"
		"with redstone when the cars line up. Stations help with lining up."
	]
	quest.018C677F670443BF.title: "Track Switches"
	quest.018C677F670443BF.quest_desc: [
		"A &eTrack Switch&r forces trains at a junction to go left, right or straight."
		"Use it to cycle, or control it with redstone. Brass switches are fancier."
	]
	quest.7837EDF0D266E661.title: "A Robot Conductor"
	quest.7837EDF0D266E661.quest_desc: [
		"No spare mob to drive your train? Put a &eConductor's Cap&r on an"
		"&eAndesite Casing&r and it becomes a little &eConductor&r that can run a schedule."
		""
		"Conductors also press buttons and flip levers you look at, and can wear a toolbox."
	]
	quest.3BF77F58475D9B08.title: "Packages"
	quest.3BF77F58475D9B08.quest_desc: [
		"Create can wrap items into &epackages&r with an address written on them."
		"A &ePackager&r on a chest boxes up its items; packages then travel by belt, chain"
		"conveyor or train to the place with the matching name."
		""
		"Ponder the Packager with &eW&r: it's the start of Create's delivery network."
	]
	quest.4311A579483630F2.title: "Frogports and Chains"
	quest.4311A579483630F2.quest_desc: [
		"&eChain Conveyors&r string chains between cogs; packages ride along them."
		"A &ePackage Frogport&r (yes, a frog) catches and sends packages at each end."
		""
		"Trains can carry packages too, using &ePostboxes&r at stations."
	]
	quest.420B879E15D7522B.title: "Order from Storage"
	quest.420B879E15D7522B.quest_desc: [
		"A &eStock Ticker&r lists everything in the connected storage. Order what you need"
		"and it packages it up and sends it to you."
	]
	quest.542BE67E9CCBEA13.title: "Open a Shop"
	quest.542BE67E9CCBEA13.quest_desc: [
		"&eCreate: Additional Logistics&r adds a &eCash Register&r: a stock ticker for shops that"
		"writes every sale into a &eSales Ledger&r. Click a stock keeper with the ledger to"
		"restock what sold."
		""
		"It also adds the &ePackage Editor&r (rewrite addresses) and &eLazy Shafts&r"
		"(cheaper long shaft lines)."
	]
	quest.0714147122E95D0B.title: "Bigger Storage"
	quest.0714147122E95D0B.quest_desc: [
		"&eCreate: Connected&r adds handy blocks: the &eItem Silo&r (a vault that stacks"
		"upward), the horizontal &eFluid Vessel&r, extra gearboxes and clutches, and the"
		"&eKinetic Battery&r that stores rotation."
	]
	quest.7BD95B1FE0C3C05A.title: "Money, Money"
	quest.7BD95B1FE0C3C05A.quest_desc: [
		"&eCreate: Numismatics&r adds coins: &eSpur&r, &eBevel&r, &eSprocket&r, &eCog&r,"
		"&eCrown&r and &eSun&r, from smallest to biggest. Hover over a coin to see its value."
		""
		"Coins can't be crafted. Here are a few to start your economy. Sell things to friends"
		"and they flow around the server."
	]
	quest.26C16B2F19AFD374.title: "Vendors"
	quest.26C16B2F19AFD374.quest_desc: [
		"A &eVendor&r is a shop block. Sneak-right-click to set it up: what it sells"
		"(or buys), how many, and the price in coins. Friends right-click it to trade,"
		"even when you're offline."
		""
		"Tip: drag an item from the EMI list into the filter slot to set it."
		"A &eDepositor&r gives a redstone pulse when someone pays it: a ticket gate for your"
		"train, or a toll bridge."
	]
	quest.55294DAEC0E98EAC.title: "Open a Bank Account"
	quest.55294DAEC0E98EAC.quest_desc: [
		"The &eBank Terminal&r opens your account: deposit coins so you don't carry them."
		"A &eBank Card&r bound to your account pays at vendors and depositors."
		""
		"A &eBanking Guide&r on a Blaze Burner makes a &eBlaze Banker&r: a shared account,"
		"perfect for a team treasury."
	]
	quest.15260F758E6DF62B.title: "Automatic Villager Trades"
	quest.15260F758E6DF62B.quest_desc: [
		"&eCreate: Trading Floor&r's &eTrading Depot&r goes next to a villager's workstation."
		"Feed it the trade items and the villager trades automatically, all day."
		"(Villagers only trade during their working hours.) Two depots together handle"
		"trades that need two items."
	]
	quest.0779B40F49A54980.title: "Where Next?"
	quest.0779B40F49A54980.quest_desc: [
		"Rails are down and the shops are open. Next:"
		""
		"&bCreate: Airships&r: take your goods into the sky."
		"&bCreate: Power & Wires&r: diesel engines and steam for bigger trains."
		"&bLogistics&r and &bStorage&r: more ways to move and keep items."
	]
	chapter.5F4AAB36EBD18AA6.title: "Create: Trains & Trade"
	chapter.5F4AAB36EBD18AA6.chapter_subtitle: ["Railways, stations, packages and shops"]
	quest.63388EAC96C1BCEC.title: "Build. Fly. Explore."
	quest.63388EAC96C1BCEC.quest_desc: [
		"This is what Strata is named for. With &eCreate Aeronautics&r you build a ship out of"
		"normal blocks, any shape you like, and it becomes a real physics object: it floats,"
		"tilts, falls and flies. &eAviator's Goggles&r show thrust, lift and airflow."
		""
		"Every airship needs three things:"
		"&b1. Lift&r: a balloon full of hot air or steam (or Levitite later)."
		"&b2. Thrust&r: propellers or thrusters, spun or fueled from on board."
		"&b3. Control&r: a steering wheel, levers or a cockpit."
		""
		"Start tiny. A raft with a balloon and one propeller is a perfect first ship."
	]
	quest.783C76EC0E2AC850.title: "Physics Assembler"
	quest.783C76EC0E2AC850.quest_desc: [
		"Build your ship, put a &ePhysics Assembler&r on it, and select the ship with"
		"&eSuper Glue&r (or &eHoney Glue&r): drag a box around it. Then hold right-click on"
		"the assembler and pull its lever."
		""
		"Your build is now a &eSimulated Contraption&r. Walk on it, open chests on it, use"
		"machines on it. Any Physics Assembler turns it back into blocks."
		""
		"Ponder the assembler with &eW&r first!"
	]
	quest.18DADAF3D944D54E.title: "Balloon Fabric"
	quest.18DADAF3D944D54E.quest_desc: [
		"&eHot Air Envelope&r blocks are balloon walls (wool and sticks). Build a closed,"
		"airtight bag with them: hot air fills it from the top down."
		""
		"A bigger balloon gives more lift. Blocks inside the balloon take up space and"
		"reduce lift. Right-click with dye to paint it."
	]
	quest.433948AAA3290AA5.title: "Hot Air Burner"
	quest.433948AAA3290AA5.quest_desc: [
		"Put a &eHot Air Burner&r under the balloon's opening and give it a &eredstone&r"
		"signal: it fills the balloon above with hot air and your ship rises."
		""
		"A stronger signal means more hot air. Set the maximum on its panel."
		"Ships settle where lift and weight balance, so &ea lever and a redstone dial are your"
		"altitude control&r. Several burners can share one balloon."
	]
	quest.62A876ACF58FA5E2.title: "Propellers"
	quest.62A876ACF58FA5E2.quest_desc: [
		"Floating is nice; going somewhere is better. An &eAndesite Propeller&r (or Wooden"
		"Propeller) pushes air when its shaft spins. Reverse the spin (or wrench it) to"
		"reverse the thrust."
		""
		"Propellers need &erotation on board&r: see the Portable Engine quest."
	]
	quest.26232D7606FCD4FE.title: "Portable Engine"
	quest.26232D7606FCD4FE.quest_desc: [
		"Water wheels don't fly. The &ePortable Engine&r burns fuel to make rotation right on"
		"your ship, in either direction. Funnels or chutes can feed it fuel."
		""
		"A &eBlaze Cake&r superheats it for extra power. Bring spare fuel on long trips!"
	]
	quest.0A5CB8E008A1D705.title: "Big Propellers"
	quest.0A5CB8E008A1D705.quest_desc: [
		"A &ePropeller Bearing&r spins whatever you build on its front as a propeller."
		"Any shape counts as long as it has at least two sail-like blocks; more sails means"
		"more thrust. Big props on big ships!"
		""
		"Air gets thinner the higher you go, so propellers push less at high altitude."
	]
	quest.5F712498B0E2B857.title: "Steering Wheel"
	quest.5F712498B0E2B857.quest_desc: [
		"Hold right-click on a &eSteering Wheel&r and move the mouse to turn it; it gives a"
		"precise rotation to whatever it's connected to (like a bearing that swings a rudder"
		"or tilts a propeller). Sneak to snap to 45°."
		""
		"A &eThrottle Lever&r is a smooth redstone dial: drag it to set 0 to 15. Perfect for"
		"a burner or a thruster."
	]
	quest.7232439EC642B58E.title: "How High?"
	quest.7232439EC642B58E.quest_desc: [
		"Air pressure drops as you climb, so lift and thrust get weaker the higher you go."
		"That gives every ship a natural ceiling."
		""
		"The &eAltitude Sensor&r reads the air pressure as a redstone signal. Wire it to your"
		"burner to hold a steady height on autopilot. A &eNavigation Table&r with a compass"
		"or map points its redstone toward a destination, so a ship can steer itself."
	]
	quest.64A57EAF14842E46.title: "Helicopters"
	quest.64A57EAF14842E46.quest_desc: [
		"A normal propeller pointing up makes a wobbly helicopter. The &eGyroscopic Propeller"
		"Bearing&r tries to keep its propeller upright, so your chopper stays level."
		""
		"It needs a &eGyroscopic Mechanism&r, made by sequenced assembly like a precision"
		"mechanism. A redstone signal resets its tilt."
	]
	quest.26A2BCFAB2D6CC1D.title: "Steam Balloons"
	quest.26A2BCFAB2D6CC1D.quest_desc: [
		"The &eSteam Vent&r fills a balloon with &esteam&r from a boiler on your ship. Like a"
		"steam engine, it needs heat (Blaze Burners), water and enough boiler size."
		""
		"Bigger ships, bigger boilers. Redstone controls it like a hot air burner."
	]
	quest.24A56D9A8785DC08.title: "Build a Cockpit"
	quest.24A56D9A8785DC08.quest_desc: [
		"&eCreate: Aeroworks&r adds proper flight controls. Put &eControl Modules&r (levers,"
		"throttles, joysticks, yokes, pedals, buttons) into the sockets of a &eControl Stand&r"
		"or &eControl Desk&r."
		""
		"Sneak-right-click to bind each control to keys and Redstone Link frequencies."
		"Right-click with an empty hand to take control; press &eEsc&r to let go."
		"Consoles that touch become one deck. &eMechanical Servos&r turn rudders to an exact"
		"angle, and a &eGyroscope&r helps keep the ship level."
	]
	quest.7456DDD6C086E6FA.title: "Drive-By-Wire"
	quest.7456DDD6C086E6FA.quest_desc: [
		"Running redstone across a big ship is messy. &eDrive-By-Wire&r &eCables&r connect a"
		"redstone source to any block on the same assembled ship directly."
		""
		"Bind a controller to a &eLinked Controller Hub&r and run the whole network from the"
		"controller. A &eBackup Block&r saves your wiring when you turn the ship into a"
		"schematic. Got a game pad? The &eTweaked Linked Controller&r maps its sticks and"
		"triggers to Redstone Link frequencies."
	]
	quest.049D8DD9D517E11B.title: "Contraption Controller"
	quest.049D8DD9D517E11B.quest_desc: [
		"&eAeronautics: Gadgets & Gizmos&r adds the &eSable Contraption Controller&r: map flight"
		"controls to keys, redstone, wireless frequencies or blocks on your ship, all in one"
		"place."
		""
		"The same mod adds &eSmart Glasses&r (live force readouts), &eShip Couplers&r for"
		"towing, and &eNavigation Tables&r that steer toward a map target."
	]
	quest.04A7BB677B55524E.title: "Thrusters"
	quest.04A7BB677B55524E.quest_desc: [
		"No propeller needed: a Gadgets & Gizmos &eThruster&r burns fuel (solid or liquid) and"
		"pushes your ship away from its nozzle. Redstone sets the throttle: 0 off, 15 full."
		""
		"Mount it on a &eServo Bearing&r to swing the thrust around. &eRCS Thrusters&r have four"
		"small nozzles for fine steering and run on rotation instead of fuel."
	]
	quest.74F3A2D58D3FCC57.title: "Propulsion Thrusters"
	quest.74F3A2D58D3FCC57.quest_desc: [
		"&eCreate Propulsion&r thrusters burn &eTurpentine&r: crush spruce logs for"
		"&ePine Resin&r, then mix it with water in a basin."
		""
		"Pipe turpentine into a Propulsion &eThruster&r and give it redstone: directional"
		"thrust. Eight thrusters in a 2x2x2 cube (or 27 in a 3x3x3) merge into one big engine"
		"fed from the back."
		""
		"Later: the &eIon Thruster&r runs on FE, &eVector Thrusters&r tilt their own nozzle,"
		"and light &eWings&r make fast ships fly more like planes."
	]
	quest.620E9F82581ED3E6.title: "Ropes and Winches"
	quest.620E9F82581ED3E6.quest_desc: [
		"Tie two contraptions (or a contraption and the ground) together: right-click a"
		"&eRope Winch&r and a connector with a &eRope Coupling&r. Spin the winch to reel the"
		"rope in and out."
		""
		"Lower cargo from a hovering ship, or tow a barge! Right-click a rope while holding a"
		"wrench to slide down it."
	]
	quest.1ECF127E8A7853AC.title: "Land Vehicles"
	quest.1ECF127E8A7853AC.quest_desc: [
		"Not everything has to fly. &eOffroad&r (part of Aeronautics) adds &eWheel Mounts&r"
		"and tires. Spin the mounts and build a car, a truck or a rover."
		""
		"The &eBorehead Bearing&r with &eRock Cutting Wheels&r turns a vehicle into a tunnel"
		"borer."
	]
	quest.3750952052DCC209.title: "Levitite"
	quest.3750952052DCC209.quest_desc: [
		"&dLevitite&r is a magic crystal that holds a ship up all by itself. Crush &eEnd Stone&r"
		"into powder, mix it with zinc nuggets and water in a heated basin to get Levitite"
		"Blend, then heat the blend so it crystallizes. It spreads through the whole pool."
		""
		"Levitite can't climb by itself (you still need thrust), and it drags at low speed."
		"You'll need End Stone, so this one waits until you reach &5the End&r."
	]
	quest.1DEC83835B7C0DF1.title: "Steam Jetpacks"
	quest.1DEC83835B7C0DF1.quest_desc: [
		"&eCreate Stuff 'N Additions&r jetpacks let you fly a little, and they &cburn fuel&r"
		"every second you use them."
		""
		"&eAndesite Jetpack&r: burns fuel like coal (refill at a &eFueling Tank&r)."
		"&eCopper&r: high-pressure water (refill at a &eFilling Tank&r or with water buckets)."
		"&eBrass&r: water and fuel together, as steam. Each one has a height limit."
		"To refill by hand, hold the jetpack in your offhand and drop the fuel (see its tooltip)."
	]
	quest.1D014DA12ECBA898.title: "Create Jetpack"
	quest.1D014DA12ECBA898.quest_desc: [
		"The &eCreate Jetpack&r runs on &bpressurized air&r, like a backtank: it empties while"
		"you fly. Place it down and spin it with rotation to refill it, just like a Copper"
		"Backtank. It has a hover mode and its own keys (see Options > Controls)."
		""
		"It's a big mechanical-crafter recipe with an &eElytra&r inside, so it's a late reward."
		"A netherite version exists too."
	]
	quest.783CF8E97CA2C30F.title: "Where Next?"
	quest.783CF8E97CA2C30F.quest_desc: [
		"You can fly! Now go places:"
		""
		"&aExplorer's Guide&r: sky islands, far-off structures and new biomes to land at."
		"&bCreate: Trains & Trade&r: run a cargo line between ship docks."
		"&bCreate: Extras&r: mount Big Cannons on your ship (pirates!)."
		""
		"Tip: Distant Horizons (optional, client-side) shows far terrain while you fly."
	]
	chapter.1E8103434794C1ED.title: "Create: Airships"
	chapter.1E8103434794C1ED.chapter_subtitle: ["Build it, glue it, fly it"]
	quest.2CE02480ED16B5F8.title: "More Create"
	quest.2CE02480ED16B5F8.quest_desc: [
		"Create has a huge family of add-ons. This chapter is a sampler: pick whatever looks fun."
		""
		"&dEnchanting&r with liquid experience, &cBig Cannons&r, &aautomated cooking&r, and a"
		"pile of &6building blocks&r and tools for making your factories look great."
	]
	quest.19E1BFFB7B5C8909.title: "Liquid Experience"
	quest.19E1BFFB7B5C8909.quest_desc: [
		"&eCreate: Enchantment Industry&r turns XP into a fluid: &eLiquid Experience&r."
		"The &eExperience Hatch&r on a tank lets you pour your own levels in (and take them"
		"back out). Store it in tanks and pipe it like any fluid."
		""
		"Spilled liquid experience turns back into XP orbs."
	]
	quest.7DDB1FBFB2B1D212.title: "Mechanical Grindstone"
	quest.7DDB1FBFB2B1D212.quest_desc: [
		"Right-click an &eItem Drain&r with a &eMechanical Grindstone&r to make a &eGrindstone"
		"Drain&r, then put another grindstone on top. It grinds XP nuggets and other"
		"experience items into Liquid Experience."
		""
		"Mob farms with crushing wheels or deployers drop &eNuggets of Experience&r for it."
	]
	quest.58ADAEC0CA27A87C.title: "Blaze Enchanter"
	quest.58ADAEC0CA27A87C.quest_desc: [
		"An automatic enchanting table. Feed it Liquid Experience, set the enchanting level on"
		"its panel and give it items: it enchants them."
		""
		"Put an item in its filter slot to pick which kind of enchantments you get, onto"
		"&eEnchanting Templates&r. Some enchantments only show up at lower levels."
	]
	quest.7BC5F25FE8BA81A3.title: "Blaze Forger"
	quest.7BC5F25FE8BA81A3.quest_desc: [
		"An automatic anvil that runs on Liquid Experience, with &ano repair cost&r. It merges"
		"enchantments, applies templates to items, or pulls an enchantment off onto a blank"
		"template."
	]
	quest.05F0584FDCF4CFCB.title: "Printer"
	quest.05F0584FDCF4CFCB.quest_desc: [
		"The &ePrinter&r copies things: written books, enchanted books, train schedules,"
		"clipboards, package addresses and names. Set the item in its filter, feed it the"
		"right fluid and blank items. Press &eU&r on the printer to see every recipe."
	]
	quest.7025960CC259AC83.title: "Create Big Cannons"
	quest.7025960CC259AC83.quest_desc: [
		"Build real artillery out of blocks. A cannon is a line of parts: a &eCannon End&r"
		"at the back, &eChambers&r for powder, then &eBarrels&r. Put it on a &eCannon Mount&r"
		"(with rotation to aim) and assemble it."
		""
		"Start with a wooden &eLog Cannon&r. Later cannons are cast from molten metal in"
		"moulds and bored out with a &eCannon Drill&r."
		""
		"Explosions are real, but &aclaimed land is protected&r: blocks in claims don't"
		"break."
	]
	quest.7F6A741D658F1D37.title: "Load and Fire"
	quest.7F6A741D658F1D37.quest_desc: [
		"Load &ePowder Charges&r first, then a shot. A &eSolid Shot&r is a big iron ball;"
		"&eHE Shells&r explode (they need a &efuze&r). More powder means more range, but too"
		"much for the cannon's material can burst it!"
		""
		"Give the mount a redstone signal to fire."
	]
	quest.26E00188648CF254.title: "Cast Iron Cannons"
	quest.26E00188648CF254.quest_desc: [
		"&eCast Iron&r cannons are stronger and take bigger charges. A &eSliding Breech&r at the"
		"back lets you reload without taking the cannon apart."
		""
		"Later: bronze, steel and nethersteel, autocannons and quick-firing breeches. Mount one"
		"on an airship for sky battles!"
	]
	quest.1098C2FC6DECF34C.title: "Slice & Dice"
	quest.1098C2FC6DECF34C.quest_desc: [
		"&eCreate: Slice & Dice&r adds the &eSlicer&r: a powered cutting board. Right-click it"
		"with a knife (or another tool) and it cuts items below it automatically, using"
		"Farmer's Delight cutting recipes."
		""
		"It also adds the &eSprinkler&r: put it under a pipe to water crops (or splash mobs)."
	]
	quest.6568A027C358DF45.title: "Central Kitchen"
	quest.6568A027C358DF45.quest_desc: [
		"&eCreate: Central Kitchen&r teaches Create to cook Farmer's Delight food (and its"
		"add-ons):"
		""
		"- Funnels fill and empty &eCooking Pots&r; Blaze Burners heat them faster."
		"- Deployers with a knife, or Mechanical Saws, use the &eCutting Board&r."
		"- Mechanical Arms put ingredients on boards and take food off."
		""
		"Ponder a cooking pot or cutting board with &eW&r to see the setups."
	]
	quest.0FB0C7901DB43D07.title: "Create Deco"
	quest.0FB0C7901DB43D07.quest_desc: [
		"&eCreate Deco&r adds industrial building blocks: catwalks, metal bars, sheet metal,"
		"train hulls, cage lamps, windows, doors and supports in every Create metal."
		""
		"Most are made in a stonecutter or from metal sheets."
	]
	quest.6528CE620EA26EE0.title: "Copycats+"
	quest.6528CE620EA26EE0.quest_desc: [
		"&eCopycat&r blocks take the look of any block you right-click them with. &eCopycats+&r"
		"adds dozens of shapes: slopes, slices, layers, beams, stairs, doors and even"
		"copycat cogwheels and shafts."
		""
		"Great for ship hulls and curved roofs."
	]
	quest.0D76822401C5DBBC.title: "Interiors"
	quest.0D76822401C5DBBC.quest_desc: [
		"&eCreate: Interiors&r adds &echairs&r, floor chairs and cushions. Sit on a chair on a"
		"moving contraption and you stay put: perfect for trains and airship cabins."
	]
	quest.3A5D73DEF01891B6.title: "Mechanical Chisel"
	quest.3A5D73DEF01891B6.quest_desc: [
		"&eRechiseled: Create&r adds Create-themed &eRechiseled&r block variants and the"
		"&eMechanical Chisel&r, a Create-powered chisel for turning blocks into their"
		"variants in bulk (Ponder it with &eW&r)."
	]
	quest.21EC00735652D87B.title: "Mech Trowel"
	quest.21EC00735652D87B.quest_desc: [
		"The &eMech Trowel&r places blocks picked from a palette you set up, so walls and"
		"floors get a natural mixed look. Upgrade it in a smithing table with templates:"
		"a wand mode, longer reach, or taking blocks from your AE2 storage."
	]
	quest.505538BDF541B20B.title: "Transmission Chains"
	quest.505538BDF541B20B.quest_desc: [
		"&eCreate: Transmission&r adds &eTransmission Chains&r: chain drives that pass rotation"
		"between belts. They can be encased like other Create parts. Ponder them with &eW&r."
	]
	quest.22E7E36A3B952810.title: "Dragons Plus"
	quest.22E7E36A3B952810.quest_desc: [
		"&eCreate: Dragons Plus&r adds new fan processing: air through &epowder snow&r"
		"&bfreezes&r, through &eliquid dye&r it &ecolors&r items, through &esand-like"
		"catalysts&r it &esands&r them, and through &5Dragon's Breath&r it does \"ending\"."
		""
		"The &eFluid Hatch&r makes a tank easy to fill and empty with buckets."
	]
	quest.73539F21D8E87BD9.title: "Where Next?"
	quest.73539F21D8E87BD9.quest_desc: [
		"&bCreate: Airships&r: put a cannon on a ship."
		"&bFarming & Food&r: more recipes for your automatic kitchen."
		"&bBuilding & Decorating&r: more blocks for your bases."
	]
	chapter.6964F1BD9320BD29.title: "Create: Extras"
	chapter.6964F1BD9320BD29.chapter_subtitle: ["Enchanting, cannons, kitchens and building blocks"]
	quest.6F24E32004ECDD00.title: "What is Immersive Engineering?"
	quest.6F24E32004ECDD00.quest_desc: [
		"Immersive Engineering (IE) is old-school industry: you build machines as"
		"&ebig multiblock structures&r out of special blocks, then whack them with a hammer"
		"to bring them to life."
		""
		"It's also Strata's &epower grid&r: copper, electrum and steel wires strung between"
		"poles carry power between your buildings."
	]
	quest.04726D2580B13190.title: "Engineer's Hammer"
	quest.04726D2580B13190.quest_desc: [
		"The hammer is IE's main tool."
		""
		"&eRight-click&r a finished pile of blocks with it to &eform a multiblock&r."
		"In a crafting grid, hammer + ingot makes a &eplate&r, and hammer + ore makes grit."
		"It also rotates and configures IE blocks."
	]
	quest.3A1BFFDF85EB4FB7.title: "Engineer's Manual"
	quest.3A1BFFDF85EB4FB7.quest_desc: [
		"Every IE multiblock has an exact shape. The &eEngineer's Manual&r shows each one"
		"layer by layer, with a list of the blocks you need."
		""
		"Keep it in your hotbar while you build."
	]
	task.713A31EC2BF6177C.title: "27 Coke Bricks"
	quest.34D21B3F4CD59637.title: "Coke Oven"
	quest.34D21B3F4CD59637.quest_desc: [
		"Your first multiblock: a &e3x3x3 cube of Coke Bricks&r."
		"Hit the middle block of one side with the hammer to form it."
		""
		"Put in coal and it slowly bakes it into &eCoal Coke&r, plus &eCreosote Oil&r"
		"(fill buckets from it). Charcoal works too."
	]
	quest.4F85C78FC89A029B.title: "Treated Wood"
	quest.4F85C78FC89A029B.quest_desc: [
		"Planks soaked in Creosote Oil become &eTreated Wood&r. It's the frame for lots of"
		"IE machines, posts and the Engineer's Workbench."
		""
		"Treated wood posts make nice poles for your power lines later."
	]
	task.2A0463543779E564.title: "27 Blast Bricks"
	quest.5EBD18A2C5A0C832.title: "Blast Furnace and Steel"
	quest.5EBD18A2C5A0C832.quest_desc: [
		"Another 3x3x3 cube, this time of &eBlast Bricks&r. Form it with the hammer."
		""
		"Feed it &eiron&r and &eCoal Coke&r and it slowly makes &eSteel Ingots&r."
		"Steel is used all over IE (and other mods too)."
		""
		"Later, Reinforced Blast Bricks build the Improved Blast Furnace, which"
		"Blast Furnace Preheaters can speed up."
	]
	quest.09F10406E3713DC5.title: "Engineer's Workbench"
	quest.09F10406E3713DC5.quest_desc: [
		"The Workbench crafts from &eBlueprints&r. Put a blueprint in the slot and it shows"
		"what it can make."
		""
		"The &eComponents&r blueprint makes Mechanical Components (iron and steel) and parts"
		"for electronics. Machines need lots of them."
	]
	quest.023F166F4BC04C6C.title: "Mechanical Components"
	quest.023F166F4BC04C6C.quest_desc: [
		"Iron Mechanical Components are iron plates plus copper; steel ones use steel plates."
		"You'll need a stack of each sooner or later."
		""
		"Tip: the &eMetal Press&r multiblock makes plates for you once you have power."
	]
	quest.02800A33E282F11E.title: "Making Power"
	quest.02800A33E282F11E.quest_desc: [
		"IE makes power from moving things. A &eWater Wheel&r or &eWindmill&r turns a"
		"&eKinetic Dynamo&r, which outputs power (FE)."
		""
		"Want more? Later the &eDiesel Generator&r burns biodiesel for lots of it."
		"Create rotation, Crafts & Additions and Mekanism power all plug into the same grid."
	]
	quest.5227D3236DE20E36.title: "LV Power Lines"
	quest.5227D3236DE20E36.quest_desc: [
		"&eLow Voltage&r is copper wire. Place &eLV Wire Connectors&r on machines, posts or"
		"accumulators, then right-click one connector with an &eLV Wire Coil&r and right-click"
		"the other to string a wire between them."
		""
		"Each wire has a maximum length, so put poles in between for long runs."
		"LV is fine around a base."
	]
	quest.553DE022FCBC9C43.title: "Storing Power"
	quest.553DE022FCBC9C43.quest_desc: [
		"An &eLV Accumulator&r stores power. Use one as a battery between your generators"
		"and machines."
		""
		"It's also a good meeting point: wire IE lines into it on one side and run"
		"Crafts & Additions or Mekanism cables out of it on the other."
	]
	quest.75079355B8A89F1E.title: "MV Power Lines"
	quest.75079355B8A89F1E.quest_desc: [
		"&eMedium Voltage&r uses &eElectrum&r wire (gold + silver). It carries more power"
		"than copper. Connectors and wire must match: MV wire only goes on MV connectors."
	]
	quest.08478A935B0514A0.title: "Transformers"
	quest.08478A935B0514A0.quest_desc: [
		"A &eTransformer&r links two voltages: LV on one side, MV on the other."
		"That's how you step power up for a long run and back down at the other end."
		""
		"The &eHV Transformer&r does the same between MV and HV."
	]
	quest.0179AD1E229DFE2E.title: "HV: The Long-Distance Grid"
	quest.0179AD1E229DFE2E.quest_desc: [
		"&eHigh Voltage&r steel lines are Strata's long-distance power. They carry the most"
		"power and reach the farthest between poles."
		""
		"&6Plan a grid:&r HV between buildings and outposts, a substation (HV Transformer, then"
		"a Transformer) at each end, and LV or Mekanism cables inside."
		"There's no wireless power early on, so a real power line is the way to move energy."
	]
	quest.4A69185969BDB2AE.title: "Crusher"
	quest.4A69185969BDB2AE.quest_desc: [
		"The &eCrusher&r is a big multiblock that grinds ore into grit: about two dusts per"
		"ore, which you smelt into ingots. It also crushes cobble, bones and more."
		""
		"Build it from Steel Scaffolding, Light Engineering Blocks and a few other parts"
		"(check the manual), then form it with the hammer and power it."
	]
	quest.014E2854DB5DD399.title: "Metal Press"
	quest.014E2854DB5DD399.quest_desc: [
		"The &eMetal Press&r stamps ingots with &emolds&r: plates, gears, rods and wire."
		"Way faster than hammering plates by hand."
		""
		"Make the &ePlate Mold&r on the Workbench (Molds blueprint) to get started."
	]
	quest.64BBE352F88C5E91.title: "Finding Mineral Veins"
	quest.64BBE352F88C5E91.quest_desc: [
		"Huge &emineral veins&r hide deep under the ground in each chunk area."
		""
		"Place a &eCore Sample Drill&r and give it power: it drills down and hands you a"
		"&eCore Sample&r that tells you what's under that spot. The Mineral Survey Tools"
		"give a rough hint while you're out exploring."
	]
	quest.178442E12BEF8880.title: "The Excavator"
	quest.178442E12BEF8880.quest_desc: [
		"The &eExcavator&r is IE's biggest machine: a giant bucket wheel that digs ore"
		"straight out of a mineral vein for a very long time."
		""
		"Build it (plus its bucket wheel) on a good vein you found with core samples. It needs a lot of"
		"power, so it's a great reason to run an HV line out to it."
	]
	quest.3A1B14FE1685DCBB.title: "Where next?"
	quest.3A1B14FE1685DCBB.quest_desc: [
		"You've got steel, machines and a power grid. Some ideas:"
		""
		"&bMekanism&r: turn one ore into up to five ingots."
		"&bApplied Energistics 2&r: a digital storage system for all that loot."
		"&bCreate&r: the Crusher pairs nicely with Create's own ore processing."
	]
	chapter.46241502AD047BC9.title: "Immersive Engineering"
	chapter.46241502AD047BC9.chapter_subtitle: ["Big chunky machines, steel and real power lines"]
	quest.50FC705889B14CE1.title: "What is Mekanism?"
	quest.50FC705889B14CE1.quest_desc: [
		"Mekanism is a big tech mod about &eprocessing&r: its machines turn one ore into two,"
		"three, four or even five ingots, using gases like oxygen and hydrogen along the way."
		""
		"It also has strong generators, energy storage, a jetpack, teleporters and, at the"
		"very end, the &5MekaSuit&r."
		""
		"Machines run on power (FE). Any generator from another mod works too."
	]
	quest.2FFB22C0A92AC872.title: "Osmium"
	quest.2FFB22C0A92AC872.quest_desc: [
		"&eOsmium&r is Mekanism's main metal. Its blue-grey ore is common underground."
		"Smelt the raw ore into ingots."
		""
		"Keep an eye out for &eTin&r, &eLead&r, &eUranium&r and &eFluorite&r ores too:"
		"Mekanism uses all of them later."
	]
	quest.413043436901FC89.title: "Metallurgic Infuser"
	quest.413043436901FC89.quest_desc: [
		"The &eMetallurgic Infuser&r mixes a metal with an infusion material."
		"Put coal or charcoal in the left slot for &8carbon&r, redstone for &credstone&r,"
		"diamonds for &bdiamond&r, and so on. Then put the metal in the middle."
		""
		"Osmium + redstone makes a &eBasic Control Circuit&r. Iron + carbon makes Enriched Iron."
	]
	quest.6EFD224463062E8F.title: "Mekanism Steel"
	quest.6EFD224463062E8F.quest_desc: [
		"Steel takes two trips through the infuser:"
		"iron + carbon = &eEnriched Iron&r, then Enriched Iron + carbon = &eSteel Dust&r."
		"Smelt the dust into a &eSteel Ingot&r."
		""
		"(IE steel works for most recipes too.)"
	]
	quest.3054E52D93CA7854.title: "Steel Casing"
	quest.3054E52D93CA7854.quest_desc: [
		"The &eSteel Casing&r is the frame inside almost every Mekanism machine."
		"Make a few: you'll go through them fast."
	]
	quest.39D714F252160877.title: "Control Circuits"
	quest.39D714F252160877.quest_desc: [
		"Circuits are the brains of every machine. The &eBasic Control Circuit&r comes from"
		"osmium + redstone in the infuser."
		""
		"Each higher tier needs the alloy of the same tier, so circuits and alloys go up"
		"together."
	]
	quest.5F7A540095AB638D.title: "Alloys"
	quest.5F7A540095AB638D.quest_desc: [
		"&eInfused Alloy&r: copper + redstone in the infuser."
		"&eReinforced Alloy&r: Infused Alloy + diamond."
		"&eAtomic Alloy&r (later): Reinforced Alloy + refined obsidian."
		""
		"Alloys upgrade circuits, machines, cables and energy cubes to the next tier."
	]
	quest.1EE2955765873671.title: "Better Circuits"
	quest.1EE2955765873671.quest_desc: [
		"Circuit + two matching alloys = the next circuit:"
		"Basic, &eAdvanced&r, &eElite&r and finally &5Ultimate&r."
		""
		"Elite parts open up the bigger factories and faster cables."
	]
	quest.4F5DCBFF90D4D0B2.title: "Ore x2: Enrichment"
	quest.4F5DCBFF90D4D0B2.quest_desc: [
		"The &eEnrichment Chamber&r turns one ore into &etwo dusts&r. Smelt them for two ingots."
		"Every later step builds on this one, so don't throw it out."
		""
		"It also makes Enriched Carbon and Enriched Redstone, a denser feed for the infuser."
	]
	quest.31F4CF2DDEBFD3E0.title: "Splitting Water"
	quest.31F4CF2DDEBFD3E0.quest_desc: [
		"The &eElectrolytic Separator&r splits water into &eHydrogen&r and &eOxygen&r gas."
		"Pipe water in and power it. Store the gases in chemical tanks or send them"
		"straight to machines."
		""
		"Oxygen powers the next ore step. Hydrogen fuels the jetpack."
	]
	quest.7C745861B1432F14.title: "Ore x3: Purification"
	quest.7C745861B1432F14.quest_desc: [
		"The &ePurification Chamber&r uses &eoxygen&r to turn one ore into &ethree clumps&r."
		"Then: clumps go into a &eCrusher&r for dirty dust, dirty dust into the"
		"&eEnrichment Chamber&r for dust, and dust into a furnace."
		""
		"That's a production line: connect the machines with pipes and let it run."
	]
	quest.4EF1FA3E3FC2E0E5.title: "Ore x4: Injection"
	quest.4EF1FA3E3FC2E0E5.quest_desc: [
		"The &eChemical Injection Chamber&r uses &eHydrogen Chloride&r to turn one ore into"
		"&efour shards&r, which feed into the Purification Chamber line."
		""
		"Hydrogen Chloride is hydrogen + chlorine in a &eChemical Infuser&r. Chlorine comes"
		"from brine. Press &eR&r on any gas in EMI to see where it comes from."
	]
	quest.7ECF31965A8DA279.title: "Ore x5: Dissolution"
	quest.7ECF31965A8DA279.quest_desc: [
		"The top step. The &eChemical Dissolution Chamber&r dissolves ore in &eSulfuric Acid&r"
		"into a dirty slurry, the &eChemical Washer&r cleans it with water, and the"
		"&eChemical Crystallizer&r turns it into &efive crystals&r per ore."
		""
		"Crystals go into the Injection Chamber and down the rest of the line."
		"It's a big build. Do it with friends!"
	]
	quest.361801063C73217A.title: "Factories"
	quest.361801063C73217A.quest_desc: [
		"A &eFactory&r is several machines in one block: it works on 3, 5, 7 or 9 items at once"
		"depending on tier. Upgrade a machine into a factory with a &eTier Installer&r,"
		"or craft one directly."
		""
		"&eSpeed&r and &eEnergy Upgrades&r (in the machine's side tab) help too."
	]
	quest.79CF753B18D26C5E.title: "Digital Miner"
	quest.79CF753B18D26C5E.quest_desc: [
		"The &eDigital Miner&r mines a huge area underground without you being there,"
		"only taking the blocks you filter for (say, all ores)."
		""
		"It uses a lot of power and needs Atomic Alloy. Set its filters, give it a chest"
		"and power, and press start."
	]
	quest.6A8F57016EA74218.title: "Cables, Pipes and Tubes"
	quest.6A8F57016EA74218.quest_desc: [
		"&eUniversal Cables&r carry power. &eMechanical Pipes&r carry fluids."
		"&ePressurized Tubes&r carry gases. &eLogistical Transporters&r carry items."
		""
		"Use the &eConfigurator&r (or the machine's side config tab) to pick which sides"
		"push and pull. Inside a base these are all you need; for long distances, IE power"
		"lines and trains do the job."
	]
	quest.5CFE979B8D29AEC3.title: "Energy Cubes"
	quest.5CFE979B8D29AEC3.quest_desc: [
		"An &eEnergy Cube&r stores power. Set its sides to input or output in its GUI."
		"Upgrade it with alloys and circuits for much more storage."
		""
		"Really big storage comes later: the &eInduction Matrix&r multiblock."
	]
	quest.10C6333621CA1716.title: "First Generators"
	quest.10C6333621CA1716.quest_desc: [
		"&bMekanism Generators&r adds its own power."
		""
		"&eHeat Generator&r: burns fuel, and gets a bonus from lava next to it."
		"&eSolar Generator&r: free power while the sun is up."
		"Neither is huge, but they get you started."
	]
	quest.29D30397236FD53B.title: "Wind and Gas"
	quest.29D30397236FD53B.quest_desc: [
		"&eWind Generator&r: the higher you build it, the more it makes."
		"&eGas-Burning Generator&r: burns gas fuel like &eEthylene&r for a lot of power."
		""
		"For truly big power you need a reactor."
	]
	quest.450FD4F2B4192C24.title: "Fission Reactor"
	quest.450FD4F2B4192C24.quest_desc: [
		"The &eFission Reactor&r is a multiblock that burns fuel made from uranium."
		"It makes heat; pair it with an &eIndustrial Turbine&r to turn that into power."
		""
		"&cCareful:&r a reactor without enough cooling can melt down and spread radiation."
		"Wear a Hazmat suit, add redstone safety controls and read up on reactor design"
		"before turning it on."
		""
		"Its waste is useful: it leads to polonium and plutonium."
	]
	quest.418978ACFC21C8F0.title: "Fusion Reactor"
	quest.418978ACFC21C8F0.quest_desc: [
		"The &eFusion Reactor&r is Mekanism's biggest generator. It burns deuterium and"
		"tritium and needs a powerful laser blast to start."
		""
		"Once it runs it makes enormous amounts of power. A true late-game project."
	]
	quest.59A4A7CF1DE61FBB.title: "Mekanism Tools"
	quest.59A4A7CF1DE61FBB.quest_desc: [
		"&bMekanism Tools&r adds tools and armour from Mekanism's metals: osmium, bronze,"
		"steel, lapis, glowstone and the very strong &erefined obsidian&r."
		""
		"Each also has a &ePaxel&r: pickaxe, axe and shovel in one."
	]
	quest.2173882612578849.title: "Refined Obsidian Armour"
	quest.2173882612578849.quest_desc: [
		"&eRefined Obsidian&r is one of the toughest metals around."
		"Obsidian is crushed, infused with diamond and compressed with osmium into ingots"
		"(press &eR&r on the ingot to follow the chain)."
		""
		"A full set is great armour for the dangerous dimensions."
	]
	quest.5834D7EFBA5EBAD1.title: "Jetpack"
	quest.5834D7EFBA5EBAD1.quest_desc: [
		"The &eJetpack&r lets you fly, but it burns &eHydrogen&r the whole time."
		"Fill it from an Electrolytic Separator or a chemical tank. When the tank's empty,"
		"you fall, so watch the gauge!"
		""
		"Toggle its mode (normal or hover) with its key in Options > Controls."
	]
	quest.6A68A0DFD3EFE9B8.title: "Teleporter"
	quest.6A68A0DFD3EFE9B8.quest_desc: [
		"Earned teleporting! Build a &eTeleporter&r inside a doorway of &eTeleporter Frames&r"
		"at each place you want to link, and give them the same &efrequency&r."
		""
		"Every jump costs &epower&r, and longer trips cost more. There's a teleporter only"
		"where someone built one, so a network takes real work."
	]
	quest.550C948E3F573CF8.title: "Quantum Entangloporter"
	quest.550C948E3F573CF8.quest_desc: [
		"Mid-game wireless. Two &eQuantum Entangloporters&r on the same frequency act like"
		"one block: items, fluids, gases, power and heat put into one come out of the other."
		""
		"It needs Atomic Alloy and an Ultimate Control Circuit, so it's a real investment."
		"It's part of Strata's wireless tier that opens after the Nether."
	]
	quest.704A0A13B6F0CE96.title: "Ultimate Tier"
	quest.704A0A13B6F0CE96.quest_desc: [
		"The &5Ultimate&r tier: the fastest factories, biggest cubes and thickest cables."
		""
		"In Strata the top tier is meant for after you've beaten the"
		"&cNetherite Monstrosity&r (Cataclysm). Boss drops will be part of the recipes."
	]
	quest.7962AB82AD302E11.title: "Supercritical Phase Shifter"
	quest.7962AB82AD302E11.quest_desc: [
		"The &eSPS&r is a huge multiblock that turns polonium into &dantimatter&r."
		"It eats an enormous amount of power."
		""
		"Antimatter goes into the &eAntiprotonic Nucleosynthesizer&r and the very best"
		"MekaSuit parts."
	]
	quest.377F016E75BAE2FF.title: "Antimatter"
	quest.377F016E75BAE2FF.quest_desc: [
		"An &dAntimatter Pellet&r is one of the most expensive items in Mekanism."
		"Crystallize the antimatter from your SPS into pellets."
		""
		"Congratulations: your power grid is officially huge."
	]
	quest.7D3FCF5342B7F7D8.title: "The MekaSuit"
	quest.7D3FCF5342B7F7D8.quest_desc: [
		"The &5MekaSuit&r is the best armour in Mekanism. It runs on &epower&r and takes"
		"&emodules&r (installed at a Modification Station) for things like vision, speed"
		"and protection."
		""
		"&6Flight:&r its jetpack module burns hydrogen and its gravitational module drains"
		"a lot of power. It's a late-game reward, and it's never free."
		""
		"Made from netherite armour, polonium pellets and Ultimate circuits, after beating"
		"&cIgnis&r."
	]
	quest.5707BA7976B24317.title: "Where next?"
	quest.5707BA7976B24317.quest_desc: [
		"&bApplied Energistics 2&r: store everything your ore line makes. Applied Mekanistics"
		"even lets it store gases."
		"&bImmersive Engineering&r: HV lines carry your reactor's power across the map."
		"&bEndgame&r: Draconic Evolution needs a lot of power."
	]
	chapter.10138904D2605D92.title: "Mekanism"
	chapter.10138904D2605D92.chapter_subtitle: ["Ore processing, gases, power and the MekaSuit"]
	quest.3AFE93CCBD7FD906.title: "What is Applied Energistics 2?"
	quest.3AFE93CCBD7FD906.quest_desc: [
		"AE2 turns your items into &edata&r. Thousands of items live inside small"
		"&estorage cells&r, and one &eterminal&r lets you search and grab any of them."
		""
		"Later it &eautocrafts&r: ask for 64 machines and it makes every part itself."
		""
		"AE2 has its own built-in guide. Item tooltips tell you which key opens it."
	]
	quest.6C5198D45FAF283B.title: "Meteorite Compass"
	quest.6C5198D45FAF283B.quest_desc: [
		"AE2 starts with a crater. &eMeteorites&r have crashed all over the world."
		""
		"Craft a &eCharger&r and a &eCrank&r (attach the crank to the charger and right-click"
		"it to power the charger by hand). Charge a normal compass to get a &eMeteorite Compass&r:"
		"it points to the nearest meteorite."
	]
	quest.4CA6BD9C2E0FFA73.title: "Find a Meteorite"
	quest.4CA6BD9C2E0FFA73.quest_desc: [
		"A meteorite is a ball of dark &eSky Stone&r. Dig into it:"
		""
		"The middle holds a &emysterious cube&r with the four &einscriber presses&r."
		"Around it you'll find &eBudding Certus Quartz&r, which grows certus crystals."
		"Grab the sky stone too, it's used in recipes."
	]
	quest.33F8E054F5C30742.title: "Certus Quartz"
	quest.33F8E054F5C30742.quest_desc: [
		"Budding certus grows &ecertus buds&r on its sides. Mine fully grown clusters for crystals."
		""
		"Budding blocks wear down as they grow. Bring some home and build a little farm;"
		"a &eGrowth Accelerator&r next to them speeds it up a lot."
	]
	quest.26748975E838E619.title: "Charged Certus"
	quest.26748975E838E619.quest_desc: [
		"Put certus crystals in the &eCharger&r to make &eCharged Certus Quartz&r."
		"You can crank it by hand, but it's much nicer once it has power."
	]
	quest.2B0CE1F24865E907.title: "Fluix Crystals"
	quest.2B0CE1F24865E907.quest_desc: [
		"Throw a &eCharged Certus Quartz&r, a &eRedstone&r and a &eNether Quartz&r into a pool"
		"of water together. After a moment they turn into &etwo Fluix Crystals&r."
		""
		"Fluix is in nearly everything AE2 makes, especially cables."
	]
	quest.00060F4D791D0CDE.title: "Growth Accelerator"
	quest.00060F4D791D0CDE.quest_desc: [
		"Place a &eGrowth Accelerator&r next to budding certus and give it power."
		"Your quartz farm grows several times faster."
	]
	quest.1EDC12F3B3E54499.title: "The Inscriber"
	quest.1EDC12F3B3E54499.quest_desc: [
		"The &eInscriber&r presses things with the presses you found in meteorites."
		"Press goes in the top slot, material in the middle."
		""
		"It can also copy a press: put an iron block in with it. Make spares"
		"for your friends!"
	]
	quest.676732E5BFC1AC18.title: "Silicon"
	quest.676732E5BFC1AC18.quest_desc: [
		"Grind certus into dust (the Inscriber does it with no press) and smelt the dust into"
		"&eSilicon&r. Press silicon with the &eSilicon Press&r for &ePrinted Silicon&r."
	]
	quest.13B69A7A24B07CDF.title: "Processors"
	quest.13B69A7A24B07CDF.quest_desc: [
		"Processors are made in two steps:"
		"1. Press &egold&r (Logic), &ecertus&r (Calculation) or &ediamond&r (Engineering)"
		"with its press to get a printed circuit."
		"2. Put the printed circuit on top, printed silicon on the bottom and"
		"&eredstone&r in the middle."
		""
		"Automate this early. You'll need hundreds."
	]
	quest.5C6C580F128E6151.title: "ME Controller"
	quest.5C6C580F128E6151.quest_desc: [
		"The &eME Controller&r is the heart of the network. Feed it power through an"
		"&eEnergy Acceptor&r (it takes FE from any mod)."
		""
		"Everything else connects to it with &eFluix cables&r."
	]
	quest.371DDE1D5A4E48D4.title: "Cables and Channels"
	quest.371DDE1D5A4E48D4.quest_desc: [
		"Each device on the network uses a &echannel&r. A normal cable carries &e8&r channels;"
		"a &edense&r cable carries &e32&r. Smart cables light up to show how many are in use."
		""
		"Tip: run dense cable as the backbone from the controller and branch off with"
		"normal cable."
	]
	quest.6C62A8F37B434F8B.title: "ME Drive and Storage Cells"
	quest.6C62A8F37B434F8B.quest_desc: [
		"An &eME Drive&r holds up to 10 &estorage cells&r. A cell holds a set amount of"
		"data and a limited number of &edifferent&r item types."
		""
		"Bigger cells (4k, 16k, 64k, 256k) hold more. Keep similar things on one cell."
	]
	quest.62967E589692A5C0.title: "Terminals"
	quest.62967E589692A5C0.quest_desc: [
		"The &eME Terminal&r shows everything stored. Search, sort and grab."
		"The &eCrafting Terminal&r adds a crafting grid that pulls ingredients straight"
		"from the network."
		""
		"Put one in your base and say goodbye to chest-diving."
	]
	quest.1D9FEE7CF036927F.title: "Import, Export and Storage Buses"
	quest.1D9FEE7CF036927F.quest_desc: [
		"&eImport Bus&r: pulls items out of a machine into the network."
		"&eExport Bus&r: pushes chosen items into a machine."
		"&eStorage Bus&r: lets the network see into a chest, a drawer wall or a"
		"Sophisticated Storage chest as if it were a cell."
		""
		"Connect your Mekanism ore line and let AE2 feed it."
	]
	quest.7E0A00ED7902A6A7.title: "Bigger Cells"
	quest.7E0A00ED7902A6A7.quest_desc: [
		"Cell components stack up: four 1k components make a 4k, four 4k make a 16k,"
		"and so on. Put the component in a cell housing."
		""
		"There are &efluid cells&r too, for lava, water and everything Mekanism pumps out."
	]
	quest.141DCC208DADA2C5.title: "Crafting CPU"
	quest.141DCC208DADA2C5.quest_desc: [
		"Autocrafting needs a &eCrafting CPU&r: a solid box of &eCrafting Units&r with at"
		"least one &eCrafting Storage&r block, attached to the network."
		""
		"More storage handles bigger jobs; &eCo-Processing Units&r make it faster."
	]
	quest.618495C15FF3CA19.title: "Patterns"
	quest.618495C15FF3CA19.quest_desc: [
		"A &ePattern&r is a recipe saved on a card. Write them in the"
		"&ePattern Encoding Terminal&r: put in the recipe, press encode."
		""
		"Crafting-table recipes and machine recipes (smelting, crushing...) both work."
	]
	quest.5A58857FD0D63BB0.title: "Autocrafting"
	quest.5A58857FD0D63BB0.quest_desc: [
		"A &ePattern Provider&r holds patterns and sends ingredients out."
		"Put a &eMolecular Assembler&r next to it for crafting-table recipes,"
		"or point it at any machine (a furnace, a Mekanism chamber) for processing."
		""
		"Now ask the terminal for something you don't have and it'll make it."
	]
	quest.25FFD273A2AA7866.title: "ExtendedAE"
	quest.25FFD273A2AA7866.quest_desc: [
		"&bExtendedAE&r adds bigger versions of AE2 blocks: the &eExtended Pattern Provider&r"
		"holds many more patterns, plus extended interfaces, drives, buses and inscribers."
		""
		"The &eAssembler Matrix&r multiblock is a giant crafting factory."
	]
	quest.65709EEF9E35032A.title: "Infinite Water and Cobble"
	quest.65709EEF9E35032A.quest_desc: [
		"ExtendedAE's &eME Infinity Cell&r holds an endless supply of one basic thing,"
		"like water or cobblestone. Perfect for machines that eat them."
	]
	quest.159B21446AB19DE4.title: "Applied Flux: Power in the Network"
	quest.159B21446AB19DE4.quest_desc: [
		"&bApplied Flux&r adds &eFE Storage Cells&r: they store power inside your ME network,"
		"like a battery in a drive. Its parts can push that power into machines on the"
		"network."
		""
		"Press &eR&r on the cell to see its parts."
	]
	quest.1296763B70EBA7F7.title: "Applied Mekanistics: Chemical Cells"
	quest.1296763B70EBA7F7.quest_desc: [
		"&bApplied Mekanistics&r lets AE2 store &eMekanism gases and chemicals&r"
		"(hydrogen, oxygen, acids, slurries) in &eChemical Storage Cells&r."
		""
		"Hook your ore line's tanks to the network and pull exactly what each machine needs."
	]
	quest.573B94C480D57557.title: "Wireless Terminal"
	quest.573B94C480D57557.quest_desc: [
		"Mid-game wireless: a &eWireless Access Point&r on your network lets a"
		"&eWireless Terminal&r reach it from nearby. It runs on stored power, so charge it"
		"in a Charger."
		""
		"Range is limited; &eWireless Boosters&r in the access point stretch it."
		"It's part of Strata's wireless tier that opens after the Nether."
	]
	quest.561058F56B975552.title: "256k Cells"
	quest.561058F56B975552.quest_desc: [
		"The biggest standard cell. Strata places the top cells after the"
		"&cNetherite Monstrosity&r: boss drops will be part of the recipe."
	]
	quest.0F7CF4639F4C3D2F.title: "Quantum Network Bridge"
	quest.0F7CF4639F4C3D2F.quest_desc: [
		"The &5Quantum Network Bridge&r links two ME networks anywhere, &eeven in other"
		"dimensions&r. It's Strata's only cross-dimension wireless, so it's late."
		""
		"Build a ring of 8 &eQuantum Rings&r around a &eQuantum Link Chamber&r at each end."
		"&eEntangled Singularities&r (made in pairs, in an explosion) go in the chambers."
		"Both ends must stay loaded. Gated behind the &cEnder Guardian&r."
	]
	quest.6C43ED6F42727AF3.title: "Where next?"
	quest.6C43ED6F42727AF3.quest_desc: [
		"&bMekanism&r: feed your ore line straight from the network."
		"&bLogistics & Wireless&r: Integrated Dynamics can read your storage and react to it."
		"&bResource Farming&r: Mystical Agriculture crops are great for autocrafting."
	]
	chapter.32F4545024F13413.title: "Applied Energistics 2"
	chapter.32F4545024F13413.chapter_subtitle: ["Digital storage, autocrafting and quantum links"]
	quest.4859D51F0A452686.title: "More Ways to Build"
	quest.4859D51F0A452686.quest_desc: [
		"Four smaller tech mods, each with its own style. Pick the ones that sound fun:"
		""
		"&bIndustrial Foregoing&r: farms and factories that run by themselves."
		"&bPneumaticCraft&r: machines that run on &ecompressed air&r, plus drones."
		"&bPowah&r: simple, strong generators and power storage."
		"&bExtreme Reactors&r: build your own reactor, any size you like."
	]
	quest.2D4EB2A2A0CB1EBC.title: "IF: Tapping Trees"
	quest.2D4EB2A2A0CB1EBC.quest_desc: [
		"Industrial Foregoing starts with &elatex&r. Place a &eFluid Extractor&r facing a log"
		"and power it: it slowly drains latex out of the tree."
		""
		"It's the first step to rubber and plastic."
	]
	quest.4B66DD75E3CB6232.title: "IF: Plastic"
	quest.4B66DD75E3CB6232.quest_desc: [
		"The &eLatex Processing Unit&r turns latex and water into &eDry Rubber&r."
		"Smelt dry rubber into &ePlastic&r."
		""
		"Plastic goes into every IF machine frame."
	]
	quest.150DEB0F49A498BB.title: "IF: Machine Frames"
	quest.150DEB0F49A498BB.quest_desc: [
		"IF machines are built on &eMachine Frames&r: Pity, Simple, Advanced and Supreme."
		"The Pity frame is crafted; the better ones are made in the &eDissolution Chamber&r"
		"with latex or other fluids."
		""
		"The frame tier decides which machines you can build."
	]
	quest.2B12C5E916A19A92.title: "IF: Automatic Farms"
	quest.2B12C5E916A19A92.quest_desc: [
		"The &ePlant Sower&r plants seeds in an area, and the &ePlant Gatherer&r harvests it."
		"Add a &ePlant Fertilizer&r and you have a farm that never needs you."
		""
		"IF also has animal ranchers, mob crushers and more. Have a look with &eU&r on a frame."
	]
	quest.7721B3A24D1F50FE.title: "IF: Laser Drill"
	quest.7721B3A24D1F50FE.quest_desc: [
		"The &eOre Laser Base&r pulls ores out of thin air. Surround it with &eLaser Drills&r"
		"feeding it power."
		""
		"Coloured &elenses&r bias it toward certain ores. Expensive, but a source of ore"
		"that never runs out."
	]
	quest.61F7F192FB1105E5.title: "PNC: Compressed Iron"
	quest.61F7F192FB1105E5.quest_desc: [
		"PneumaticCraft starts with a bang. Drop iron ingots on the ground and blow them up"
		"with TNT (or a creeper): some of them become &eCompressed Iron&r."
		""
		"Some iron gets lost, so throw in a stack. Later the Pressure Chamber does this"
		"without losses."
	]
	quest.16A0FD663EEEC2E9.title: "PNC: Air Compressor"
	quest.16A0FD663EEEC2E9.quest_desc: [
		"The &eAir Compressor&r burns fuel to pump out &ecompressed air&r."
		"&ePressure Tubes&r carry air to your machines."
		""
		"&cWatch the pressure!&r Every machine and tube has a limit. Go over it and it"
		"explodes. Check with a &ePressure Gauge&r or the &eManometer&r."
	]
	quest.5F9CEBF3637E4FDE.title: "PNC: Pressure Chamber"
	quest.5F9CEBF3637E4FDE.quest_desc: [
		"The &ePressure Chamber&r is a hollow box (3x3x3 or bigger) of walls and glass with a"
		"valve to let air in. Items put in through an &einterface&r get squeezed into new things:"
		"compressed iron without losses, circuit boards, even coal into diamonds."
		""
		"Bigger chambers and higher pressure unlock more recipes."
	]
	quest.6F1756770A23E259.title: "PNC: Drones"
	quest.6F1756770A23E259.quest_desc: [
		"&eDrones&r are little flying robots you program yourself with puzzle pieces in the"
		"&eProgrammer&r: dig an area, move items, harvest crops, fight mobs."
		""
		"They run on compressed air, so give them a &eCharging Station&r to come home to."
	]
	quest.0C9856156803AEB2.title: "PNC: Pneumatic Armour"
	quest.0C9856156803AEB2.quest_desc: [
		"&ePneumatic Armour&r runs on compressed air. Fill it in a &eCharging Station&r."
		""
		"Upgrades add all sorts of tricks: the helmet can scan for ores and mobs, the"
		"boots can stop fall damage. Each trick uses air."
	]
	quest.40257CDE027C2C16.title: "PNC: Jet Boots"
	quest.40257CDE027C2C16.quest_desc: [
		"Put &eJet Boots Upgrades&r in your Pneumatic Boots and you can fly."
		""
		"&6The cost:&r jet boots burn through &ecompressed air&r fast. When the boots run dry,"
		"you fall. Higher tiers fly faster. Plan long trips around a Charging Station."
	]
	quest.7F014A4F3BAD29CB.title: "Powah: Energizing Orb"
	quest.7F014A4F3BAD29CB.quest_desc: [
		"&bPowah&r is all about the &eEnergizing Orb&r. Place &eEnergizing Rods&r around it,"
		"feed them power, and drop items into the orb: it charges them into new materials."
		""
		"Iron + gold makes &eEnergized Steel&r. Blaze rods, diamonds and emeralds become"
		"crystals for higher tiers. The &eManual&r (Powah's book) explains everything."
	]
	quest.525F5042AC78C691.title: "Powah: Generators"
	quest.525F5042AC78C691.quest_desc: [
		"&eFurnators&r burn fuel, &eMagmators&r burn lava, &eThermo Generators&r use heat"
		"under them, and &eSolar Panels&r use the sun."
		""
		"&eEnergy Cells&r store the power. Everything comes in tiers: Starter, Basic,"
		"Hardened, Blazing, Niotic, Spirited and Nitro."
	]
	task.38F10BD01D507382.title: "36 Reactor blocks"
	quest.0C280A2767BBC7E2.title: "Powah: Reactor"
	quest.0C280A2767BBC7E2.quest_desc: [
		"The Powah &eReactor&r is a multiblock that burns &eUraninite&r (from Powah's own ore)"
		"for lots of power. Add coolant and a carbon source to make it run better."
		""
		"Place 36 reactor blocks of the same tier together and it builds itself."
	]
	quest.61071B8B2734F992.title: "ER: Yellorium"
	quest.61071B8B2734F992.quest_desc: [
		"&bExtreme Reactors&r burns &eYellorium&r. Its bright yellow ore hides deep"
		"underground. Smelt it into ingots."
	]
	quest.1B063B47D5C66FD9.title: "ER: Your First Reactor"
	quest.1B063B47D5C66FD9.quest_desc: [
		"An Extreme Reactor is a box of &eReactor Casing&r (glass is fine on the sides) with a"
		"&eController&r, a &ePower Tap&r and an &eAccess Port&r on the outside."
		""
		"Inside: columns of &eFuel Rods&r, each topped with a &eControl Rod&r. Fill the gaps"
		"with water or other moderators. Any size you like, bigger is more efficient."
	]
	quest.047A01F3C7E54912.title: "ER: Turbines"
	quest.047A01F3C7E54912.quest_desc: [
		"For more power, build a &eReinforced&r reactor that makes &esteam&r (it needs fluid"
		"ports and water) and pipe it into a &eTurbine&r: a rotor of shafts and blades inside"
		"a housing."
		""
		"A good turbine setup makes far more power from the same fuel."
	]
	quest.4526E1FDE9A28E0B.title: "Where next?"
	quest.4526E1FDE9A28E0B.quest_desc: [
		"&bMekanism&r and &bOritech&r: more machines, more processing."
		"&bImmersive Engineering&r: wire all these generators into one grid."
		"&bLogistics & Wireless&r: move things between them automatically."
	]
	chapter.2839C967066C8419.title: "More Machines"
	chapter.2839C967066C8419.chapter_subtitle: [
		"Industrial Foregoing, PneumaticCraft, Powah and Extreme Reactors"
	]
	quest.3EF08C213EF1C9E0.title: "Moving Things Around"
	quest.3EF08C213EF1C9E0.quest_desc: [
		"Once you have a few machines, you'll want them to talk to each other."
		""
		"&bIntegrated Dynamics&r: read anything (a chest, a tank, the time of day) and make"
		"your base react to it."
		"&bLaserIO&r: move items, fluids and power between nearby blocks with lasers."
		"&bMore Red&r: compact redstone logic gates and wires."
		"&bFlux Networks&r: wireless power, &cafter the Nether&r."
	]
	quest.01ADE2B171793530.title: "ID: Menril"
	quest.01ADE2B171793530.quest_desc: [
		"Integrated Dynamics runs on &eMenril&r, from pale blue Menril trees."
		"Squeeze Menril logs in a &eSqueezer&r for resin, then dry the resin in a"
		"&eDrying Basin&r to get &eCrystallized Menril&r."
		""
		"The book &eOn the Dynamics of Integration&r explains the whole mod."
	]
	quest.3BB43D04EF28DFA6.title: "ID: Logic Cables"
	quest.3BB43D04EF28DFA6.quest_desc: [
		"&eLogic Cables&r join everything into one network. Information travels on"
		"&eVariable Cards&r: little cards that hold a value, like \"how many iron ingots"
		"are in this chest\"."
	]
	quest.164B19786A33DCAB.title: "ID: Readers and Displays"
	quest.164B19786A33DCAB.quest_desc: [
		"Put an &eInventory Reader&r on a cable facing a chest, pick a value in its GUI and"
		"write it to a variable card. Put the card in a &eDisplay Panel&r and it shows"
		"the number live."
		""
		"There are readers for blocks, fluids, energy, entities, redstone and more."
	]
	quest.448C1D42120AE793.title: "ID: Logic Programmer"
	quest.448C1D42120AE793.quest_desc: [
		"The &eLogic Programmer&r combines values with operators:"
		"\"if iron is under 64, then turn on the redstone signal\"."
		""
		"Feed the result into a &eRedstone Writer&r to switch machines on and off by"
		"themselves."
	]
	quest.0C86CD74B7A92F14.title: "ID: Make It Happen"
	quest.0C86CD74B7A92F14.quest_desc: [
		"Writers turn logic into action. A &eRedstone Writer&r gives off a signal based on"
		"a variable, so your smelter only runs when coal is in stock, or a lamp lights up"
		"when the reactor gets hot."
		""
		"Small logic, big results."
	]
	quest.4F37D2898DB35D15.title: "LaserIO: Laser Nodes"
	quest.4F37D2898DB35D15.quest_desc: [
		"A &eLaser Node&r sits next to your machines and chests. Link two nodes with the"
		"&eLaser Wrench&r and a laser beam connects them."
		""
		"Links have a &emaximum range&r, so nodes are for moving things around a base,"
		"not across the map."
	]
	quest.1366D8A70214C630.title: "LaserIO: Cards"
	quest.1366D8A70214C630.quest_desc: [
		"&eCards&r go into a node's sides and say what to do: an &eItem Card&r set to"
		"&eExtract&r on one node and &eInsert&r on another moves items between them."
		""
		"There are cards for fluids, energy, Mekanism chemicals and redstone too."
		"Add &efilters&r to choose what goes where."
	]
	quest.15FC560B70EAA117.title: "LaserIO: Filters and Speed"
	quest.15FC560B70EAA117.quest_desc: [
		"A &eBasic Filter&r on a card picks which items move. Tag, mod and count filters"
		"do clever sorting."
		""
		"&eCard Overclockers&r make a card move more at once. Great for ore lines."
	]
	quest.620AD7E0D2315D88.title: "More Red: Red Alloy"
	quest.620AD7E0D2315D88.quest_desc: [
		"&bMore Red&r adds thin &eRed Alloy Wire&r that you can stick on walls and ceilings,"
		"plus logic gates that fit in one block."
		""
		"Red alloy is a metal ingot plus redstone (press &eR&r to see it)."
	]
	quest.5E46AFCB32A972D1.title: "More Red: Logic Gates"
	quest.5E46AFCB32A972D1.quest_desc: [
		"The &eSoldering Table&r makes logic gates: AND, OR, NOT, XOR, latches, pulse gates"
		"and more. Each gate is one small plate, so tricky redstone fits in tight spaces."
		""
		"&eBundled cables&r carry 16 colour signals in one line."
	]
	quest.2208B866CA7D5293.title: "Flux Dust"
	quest.2208B866CA7D5293.quest_desc: [
		"&bFlux Networks&r sends power without wires. It's part of Strata's wireless tier"
		"that opens &eafter the Nether&r."
		""
		"&eFlux Dust&r is made in the world by crushing redstone between &ebedrock&r and"
		"&eobsidian&r. Press &eR&r on Flux Dust to see the setup."
	]
	quest.55EF191CC41C41EB.title: "A Flux Network"
	quest.55EF191CC41C41EB.quest_desc: [
		"&eFlux Plug&r: put it next to a generator; it pulls power into the network."
		"&eFlux Point&r: put it next to a machine; it hands power out."
		"&eFlux Storage&r: a battery for the network."
		""
		"Open any of them to create a network and pick it on every device."
		"Set a password if you don't want others plugging in."
	]
	quest.7D3AC4FA07AB5420.title: "Where next?"
	quest.7D3AC4FA07AB5420.quest_desc: [
		"&bApplied Energistics 2&r: a full digital storage network."
		"&bImmersive Engineering&r: real power lines for long distances."
		"&bMekanism&r: ore lines that LaserIO can feed."
	]
	chapter.6E2C61BED7B0237E.title: "Logistics & Wireless"
	chapter.6E2C61BED7B0237E.chapter_subtitle: [
		"Logic networks, laser item transport and (later) wireless power"
	]
	quest.4F944E25AC804CF8.title: "What is Oritech?"
	quest.4F944E25AC804CF8.quest_desc: [
		"&bOritech&r is a modern tech mod with good-looking, animated machines."
		"Each machine can be boosted with &eaddons&r (speed, efficiency, yield...) that you"
		"place right next to it."
		""
		"It goes from simple pulverizers all the way to nuclear power, particle accelerators"
		"and cybernetic &eaugments&r for yourself."
	]
	quest.5710FA9E9786267C.title: "Nickel and Dime"
	quest.5710FA9E9786267C.quest_desc: [
		"Oritech's own metals are &eNickel&r and &ePlatinum&r. Nickel ore is the common one;"
		"smelt the raw ore into ingots."
	]
	quest.6DA01AE8EAF32CEF.title: "Power Up!"
	quest.6DA01AE8EAF32CEF.quest_desc: [
		"The &eBasic Generator&r burns fuel like coal for power."
		"Later you'll get steam engines, bio, lava and fuel generators, and a reactor."
		""
		"Oritech machines use normal FE, so any power source in the pack works."
	]
	quest.4C0D5D3E6AD5DF36.title: "Pipes"
	quest.4C0D5D3E6AD5DF36.quest_desc: [
		"&eEnergy&r, &eFluid&r and &eItem Pipes&r connect your machines. The &ePipe Wrench&r"
		"changes which sides connect."
		""
		"Framed pipes hide inside walls for a tidy base."
	]
	quest.630B1D39D839186C.title: "Crushing It"
	quest.630B1D39D839186C.quest_desc: [
		"The &ePulverizer&r turns ore into dust (more ingots per ore) and the"
		"&ePowered Furnace&r smelts it quickly."
		""
		"Small dusts get combined into full ones by themselves."
	]
	quest.1CD962677669B77C.title: "Machine Addons"
	quest.1CD962677669B77C.quest_desc: [
		"&eAddons&r sit next to a machine and change how it works: &eSpeed&r, &eEfficiency&r,"
		"&eYield&r, &eCapacitor&r and more. Each machine has a limited number of addon slots."
		""
		"Better &eMachine Cores&r let you connect more addon extenders."
	]
	quest.7E2F1301E6595942.title: "Melt Down"
	quest.7E2F1301E6595942.quest_desc: [
		"The &eFoundry&r melts metals together into alloys like &eSteel&r, &eElectrum&r and"
		"&eAdamant&r."
		""
		"Bigger Oritech machines are multiblocks: press &eR&r on one to see what it needs."
	]
	quest.26C48E0A787EFBF9.title: "Assembly Line"
	quest.26C48E0A787EFBF9.quest_desc: [
		"The &eAssembler&r builds Oritech's fancier parts: motors, processing units,"
		"batteries and plating. Most of the mid-game goes through it."
	]
	quest.688AA5A95243C6C1.title: "Spin Doctor"
	quest.688AA5A95243C6C1.quest_desc: [
		"The &eCentrifuge&r separates fluids and materials. It makes &ePolymer Resin&r,"
		"which you smelt into &ePlastic Sheets&r for later parts."
	]
	quest.2663E7DF1013ED24.title: "Machine Frames and Lasers"
	quest.2663E7DF1013ED24.quest_desc: [
		"Some machines move on a &eMachine Frame&r: a rectangle of frame blocks on the ground."
		"A Block Destroyer, Placer or Fertilizer head runs along it like a gantry."
		""
		"The &eEnderic Laser&r mines blocks from a distance and is how you collect"
		"&eFluxite&r from amethyst."
	]
	quest.3D754C790E570892.title: "Hand Drill and Chainsaw"
	quest.3D754C790E570892.quest_desc: [
		"The &eHand Drill&r and &eChainsaw&r are powered tools: fast, but they need"
		"charging. An &eEquipment Charger&r keeps them topped up."
	]
	quest.46F703212425A6B1.title: "Glittering Prizes"
	quest.46F703212425A6B1.quest_desc: [
		"Deep underground there are &eResource Nodes&r: ore spots that never run out."
		"Build a &eBedrock Extractor&r on one and it mines ore forever, as long as it has"
		"power."
	]
	quest.7CF0EA6387A0C28E.title: "Cybernetics!"
	quest.7CF0EA6387A0C28E.quest_desc: [
		"&eAugments&r upgrade &eyou&r: research them at a &eCybernetic Research Station&r and"
		"install them at the &eCybernetic Augmentation Center&r. Think extra health, speed"
		"or night vision."
	]
	quest.3935137E275A59B3.title: "Exosuit"
	quest.3935137E275A59B3.quest_desc: [
		"The &eExo&r armour runs on power. The helmet gives night vision, the leggings speed,"
		"the boots stop fall damage, and the chestplate charges your other powered items."
		""
		"Keep it charged at an Equipment Charger."
	]
	quest.1A017D53BD3830B5.title: "Exo Jetpack"
	quest.1A017D53BD3830B5.quest_desc: [
		"The &eExo Jetpack&r lets you fly, but it isn't free: it needs &eelectricity&r or"
		"&eTurbofuel&r (faster on turbofuel). When it's empty, you're walking."
		""
		"The Boosted Elytra versions work the same way."
	]
	quest.6B9F103C58B9251A.title: "Nuclear Power"
	quest.6B9F103C58B9251A.quest_desc: [
		"Oritech's &eNuclear Reactor&r is a multiblock of rods, heat pipes, vents and"
		"absorbers. It makes huge amounts of power, and a lot of heat."
		""
		"&cKeep it cool&r, or the light show will be bigger than you wanted."
	]
	quest.6F72CA80F2CE50C5.title: "Atomic Smith"
	quest.6F72CA80F2CE50C5.quest_desc: [
		"The &eAtomic Forge&r makes Oritech's best materials, such as &eDuratium&r and"
		"&ePrometheum&r. It needs a big burst of power for every recipe."
	]
	quest.2AB80584A691D3FB.title: "Where next?"
	quest.2AB80584A691D3FB.quest_desc: [
		"&bMekanism&r: a different take on ore processing and power."
		"&bImmersive Engineering&r: wire your generators into a long-distance grid."
		"&bEndgame&r: Draconic Evolution needs everything you can generate."
	]
	chapter.45ADC3D897E2E7E3.title: "Oritech"
	chapter.45ADC3D897E2E7E3.chapter_subtitle: ["Sleek machines, addons, augments and atomic forging"]
	quest.4DB5350C58D5512E.title: "What is Resource Farming?"
	quest.4DB5350C58D5512E.quest_desc: [
		"Mining gets old. These mods let you &egrow&r your resources instead:"
		""
		"&bMystical Agriculture&r: crops that drop essence for iron, diamonds and more."
		"&bProductive Bees&r: bees whose combs spin into metals and gems."
		"&bMob Grinding Utils&r: efficient mob farms that also collect the XP."
	]
	quest.62F7DC6DBA1B090B.title: "MA: Inferium"
	quest.62F7DC6DBA1B090B.quest_desc: [
		"Mine &eInferium Ore&r underground for &eInferium Essence&r, the base of everything in"
		"Mystical Agriculture. You'll also find &eProsperity Ore&r, which drops"
		"&eProsperity Shards&r."
	]
	quest.1637E861181EA5E1.title: "MA: Inferium Seeds"
	quest.1637E861181EA5E1.quest_desc: [
		"Surround a wheat seed with 8 Inferium Essence to get &eInferium Seeds&r."
		"Plant them on farmland: they grow more essence."
		""
		"&eInferium Farmland&r (farmland + essence) makes the crops drop a bit more."
	]
	quest.0D07C193B80EDCE7.title: "MA: Essence Tiers"
	quest.0D07C193B80EDCE7.quest_desc: [
		"Essence comes in five tiers: &aInferium&r, &ePrudentium&r, &6Tertium&r, &bImperium&r and"
		"&5Supremium&r. Four of one tier around an &eInfusion Crystal&r makes one of the next."
		""
		"Better resources need higher-tier essence for their seeds."
	]
	quest.6847F3E373DFFA42.title: "MA: Infusion Altar"
	quest.6847F3E373DFFA42.quest_desc: [
		"Resource seeds are made on the &eInfusion Altar&r with 8 &ePedestals&r around it."
		"Put the seed base on the altar, the ingredients on the pedestals and right-click"
		"the altar with a &eWand&r."
		""
		"&eProsperity Seed Base&r (prosperity shards around a wheat seed) starts most seeds."
	]
	quest.01870895CCD09874.title: "MA: Iron Seeds"
	quest.01870895CCD09874.quest_desc: [
		"Your first real resource crop! Iron Seeds grow &eIron Essence&r; 8 essence in a"
		"ring in the crafting grid makes 6 iron ingots."
		""
		"Press &eU&r on any essence to see what it crafts into."
	]
	quest.6785805FDA38C237.title: "MA: Growing Faster"
	quest.6785805FDA38C237.quest_desc: [
		"&eGrowth Accelerators&r placed under your farmland speed up the crops above."
		"Stack several in a column for more effect. The &eHarvester&r machine picks"
		"everything for you."
	]
	quest.29690D3BE737295F.title: "MA: Diamond Seeds"
	quest.29690D3BE737295F.quest_desc: [
		"Diamonds that grow on plants. Diamond seeds need high-tier essence, so build up"
		"your essence farms first."
	]
	quest.04441EA7C5EB2978.title: "MA: Awakened Supremium"
	quest.04441EA7C5EB2978.quest_desc: [
		"The very top of Mystical Agriculture. The &eAwakening Altar&r (with its pedestals and"
		"elemental essences) turns a block of Supremium into &5Awakened Supremium&r, for the"
		"best tools, armour and growth accelerators."
	]
	quest.2C26DD6E3676839A.title: "PB: Catching Bees"
	quest.2C26DD6E3676839A.quest_desc: [
		"&bProductive Bees&r has dozens of bee types. Catch any bee by right-clicking it with"
		"a &eBee Cage&r. Bees live in nests all over the world: in trees, sand, stone,"
		"the Nether and the End."
	]
	quest.251BF0C877926B65.title: "PB: Advanced Beehive"
	quest.251BF0C877926B65.quest_desc: [
		"An &eAdvanced Beehive&r houses your bees and collects their combs in its inventory."
		"Put filled bee cages in it to move bees in, and empty cages to take them out."
		""
		"Bees need flowers nearby (or their own favourite blocks) to work."
	]
	quest.5B0DB106B92215A8.title: "PB: Centrifuge"
	quest.5B0DB106B92215A8.quest_desc: [
		"Combs aren't useful on their own. Spin them in a &eCentrifuge&r for wax, honey and"
		"whatever the bee makes: iron, gold, redstone, even diamonds."
		""
		"The &ePowered Centrifuge&r runs faster on power."
	]
	quest.608D740CB18BA30D.title: "PB: Resource Bees"
	quest.608D740CB18BA30D.quest_desc: [
		"&eResource bees&r make combs of metals and gems. Get them by finding the right nest,"
		"by &ebreeding&r two bees (Breeding Chamber, or with flowers in the world), or by"
		"feeding a bee certain items to change its type."
		""
		"Press &eR&r on a bee's spawn egg or comb in EMI to see how to get it."
	]
	quest.51803B2EB08CD223.title: "PB: Breeding"
	quest.51803B2EB08CD223.quest_desc: [
		"The &eBreeding Chamber&r breeds two caged bees into a new type automatically."
		"&eHoney Treats&r are used for bee breeding and genetics."
	]
	quest.6081CAC0241B2CD0.title: "MGU: Moving Mobs"
	quest.6081CAC0241B2CD0.quest_desc: [
		"&bMob Grinding Utils&r gives you parts for mob farms."
		"The &eMob Fan&r blows mobs along. &eIron Spikes&r hurt mobs standing on them."
		""
		"Pair it with a dark room or a spawner to farm drops."
	]
	quest.6FA03CF7F0446E1C.title: "MGU: Mob Masher"
	quest.6FA03CF7F0446E1C.quest_desc: [
		"The &eMob Masher&r kills mobs that get pushed into it. Upgrades add Looting, Sharpness"
		"and more."
		""
		"The &eAbsorption Hopper&r picks up the drops &eand the XP&r in an area, and stores"
		"the XP as a fluid."
	]
	quest.766605FC756B23E4.title: "MGU: Bottled XP"
	quest.766605FC756B23E4.quest_desc: [
		"Store liquid XP in a &eSingularity Tank&r. The &eXP Solidifier&r turns it into"
		"&eXP Jelly Babies&r you can eat later, which is handy for waystone trips and enchanting."
	]
	quest.16897A6F53D9DF85.title: "Where next?"
	quest.16897A6F53D9DF85.quest_desc: [
		"&bApplied Energistics 2&r: autocraft essence into ingots."
		"&bMekanism&r: process extra ores you grew."
		"&bEndgame&r: Extended Crafting eats lots of resources."
	]
	chapter.26C5BB00014B7AC7.title: "Resource Farming"
	chapter.26C5BB00014B7AC7.chapter_subtitle: ["Grow your ores, keep bees that make metal, and farm mobs"]
	quest.41AC80BC0555D444.title: "The Long Road"
	quest.41AC80BC0555D444.quest_desc: [
		"This chapter is the far horizon. Nobody finishes it in a week, and that's the point."
		""
		"&bDraconic Evolution&r: draconium, fusion crafting, a giant energy core and the"
		"strongest gear in the pack."
		"&bExtended Crafting&r: bigger and bigger crafting tables for huge recipes."
		""
		"The top tiers need the &5Ender Dragon&r and &cCataclysm&r bosses beaten first."
	]
	quest.2DED5A01D6C48666.title: "Draconium"
	quest.2DED5A01D6C48666.quest_desc: [
		"&eDraconium Ore&r is rare and deep. It shows up in the Overworld, the Nether and"
		"the End (the End has the most). Smelt the dust or ore into ingots."
		""
		"The &eInformation Tablet&r is Draconic Evolution's guide."
	]
	quest.1CA8DF428A6A1ED4.title: "Draconium Core"
	quest.1CA8DF428A6A1ED4.quest_desc: [
		"The &eDraconium Core&r (draconium, gold and a diamond) is the basic building block"
		"of almost every Draconic machine. Make a handful."
	]
	quest.1AFDA78996313961.title: "DE Generator"
	quest.1AFDA78996313961.quest_desc: [
		"Draconic machines are hungry. The &eGenerator&r burns fuel for power, but you'll"
		"want a real power plant (Mekanism, Oritech, Extreme Reactors) behind this chapter."
	]
	quest.0C5E4775DCA4F0BE.title: "Fusion Crafting"
	quest.0C5E4775DCA4F0BE.quest_desc: [
		"&eFusion Crafting&r: a &eFusion Crafting Core&r in the middle with &eInjectors&r"
		"facing it. Put the main item in the core and the ingredients in the injectors,"
		"give the injectors power, and watch it fuse."
		""
		"Better injectors (Wyvern, Draconic, Chaotic) unlock bigger recipes."
	]
	quest.18EF5E748083E553.title: "Wyvern Core"
	quest.18EF5E748083E553.quest_desc: [
		"The first big upgrade: a &eWyvern Core&r needs Draconium Cores and a"
		"&eNether Star&r, so you'll be fighting the Wither for this one."
	]
	quest.0CBC3F37C280DE14.title: "Energy Core"
	quest.0CBC3F37C280DE14.quest_desc: [
		"The &eEnergy Core&r is a giant power bank built in tiers. It needs &eStabilizers&r"
		"around it and &ePylons&r to move energy in and out, plus a shell of blocks"
		"(Redstone, then Draconium) that grows with each tier."
		""
		"Fill it with your whole power plant's output."
	]
	quest.260A6675A47ACC19.title: "Wyvern Gear"
	quest.260A6675A47ACC19.quest_desc: [
		"&eWyvern&r tools and armour run on power and take &emodules&r you slot in:"
		"more energy, speed, area mining, shields and more."
		""
		"Every module needs power, so charge your gear often."
	]
	quest.76AEAB4FF06FF427.title: "Awakened Draconium"
	quest.76AEAB4FF06FF427.quest_desc: [
		"Killing the &5Ender Dragon&r drops a &eDragon Heart&r. Fuse it with Draconium blocks"
		"and cores to get &eAwakened Draconium&r."
		""
		"It's the key to the Draconic tier."
	]
	quest.21C5EF06F98348C1.title: "Draconic Core"
	quest.21C5EF06F98348C1.quest_desc: [
		"Wyvern Cores, Awakened Draconium and a Nether Star fused into a &eDraconic Core&r."
		"The heart of the Draconic tier."
	]
	quest.0BDC25351418F2EA.title: "Draconic Armour"
	quest.0BDC25351418F2EA.quest_desc: [
		"The &5Draconic&r chestpiece: huge shields, netherite inside, room for lots of modules."
		"In Strata it comes after beating &cIgnis&r too."
		""
		"&6Flight:&r its flight module runs on the armour's &epower&r. It's an endgame"
		"reward, and you'll need a big energy core to keep it charged."
	]
	quest.0CE2E6EAFA115589.title: "Chaos Shards"
	quest.0CE2E6EAFA115589.quest_desc: [
		"Far out in the End are &eChaos Islands&r, guarded by the &cChaos Guardian&r, a dragon"
		"far tougher than the first. Its shards are needed for the Chaotic tier and the"
		"Draconic Reactor."
		""
		"Bring your best gear and friends."
	]
	quest.18E59E2F9C3CF400.title: "Draconic Reactor"
	quest.18E59E2F9C3CF400.quest_desc: [
		"The &eDraconic Reactor&r makes more power than anything else in the pack, and it"
		"can go very, very wrong. Build it far from home, with stabilizers, injectors and a"
		"lot of care."
	]
	quest.0BEEC92DBC89412B.title: "EC: Black Iron"
	quest.0BEEC92DBC89412B.quest_desc: [
		"&bExtended Crafting&r is built on &eBlack Iron&r: an iron ingot and black dye."
		"You'll also need &eBlack Iron Slates&r for every table."
	]
	quest.6915099B8F05EF62.title: "EC: Basic Table"
	quest.6915099B8F05EF62.quest_desc: [
		"The &eBasic Crafting Table&r only has a 3x3 grid, but you need it to make the"
		"bigger ones. Each table tier needs its own &ecatalyst&r and &ecomponents&r."
	]
	quest.497714199B5F3EFF.title: "EC: Advanced Table"
	quest.497714199B5F3EFF.quest_desc: [
		"&eAdvanced Crafting Table&r: a &e5x5&r grid. Big recipes start here."
	]
	quest.097A57A5132643E6.title: "EC: Elite Table"
	quest.097A57A5132643E6.quest_desc: [
		"&eElite Crafting Table&r: a &e7x7&r grid. &eCrystaltine&r ingots (with a Nether Star)"
		"are made here."
	]
	quest.44AD720CFAD1DBA1.title: "EC: Crystaltine"
	quest.44AD720CFAD1DBA1.quest_desc: [
		"&eCrystaltine&r is diamonds, lapis, gold, iron and a Nether Star crafted on the"
		"Elite table. You'll need it for the Ultimate tier."
	]
	quest.36B48031921B7D11.title: "EC: Combination Crafting"
	quest.36B48031921B7D11.quest_desc: [
		"The &eCrafting Core&r with &ePedestals&r around it combines items using power."
		"The &eQuantum Compressor&r squeezes huge piles of one item into a &eSingularity&r."
	]
	quest.3F56F59DC83E9493.title: "EC: Ultimate Table"
	quest.3F56F59DC83E9493.quest_desc: [
		"The &5Ultimate Crafting Table&r: a &e9x9&r grid for Strata's biggest recipes."
		"It comes after the &5Ender Dragon&r and the &cNetherite Monstrosity&r."
		""
		"If you got here, you've seen most of what Strata has. Well done!"
	]
	quest.4074520BE0443187.title: "Where next?"
	quest.4074520BE0443187.quest_desc: [
		"&cBosses & Combat&r: the Cataclysm bosses guard what this chapter needs."
		"&5The End&r: the Dragon, and the Chaos Islands beyond."
		"&bMekanism&r and &bOritech&r: the power you'll need."
	]
	chapter.207C97AAA9F54EB7.title: "Endgame"
	chapter.207C97AAA9F54EB7.chapter_subtitle: [
		"Draconic Evolution and Extended Crafting: the biggest projects in Strata"
	]
	quest.544A2059F4271A24.title: "What is Ars Nouveau?"
	quest.544A2059F4271A24.quest_desc: [
		"&dArs Nouveau&r is the heart of magic in Strata. Instead of finding fixed spells,"
		"you &ebuild your own&r from little pieces called &eglyphs&r: \"shoot a bolt that breaks blocks\","
		"\"heal me and make me jump higher\", and so on."
		""
		"Your power is &bSource&r, a magic liquid you collect in jars and spend in machines,"
		"and &bmana&r, the blue bar you spend on spells."
		""
		"The other magic mods (Iron's Spells, Occultism) plug into Ars, so this is a great place to start."
	]
	quest.7D759B61A5A29A19.title: "The Tattered Tome"
	quest.7D759B61A5A29A19.quest_desc: [
		"Craft the &eTattered Tome&r (a book and a lapis). It's Ars Nouveau's own guide:"
		"every block, glyph, ritual and creature has a page with recipes."
		""
		"It also has a key of its own (\"Open Documentation\", in Options > Controls)."
	]
	quest.0DE269238D11ED6E.title: "Your First Spell Book"
	quest.0DE269238D11ED6E.quest_desc: [
		"The &eNovice Spell Book&r is a book plus an iron pickaxe, axe, shovel and sword."
		""
		"Open it (its key is in Options > Controls) to see the spell crafting screen."
		"Each spell slot holds one spell; switch slots with the book's next/previous keys"
		"and cast with right-click."
	]
	quest.368CE85A6523BB3C.title: "Forms, Effects and Augments"
	quest.368CE85A6523BB3C.quest_desc: [
		"Every spell is a list of glyphs:"
		""
		"&eForm&r (always first, only one): how the spell travels. &aProjectile&r flies, &aTouch&r"
		"hits what you click, &aSelf&r targets you."
		"&eEffects&r: what happens. &aBreak&r, &aHarm&r, &aHeal&r, &aLight&r..."
		"&eAugments&r: tweak the glyph before them. &aAmplify&r makes it stronger, &aAOE&r wider."
		""
		"Try &eTouch + Break&r for a magic pickaxe. Each glyph costs mana; the bottom-left bar shows yours."
	]
	quest.24A53A91ADE01339.title: "Archwood Trees"
	quest.24A53A91ADE01339.quest_desc: [
		"Ars Nouveau's magic trees come in four colors (blue, red, purple, green)."
		"A few grow almost anywhere, and whole &eArchwood Forests&r are full of them,"
		"along with glowing lights and magic creatures."
		""
		"You'll need lots of Archwood for the Ars machines. Keep a few &5Vexing (purple)&r logs:"
		"most ritual tablets use one."
	]
	quest.1449B295E944E2B0.title: "Sourceberries"
	quest.1449B295E944E2B0.quest_desc: [
		"Sourceberry bushes grow wild in the world. The berries are a snack, and planted bushes"
		"are worth planting: Starbuncles harvest them for you, and Sourceberry food makes lots of"
		"Source in a Mycelial Sourcelink."
	]
	quest.3C2BDFA526A1999D.title: "The Imbuement Chamber"
	quest.3C2BDFA526A1999D.quest_desc: [
		"The &eImbuement Chamber&r soaks items in Source to make new ones."
		"With no jars around it slowly gathers Source on its own, so it works from day one."
		""
		"Put an &eamethyst shard&r or &elapis&r inside and wait: out comes a &bSource Gem&r."
	]
	quest.2EE10AE6A4829B13.title: "Source Gems"
	quest.2EE10AE6A4829B13.quest_desc: [
		"Source Gems go into almost every Ars recipe. Keep a chamber running in your base."
		""
		"Later, Source Jars nearby (2 blocks away) make the chamber work much faster."
	]
	quest.5BCA022C86A2B829.title: "The Scribe's Table"
	quest.5BCA022C86A2B829.quest_desc: [
		"New glyphs are made at the &eScribe's Table&r. Use your spell book on it, pick a glyph,"
		"then throw the items it shows onto the table. It also costs some &aXP&r."
		""
		"The table can pull items from chests next to it."
	]
	task.26F88D425A035165.title: "Scribe the Light glyph"
	quest.1779A88707F2B491.title: "Learning Glyphs"
	quest.1779A88707F2B491.quest_desc: [
		"Scribe the &eLight&r glyph (a lantern and a torch) and use it to learn it."
		"Now any spell can place magic lights: &eProjectile + Light&r lights up a cave from afar."
		""
		"Every glyph you learn also raises your mana regeneration a little."
		"Share your glyphs with friends with an &eAnnotated Codex&r."
	]
	quest.02F88B00AF55AED2.title: "Source Jars"
	quest.02F88B00AF55AED2.quest_desc: [
		"&eSource Jars&r store Source. Machines like the Imbuement Chamber and the"
		"Enchanting Apparatus pull from jars near them, and rituals drink from them too."
		""
		"A comparator next to a jar shows how full it is."
	]
	quest.5B375A13116141AA.title: "Making Source"
	quest.5B375A13116141AA.quest_desc: [
		"&eSourcelinks&r turn things into Source and push it into jars within a few blocks:"
		""
		"&cVolcanic&r: burns fuel (Archwood logs give extra). It also heats stone into lava!"
		"&aAgronomic&r: crops and trees growing nearby (not bonemeal)."
		"&6Mycelial&r: eats food. &dVitalic&r: animals breeding and mobs dying nearby."
		"&bAlchemical&r: drinks potions."
		""
		"Start with the Volcanic one and a chest of logs."
	]
	quest.7D6E76F5AF4BA467.title: "The Enchanting Apparatus"
	quest.7D6E76F5AF4BA467.quest_desc: [
		"Ars's big crafting altar. Place the &eArcane Core&r, the &eEnchanting Apparatus&r on top,"
		"and &eArcane Pedestals&r within 3 blocks. Put the side items on the pedestals,"
		"then right-click the apparatus with the center item."
		""
		"All three need &eSourcestone&r (stone around a Source Gem). Some recipes also use Source"
		"from jars nearby."
	]
	quest.77C704675CBC2656.title: "Dominion Wand"
	quest.77C704675CBC2656.quest_desc: [
		"The &eDominion Wand&r links things together: Source Relays to jars, and Starbuncles"
		"to the chests they work with. Click the thing that gives, then the thing that receives."
		"Sneak-click a relay to clear its links."
	]
	quest.695B7A77492A5668.title: "Elemental Essences"
	quest.695B7A77492A5668.quest_desc: [
		"&eEssences&r are Source Gems imbued with extra items on pedestals next to the"
		"Imbuement Chamber. &cFire Essence&r: flint and steel, a torch and gunpowder."
		""
		"There are seven: Fire, Water, Earth, Air, Abjuration, Conjuration and Manipulation."
		"Many higher glyphs and items need them; look them up with &eR&r."
	]
	quest.54DCACE158691BB7.title: "Rituals"
	quest.54DCACE158691BB7.quest_desc: [
		"Rituals are big one-time (or long-running) effects. Place a &eRitual Brazier&r,"
		"use a &eritual tablet&r on it, toss in any extra items to augment it,"
		"then right-click it with an empty hand to start."
		""
		"Rituals that need Source pull it from jars within 6 blocks. A redstone signal stops a running ritual."
		"Tablets include growing crops, making it sunrise, digging, and calling a Wilden boss."
	]
	task.6D27F7DD1ABF201C.title: "Bind a Starbuncle familiar"
	quest.190A1B14B3AB00BE.title: "A Familiar Friend"
	quest.190A1B14B3AB00BE.quest_desc: [
		"Familiars are little companions that follow you and give bonuses."
		"Perform the &eRitual of Binding&r next to a Starbuncle to get its bound script, then use it."
		"Pick your familiar from the &eFamiliars&r tab of your spell book."
		""
		"A Starbuncle familiar gives you &aSpeed&r. Drygmys, Whirlisprigs, Wixies, Bookwyrms and more"
		"can become familiars too."
	]
	quest.6839C5B7C645A73B.title: "Ars Ocultas: Spirits in Jars"
	quest.6839C5B7C645A73B.quest_desc: [
		"A &eContainment Jar&r holds a mob (catch one with the &eRitual of Containment&r)."
		"Jarred animals keep working: chickens lay eggs, cows give milk."
		""
		"With &dArs Ocultas&r, &dOccultism&r spirits work inside jars too and &enever decay&r,"
		"which makes great automation. It also lets the Imbuement Chamber turn silver into gold and back."
		"See the Occultism chapter."
	]
	task.681890876EC48945.title: "Get a Starbuncle Token"
	quest.0C7DCC1C1EF97FCC.title: "Starbuncles!"
	quest.0C7DCC1C1EF97FCC.quest_desc: [
		"&dStarbuncles&r are tiny, very cute item movers. Wild ones live in the woods and love"
		"&6gold nuggets&r. Hold a nugget so it lets you come close, then drop it one: it grabs the"
		"nugget, vanishes and leaves a &eStarbuncle Token&r."
		"Turn the token into a charm in the Enchanting Apparatus with 4 gold ingots."
		""
		"Place the charm to summon your Starbuncle. With the Dominion Wand, click a chest then the"
		"Starbuncle (take from), or the Starbuncle then a chest (put into). It carries items between them,"
		"picks up drops and harvests Sourceberries. You can dye them!"
	]
	quest.119ACBC767AE85F8.title: "StarbuncleMania"
	quest.119ACBC767AE85F8.quest_desc: [
		"&dStarbuncleMania&r gives Starbuncles accessories and new jobs:"
		""
		"&eStarbucket&r: carries fluids between tanks. &eStarbAttery&r: carries power (FE)."
		"&eStarballoon&r: carries Mekanism gases. &eStarBin&r: deletes junk on the ground."
		"Wixies get cooking pots, furnaces and cutting boards; plus lots of hats."
		""
		"Put the accessory on the Starbuncle, then link it with the Dominion Wand as usual."
	]
	quest.5A8485CEFAD74649.title: "Ars Creo: Starbuncle Power"
	quest.5A8485CEFAD74649.quest_desc: [
		"&eArs Creo&r connects Ars to &bCreate&r. The &eStarbuncle Wheel&r (a Starbuncle Charm and a"
		"Create water wheel) makes rotation; a gold block in front of it speeds it up."
		""
		"Spell Turrets fire when they ride on a contraption, and Create's Display Link can show"
		"how much Source is in a jar."
	]
	quest.6ABADEF3F8C6F9B7.title: "The Mage's Spell Book"
	quest.6ABADEF3F8C6F9B7.quest_desc: [
		"Your novice book only holds &eTier 1&r glyphs. Upgrade it with obsidian, 3 diamonds,"
		"2 quartz blocks and 2 blaze rods (from the Nether) to unlock &eTier 2&r glyphs."
		"All your spells move into the new book."
		""
		"Mana-powered movement opens up here: &eLeap&r, &eGlide&r (elytra-style flight for a while)"
		"and &eBlink&r (Self + Blink hops you forward). Each cast costs mana: earned travel, not free."
	]
	quest.2C37028356A051C9.title: "The Wilden"
	quest.2C37028356A051C9.quest_desc: [
		"&cWilden&r are wild magic beasts that roam at night near their dens."
		"&eHunters&r (forests, with wolves) drop &eHorns&r, &eStalkers&r (forests, in groups) drop"
		"&eWings&r, and &eDefenders&r (cold biomes) drop &eSpikes&r."
		""
		"Bring friends. You'll need one of each drop for the next quest."
	]
	quest.00E94F9577609EF6.title: "The Wilden Chimera"
	quest.00E94F9577609EF6.quest_desc: [
		"Craft the &eSummon Wilden&r tablet and start it at a Ritual Brazier with a Wilden Spike,"
		"Horn and Wing thrown in: that calls the &cWilden Chimera&r, a mini-boss."
		""
		"&cWarning:&r it breaks blocks around the brazier. Build the arena far from your base!"
		"It resists cold. The guide suggests Tier 2 spells, buffs, Dispel and fast movement."
		"It drops the &eWilden Tribute&r."
	]
	quest.3F887FB1C29780C4.title: "The Archmage Spell Book"
	quest.3F887FB1C29780C4.quest_desc: [
		"The last upgrade: your Mage's book plus 3 ender pearls, 2 emeralds, a Totem of Undying,"
		"a &eNether Star&r and the &eWilden Tribute&r. It unlocks &eTier 3&r glyphs:"
		"the strongest spells in Ars Nouveau."
	]
	quest.53DE5E81A4BEC9AF.title: "Ars Elemental"
	quest.53DE5E81A4BEC9AF.quest_desc: [
		"&eArs Elemental&r adds a school to each element. A &eLesser Focus&r (an amethyst shard"
		"imbued with 3 essences and 3 gold) powers up spells of its element; the full Focus needs a"
		"&eMark of Mastery&r."
		""
		"It also adds elemental mage armor, bangles, spell prisms and lenses,"
		"and new familiars (Sirens, Flashjacks)."
	]
	quest.6FF9820122321276.title: "Ars Additions: Charms"
	quest.6FF9820122321276.quest_desc: [
		"&eArs Additions&r adds &echarms&r: small trinkets made in the Enchanting Apparatus that"
		"protect you from one thing (darkness, falling, fire, drowning, the void and more)."
		"&eCharm of Darkvision&r is a glass bottle with a lantern and a torch."
		""
		"It also adds the &eEnder Source Jar&r, lanterns and chains, and handy rituals."
	]
	quest.1D11736B001EE655.title: "Ars Trinkets: Mana Rings"
	quest.1D11736B001EE655.quest_desc: [
		"&eArs Trinkets&r adds colored &eessences&r made in the Imbuement Chamber: a copper block"
		"becomes Copper Essence, which is imbued up to Iron, then Silver, and higher."
		"Eight essences around a &eRing of Potential&r"
		"make a &eMana Ring&r with more max mana; lotuses, monocles and runes work the same way."
	]
	quest.0D6936D1C0308851.title: "Ars Énergistique"
	quest.0D6936D1C0308851.quest_desc: [
		"&eArs Énergistique&r stores Source in your &bAE2&r network. The &eME Source Jar&r"
		"(a Source Jar with an ME Interface and Manipulation Essence) lets the network see Source,"
		"and Source cells hold huge amounts."
		""
		"Needs an AE2 network first: see the AE2 chapter."
	]
	quest.43D61E0C34938183.title: "Ars Nouveau's Flavors & Delight"
	quest.43D61E0C34938183.quest_desc: [
		"Magic food! &eArs Delight&r adds dishes made from Sourceberries, Archwood bark,"
		"the magic fruits of Archwood trees, and even Wilden and Chimera meat."
		"Most are made in Farmer's Delight's Cooking Pot or on its Cutting Board."
	]
	quest.4DF82EB64A3B952B.title: "Where Next?"
	quest.4DF82EB64A3B952B.quest_desc: [
		"You're a real mage now. Keep going:"
		""
		"&dIron's Spells 'n Spellbooks&r: ready-made spells from scrolls. With Ars 'n Spells,"
		"both mods share &eone mana pool&r."
		"&dOccultism&r: summon spirits that work for you (they live happily in Containment Jars)."
		"&dNeo Vitae&r: blood magic. &dTheurgy&r: alchemy that multiplies ores."
		""
		"&eArs Conflux&r is installed too: it helps the add-on glyphs work together and adds a"
		"&eNearby Allies&r glyph for group buffs."
	]
	chapter.156D4C94B07E4CBE.title: "Ars Nouveau"
	chapter.156D4C94B07E4CBE.chapter_subtitle: ["Design your own spells, glyph by glyph"]
	quest.31E061BF96F2149B.title: "What is Iron's Spells?"
	quest.31E061BF96F2149B.quest_desc: [
		"&dIron's Spells 'n Spellbooks&r is ready-made magic: fireballs, healing circles, lightning,"
		"summons and more. Spells come on &escrolls&r that you find, loot or craft,"
		"and you write them into a &espell book&r to cast them again and again."
		""
		"Every spell belongs to a &eschool&r, and armor, rings and runes make your favorite school stronger."
		"Explore! Magic towers and ruins are full of loot, each guarded by a mage."
	]
	quest.12FF6592C8C970F2.title: "Arcane Essence"
	quest.12FF6592C8C970F2.quest_desc: [
		"&eArcane Essence&r is the basic Iron's material. You find it in chests, especially in"
		"magic structures, and spellcasting mobs drop it."
		""
		"Craft a book with one Arcane Essence to get the mod's guide book."
	]
	task.290FB02621F8A591.title: "Find or loot any scroll"
	quest.48C339B5C4F6C5D0.title: "Scrolls"
	quest.48C339B5C4F6C5D0.quest_desc: [
		"A &escroll&r holds one spell at one level. Right-click to cast it once for free (no mana),"
		"but then it's gone. Better: save it and write it into a spell book."
		""
		"Scrolls drop from mobs, sit in chests, and can be crafted later at the Scroll Forge."
	]
	quest.47F64DCCF2DC9E48.title: "Your First Spell Book"
	quest.47F64DCCF2DC9E48.quest_desc: [
		"The &eFlimsy Journal&r is the starter spell book: paper, string and copper."
		"Bigger books hold more spells. Equip it in your &espellbook&r accessory slot (Curios) so you"
		"can cast while holding a sword."
	]
	quest.322DCC2EE98804C5.title: "The Inscription Table"
	quest.322DCC2EE98804C5.quest_desc: [
		"Put your spell book and a scroll in the &eInscription Table&r to write the spell in."
		"You can take it back out as a scroll later, but that clears the slot."
		""
		"To cast: pick a spell with the &espell wheel&r (its key is in Options > Controls),"
		"then use the \"Cast Selected Spell\" key, also in Options > Controls."
	]
	quest.075237ACE1FAA012.title: "Mana"
	quest.075237ACE1FAA012.quest_desc: [
		"Spells from a book cost &bmana&r and have a short cooldown. Mana refills over time."
		""
		"&eWandering Magician&r armor (leather armor + Arcane Essence) is an easy early way to get more"
		"max mana: craft the chestplate. Rings and amulets add more."
		""
		"&dShared with Ars Nouveau:&r Ars 'n Spells joins the two mods' mana into one pool, so your"
		"Ars spells and Iron's spells drink from the same bar (by default it's Iron's mana bar)."
	]
	quest.3458057A0DA97052.title: "The Schools of Magic"
	quest.3458057A0DA97052.quest_desc: [
		"Each school has a theme and a &efocus&r item used to craft its scrolls, runes and gear:"
		""
		"&cFire&r (blaze rod): burning damage. &bIce&r (frozen bone): damage and slowing."
		"&eLightning&r (Bottle o' Lightning): big single hits. &6Holy&r (Divine Pearl): healing and buffs."
		"&5Ender&r (ender pearl): arcane damage and movement. &4Blood&r (Blood Vial): necromancy and life drain."
		"&aEvocation&r (emerald): tricks and summons. &2Nature&r (poisonous potato): poisons and debuffs."
		""
		"&8Eldritch&r is forbidden: you learn it only from &eEldritch Manuscripts&r found in the world."
	]
	quest.739A7F296F0C6288.title: "Graybeard Staff"
	quest.739A7F296F0C6288.quest_desc: [
		"A &ecasting implement&r: right-click to cast your selected spell, with bonuses for mages."
		"This one is a wooden shovel, an iron ingot and an Arcane Essence."
	]
	quest.40D3A8FEE7455EB4.title: "The Scroll Forge"
	quest.40D3A8FEE7455EB4.quest_desc: [
		"Make your own scrolls! The &eScroll Forge&r (polished deepslate and crying obsidian)"
		"uses &eink&r, paper and a school &efocus&r. The focus picks the school;"
		"the ink picks the rarity (and so the spell's level)."
		""
		"Ink is found in magic chests and dropped by spellcasting mobs (rare ink especially)."
		"In the &eAlchemist Cauldron&r you can brew ink up a rarity: common ink + copper makes"
		"uncommon, + iron makes rare, + gold makes epic."
	]
	quest.4A515B6E6B144DE2.title: "Apprentice's Spell Book"
	quest.4A515B6E6B144DE2.quest_desc: [
		"A bigger book from gold, Arcane Essence and &eHogskin&r (dropped by Hoglins in the Nether)."
		"More slots means more spells on your wheel."
	]
	quest.344D5A06184BEB82.title: "Arcane Cloth and Runes"
	quest.344D5A06184BEB82.quest_desc: [
		"&eArcane Cloth&r (wool wrapped in Arcane Essence) is the base of real mage armor."
		"&eRunestones&r are found in magic structures; a blank rune surrounded by a school's focus"
		"becomes that school's rune. Class mages always drop a rune of their school."
	]
	task.67F89621965D70C5.title: "Any school chestplate (Pyromancer shown)"
	quest.7CB04D4BD6B03D49.title: "School Armor"
	quest.7CB04D4BD6B03D49.quest_desc: [
		"Each school has its own armor set (Pyromancer, Cryomancer, Electromancer, Priest, Plagued,"
		"Cultist, Archevoker, Shadow-Walker...). They boost that school's spell power and your mana."
		"The recipe is a wizard armor piece, the school's rune and Arcane Essence."
		""
		"The task shows a Pyromancer Robe; click it with &eR&r to see all of them, any is fine to aim for."
	]
	quest.3D6C23A7C78853D3.title: "The Alchemist Cauldron"
	quest.3D6C23A7C78853D3.quest_desc: [
		"Recycle scrolls you don't want, brew &eink&r into stronger ink, and brew Iron's elixirs"
		"(Oakskin, Evasion, Invisibility...)."
		"It needs &eCinder Essence&r, dropped by &cAncient Knights&r: they wake up when you break"
		"armor piles in the Nether."
	]
	quest.1006BE110A92440E.title: "The Arcane Anvil"
	quest.1006BE110A92440E.quest_desc: [
		"The strongest Iron's workstation: &elevel up scrolls&r (scroll + ink of the next rarity),"
		"upgrade armor and spell books, and &eimbue weapons&r with a spell."
		""
		"Late game also brings &eMithril&r (a rare ore below y = -38, hidden from air;"
		"needs a netherite pickaxe) and &eupgrade orbs&r (an orb plus 8 runes)."
	]
	quest.6F8F8E34558B0C4F.title: "The Best Books"
	quest.6F8F8E34558B0C4F.quest_desc: [
		"The &eAncient Codex&r is made from netherite and the &eRuined Book&r found in Ancient Cities."
		"The &eDragonskin Spell Book&r needs Dragonskin, dropped by the Ender Dragon."
		"Named spell books with special bonuses also hide around the world."
	]
	quest.3825657FDE6D1E99.title: "Ars 'n Spells and Iron & Nouveau"
	quest.3825657FDE6D1E99.quest_desc: [
		"Two bridge mods tie Iron's to &dArs Nouveau&r:"
		""
		"&eArs 'n Spells&r: one shared mana pool. The &eSpell Loom&r (or the Spell Transcription ritual)"
		"writes an Ars spell onto a &eBlank Scroll&r (Blank Parchment + Source Gem). Bind that scroll"
		"into an Iron's spell book and your Ars spell shows up on the spell wheel."
		""
		"&eIron & Nouveau&r: adds Ars glyphs that cast Iron's spells (Firebolt, Icicle, Heal,"
		"Chain Lightning, Summon Vex...), so you can mix them into your own Ars spells."
	]
	quest.6D7DC7FDE0DAD663.title: "Apotheosis x Iron's Spells"
	quest.6D7DC7FDE0DAD663.quest_desc: [
		"With this bridge, &eApotheosis&r gems also fit &espell books and staves&r, and gear can"
		"roll magic affixes like \"on hit, cast a spell\". Keep an eye on rare loot!"
	]
	quest.01C05ADA915758EA.title: "Cataclysm: Spellbooks"
	quest.01C05ADA915758EA.quest_desc: [
		"&eCataclysm: Spellbooks&r adds spells and mage gear themed on the &cL_Ender's Cataclysm&r bosses."
		"Their manuscripts and tablets teach new spell sets: for example the &eBurning Manuscript&r"
		"holds the blazing spells of Ignis. Beat the bosses (see the Cataclysm chapter) to find them."
	]
	quest.17B82AB38586D015.title: "Vampires and Spells"
	quest.17B82AB38586D015.quest_desc: [
		"If you play &4Vampirism&r: a vampire can pay for &4Blood&r school spells with their own blood"
		"instead of mana. &6Holy&r spells hit Vampirism's vampires extra hard, and holy healing doesn't"
		"sit well with vampire players. See the Vampirism chapter."
	]
	quest.0C513172E8AC93BF.title: "Where Next?"
	quest.0C513172E8AC93BF.quest_desc: [
		"&dArs Nouveau&r: build your own spells from glyphs, sharing your mana."
		"&dOccultism&r: spirits and rituals. &dNeo Vitae&r: blood magic."
		"&cBosses&r: mage towers, the Cataclysm bosses and the Ender Dragon drop the best magic loot."
	]
	chapter.7190A20637CE4339.title: "Iron's Spells 'n Spellbooks"
	chapter.7190A20637CE4339.chapter_subtitle: ["Scrolls, spell books and nine schools of magic"]
	quest.2AAEEB0B3ABE1120.title: "What is Occultism?"
	quest.2AAEEB0B3ABE1120.quest_desc: [
		"Hidden behind our world is the &5Otherworld&r, full of spirits."
		"&dOccultism&r teaches you to see it, draw &echalk circles&r (pentacles), and summon spirits"
		"with &erituals&r. Bound spirits &ework for you&r: crushing ores into extra dust,"
		"chopping trees, moving items, mining in their own dimension, or running a huge magic storage."
		""
		"Spirits come in four strengths: &aFoliot&r, &eDjinni&r, &6Afrit&r and &cMarid&r."
	]
	quest.5AF1C62C69AE6BBC.title: "Demon's Dream"
	quest.5AF1C62C69AE6BBC.quest_desc: [
		"Break grass to find &eDemon's Dream seeds&r and grow them. Eating the fruit can give you"
		"the &5Third Eye&r: you see Otherworld blocks hiding in plain sight, and you can harvest them"
		"while the effect lasts."
		""
		"Several fruit or seeds can be pressed into an essence that always works (with side effects)."
	]
	quest.290498A93E839B0E.title: "Dictionary of Spirits"
	quest.290498A93E839B0E.quest_desc: [
		"A book and a Demon's Dream seed make the &eDictionary of Spirits&r, Occultism's guide."
		"Every ritual page shows its ingredients and a blue link that previews its pentacle in the world."
		"You'll also use the Dictionary to write spirit names into Books of Binding (it isn't used up)."
	]
	task.56513D671CF0CF91.title: "Make Otherstone in Spiritfire"
	quest.6DD744D930D2A7B4.title: "Spiritfire"
	quest.6DD744D930D2A7B4.quest_desc: [
		"Throw a &eDemon's Dream&r fruit on the ground and light it with flint and steel:"
		"&bSpiritfire&r! It doesn't hurt you, but items thrown in change:"
		""
		"&eAndesite&r becomes &eOtherstone&r, &ediamonds&r become &eSpirit Attuned Gems&r,"
		"a &ebook&r becomes a Taboo Book, &ea feather&r an Awakened Feather, &eblack dye&r Purified Ink,"
		"and impure chalk becomes real chalk."
	]
	quest.6D2AF589F8FBBF99.title: "Spirit Attuned Gem"
	quest.6D2AF589F8FBBF99.quest_desc: [
		"A diamond burned in Spiritfire. It goes into the &eDivination Rod&r, Infused Lenses and"
		"the Infused Pickaxe."
		""
		"&eDivination Rod&r: sneak-click a block to tune it (oak wood finds Otherworld trees,"
		"netherrack finds Iesnium), then hold right-click to search."
	]
	quest.7C99B62E9F430011.title: "White Chalk"
	quest.7C99B62E9F430011.quest_desc: [
		"Craft &eimpure white chalk&r from Otherstone dust and Otherworld wood dust,"
		"then purify it in Spiritfire."
		""
		"Right-click blocks with chalk to draw. Only the &ecolor and position&r of the marks matter,"
		"not the little symbols. A &eChalk Brush&r cleans them up."
	]
	quest.278E6717F60944D1.title: "Ritual Bowls"
	quest.278E6717F60944D1.quest_desc: [
		"&eSacrificial Bowls&r (Otherstone) hold the ritual ingredients. They can go &eanywhere&r"
		"within 8 blocks of the center."
		""
		"The &eGolden Ritual Bowl&r sits in the middle of the pentacle. You start a ritual by"
		"right-clicking it with the activation item, usually a bound Book of Binding."
	]
	quest.69FDA4C72A4BBAB7.title: "Books of Binding"
	quest.69FDA4C72A4BBAB7.quest_desc: [
		"A &eBook of Binding: Foliot&r is a Taboo Book, Purified Ink, an Awakened Feather and blue dye."
		"Craft it with your Dictionary of Spirits to write a spirit's name in: now it's &ebound&r"
		"and ready to summon a Foliot."
	]
	task.6184F9131B445937.title: "Crush ore into Iron Dust"
	quest.35F5D22EE37E6CF5.title: "Your First Ritual: Foliot Crusher"
	quest.35F5D22EE37E6CF5.quest_desc: [
		"Draw &eAviar's Circle&r (the Foliot pentacle) in white chalk around the golden bowl,"
		"put an iron, gold, copper and silver ingot in the bowls, and right-click the golden bowl"
		"with your bound Foliot book."
		""
		"A &aFoliot Crusher&r appears. Drop ores near it: it crushes &eone ore into two dusts&r."
		"Pair it with a Transporter and a Janitor spirit to automate it."
	]
	quest.332E9F135A45753A.title: "More Foliot Helpers"
	quest.332E9F135A45753A.quest_desc: [
		"Other Foliot rituals call a &eLumberjack&r, a &eFarmer&r, a &eTransporter&r (moves items between"
		"chests) and a &eJanitor&r (picks up items). They come with a &eBook of Calling&r: right-click air to"
		"set it up, sneak-click a block to give the spirit its work area or drop-off chest."
		""
		"Spirits slowly &edecay&r and go home over time. Store one in a Magic Lamp or Book of Calling,"
		"or (with Ars Ocultas) in a Containment Jar where it never decays."
	]
	quest.5AD0CCC49605DFE7.title: "Otherworld Goggles"
	quest.5AD0CCC49605DFE7.quest_desc: [
		"A Foliot bound into &eInfused Lenses&r lends you its sight. The &eOtherworld Goggles&r give a"
		"permanent Third Eye and show even more hidden blocks (no more nauseous fruit!)."
		""
		"They let you &esee&r, not harvest: for that you need an Infused or Iesnium Pickaxe."
	]
	quest.1A00A9B68BB26152.title: "Calling a Djinni"
	quest.1A00A9B68BB26152.quest_desc: [
		"&eDjinn&r are stronger spirits. Their rituals need new pentacles and colored chalk"
		"(look up each ritual in the Dictionary). A Djinni Crusher turns one ore into three dusts,"
		"and Djinn make soul gems, the Infused Pickaxe and the storage system's heart."
	]
	quest.4E51EF6683BF6B9E.title: "Familiars"
	quest.4E51EF6683BF6B9E.quest_desc: [
		"&eFamiliar rituals&r summon spirits in animal bodies that follow you and give buffs:"
		"the &eGreedy&r familiar picks up items, the &eBat&r gives night vision, and many more"
		"(see the Familiar Rituals category)."
		""
		"Catch a familiar in a &eFamiliar Ring&r (a soul gem with a Djinni, made by ritual) and wear it"
		"as a curio to keep its buff. Ars Ocultas also lets Occultism's dragon be an Ars familiar."
	]
	quest.23F4B970A76E6BEF.title: "Dimensional Storage"
	quest.23F4B970A76E6BEF.quest_desc: [
		"Spirits can hold a whole &estorage dimension&r. The &eDimensional Storage Actuator&r is a"
		"&eDimensional Matrix&r (a Djinni ritual) on top of a &eStorage Actuator Base&r (a Foliot ritual)."
		""
		"Right-click it to open one huge sorted inventory: 128 item types and 256,000 items to start."
		"Storage Stabilizers placed around it add more. Breaking it keeps everything inside the item."
	]
	quest.3B5C03AA49E84EE4.title: "Iesnium"
	quest.3B5C03AA49E84EE4.quest_desc: [
		"A rare Otherworld metal that looks like netherrack. Wear your goggles in the &cNether&r,"
		"tune a Divination Rod to netherrack to find it, and mine it with an Infused Pickaxe."
		"Raw Iesnium smelts into ingots."
		""
		"Iesnium makes a tough pickaxe, magic lamps for &espirit miners&r, and more."
	]
	quest.5689E6459A3F31D7.title: "Spirit Miners"
	quest.5689E6459A3F31D7.quest_desc: [
		"The &eDimensional Mineshaft&r is a portal for spirits only, into a mining dimension."
		"Put a spirit in a &eMagic Lamp&r into it and it mines ores for you, lag free."
		"The &aMiner Foliot&r is the first (it needs an Iesnium Pickaxe); Djinni, Afrit and Marid miners"
		"dig better ores."
	]
	quest.7F82733A772C421F.title: "Afrit Essence"
	quest.7F82733A772C421F.quest_desc: [
		"To control the stronger spirits you need &cred chalk&r, made with &6Afrit Essence&r."
		"You get it by summoning an &cunbound&r Afrit and defeating it. Unbound spirits are dangerous:"
		"gear up, and keep the ritual far from your base."
		""
		"Afrit crushers turn one ore into four dusts."
	]
	quest.6BECBFDCE3DA89C8.title: "Marid Essence"
	quest.6BECBFDCE3DA89C8.quest_desc: [
		"The most powerful spirits need &bblue chalk&r from &cMarid Essence&r. Like the Afrit,"
		"you summon a Marid unbound and defeat it. Bring friends."
		""
		"Marid crushers turn one ore into six dusts, and Marid miners are the best spirit miners."
	]
	quest.78E6D94677FFCF8E.title: "Ars Ocultas"
	quest.78E6D94677FFCF8E.quest_desc: [
		"&dArs Ocultas&r links Occultism to Ars Nouveau: spirits work inside Ars &eContainment Jars&r"
		"without decaying (a jarred Crusher picks up ores within a 7x7 area and crushes them),"
		"and the Imbuement Chamber can turn silver into gold and back. See the Ars Nouveau chapter."
	]
	quest.7384A76D855C3D9C.title: "Where Next?"
	quest.7384A76D855C3D9C.quest_desc: [
		"&dArs Nouveau&r: spirits in jars, plus spells. &dTheurgy&r: by the same author, alchemy that"
		"turns one ore into several ingots (its divination rods find ores)."
		"&dNeo Vitae&r: blood magic with its own rituals."
	]
	chapter.04A8EEB70DFF77BC.title: "Occultism"
	chapter.04A8EEB70DFF77BC.chapter_subtitle: ["Chalk circles, rituals and spirits that work for you"]
	quest.32A1F134D2EA9E74.title: "What is Neo Vitae?"
	quest.32A1F134D2EA9E74.quest_desc: [
		"&4Neo Vitae&r is the new version of &4Blood Magic&r. Your own blood (and the life of mobs"
		"you slay) goes into an altar, the &eAra Vitae&r, which refines it into &cEssentia Vitae&r (EV)."
		""
		"EV pays for everything: crafting at the altar, &esigils&r (magic tools), rituals and more."
		"Your personal EV pool is your &eAnima&r; an &eOrb of Vitae&r links you to it."
		""
		"It costs health, so keep food and a safe spot nearby."
	]
	quest.3EC81508296727A6.title: "Scriptura Vitae"
	quest.3EC81508296727A6.quest_desc: [
		"A book with 4 redstone around it makes &eScriptura Vitae&r, Neo Vitae's guide."
		"Neo Vitae has its own names for familiar Blood Magic things; the guide's glossary explains them."
	]
	quest.1E81241930B12B6E.title: "The Ara Vitae"
	quest.1E81241930B12B6E.quest_desc: [
		"The &eAra Vitae&r (Altar of Life) is deepslate around a furnace with 3 gold ingots."
		"Right-click it to put an item in; right-click empty-handed to take it out."
		""
		"The basin holds 10,000 EV at first. Its crimson level shows how full it is."
	]
	quest.35620889DF9145E0.title: "Your First Orb"
	quest.35620889DF9145E0.quest_desc: [
		"Lay a &ediamond&r on the empty altar. With no EV of its own, it draws blood from players"
		"standing nearby (it never kills anyone) and turns the diamond into the"
		"&eNovicius Orb of Vitae&r."
		""
		"&cThere's no sacrificial dagger in Neo Vitae:&r right-click the orb to sacrifice one heart"
		"(200 EV). Near an altar the blood goes into the basin; away from one, it's stored in the orb."
	]
	quest.071B09A651D476CB.title: "Harvest of the Slain"
	quest.071B09A651D476CB.quest_desc: [
		"Kill mobs with your orb in your &eoff-hand&r: their life goes into the orb"
		"(10 EV per point of the mob's max health; a zombie gives 200)."
		"Much kinder to your own hearts!"
		""
		"The orb in your off-hand can also raise a &eSanguine Ward&r that blocks arrows and fireballs"
		"in front of you while you hold the key (right-click by default)."
	]
	quest.06854A75B696A8CC.title: "The Slates"
	quest.06854A75B696A8CC.quest_desc: [
		"&eSlates&r are the base of most Neo Vitae crafts. Put &edeepslate&r on the altar:"
		"1,000 EV makes a &eTabula Rasa&r. Better slates need bigger altars:"
		"Tabula Robur (tier 1), Animata (tier 2), Spiritus (tier 3), Aetherea (tier 4)."
		""
		"Short of deepslate? Cobblestone on the altar turns into cobbled deepslate for 50 EV."
	]
	quest.07809E9FF5B9D314.title: "The Tabula Vitae"
	quest.07809E9FF5B9D314.quest_desc: [
		"The &eTabula Vitae&r crafts with EV straight from your Anima, through the orb placed in it."
		"It makes &ereagents&r for sigils, scribe tools for arrays, anointments for weapons,"
		"double ore processing, and &eThrowing Daggers&r."
	]
	quest.66F113F53BC2BB40.title: "Throwing Daggers"
	quest.66F113F53BC2BB40.quest_desc: [
		"16 &eThrowing Daggers&r from 2 iron ingots and a string at the Tabula Vitae."
		"Mobs wounded by them leave &5Spiritus&r, the fuel of the Hellfire Forge."
	]
	quest.788A8C071662A3AC.title: "Alchemy Arrays"
	quest.788A8C071662A3AC.quest_desc: [
		"Use an &eArcane Scribe Tool&r on the ground to draw an &eAlchemy Array&r, a circle that takes"
		"two items. Some combinations craft things, others cast effects."
		""
		"&eDivination Sigil&r: redstone, then a Tabula Rasa. Right-click it to see your Anima;"
		"look at the altar to read its tier and contents."
	]
	quest.061EA64B9BFCC22F.title: "Sigils"
	quest.061EA64B9BFCC22F.quest_desc: [
		"&eSigils&r are tools powered by your Anima. The &eWater Sigil&r makes a water source for"
		"100 EV a use (its reagent is sugar and two water buckets at the Tabula Vitae, then an array"
		"with a Tabula Rasa). If your Anima is empty, it takes the cost from your health!"
		""
		"Others: Lava, Void, Green Grove (growth), Fast Miner, Magnetism, Blood Lamp, Holding..."
		"The &eAir Sigil&r flings you through the air for 50 EV a burst (mind the landing)."
	]
	quest.7CB6D2D024229E89.title: "Altar Tier 1"
	quest.7CB6D2D024229E89.quest_desc: [
		"Ring the altar with &e8 Blank Runes&r (deepslate around a Tabula Rasa and your orb)"
		"to reach &eTier 1&r. The four side runes can be swapped for special ones:"
		""
		"&eSpeed&r: faster crafting. &eCapacity&r: bigger basin. &eSacrifice&r / &eSelf-Sacrifice&r:"
		"more EV from mobs / from you. &eCharging&r, &eOrb&r, &eAcceleration&r, &eDisplacement&r: see the guide."
	]
	quest.0B50990AA0DD000F.title: "Discipulus Orb"
	quest.0B50990AA0DD000F.quest_desc: [
		"A &eblock of redstone&r on a Tier 1 altar (5,000 EV) makes the &eDiscipulus Orb&r,"
		"a bigger Anima. Your old orb's network carries over: it's still you."
	]
	quest.14430B8C1FFB3F7B.title: "The Hellfire Forge"
	quest.14430B8C1FFB3F7B.quest_desc: [
		"The &eHellfire Forge&r runs on &5Spiritus&r. Craft a &ePetty Spiritus Gem&r in it"
		"(redstone, gold, glass, lapis): the gem soaks up Spiritus from mobs you hit with daggers"
		"or Sentient weapons, and feeds the forge."
		""
		"The forge makes better gems, Sentient tools, explosive mining charges and more."
	]
	quest.68515E20620D8712.title: "Sentient Sword"
	quest.68515E20620D8712.quest_desc: [
		"Put an iron sword in the forge with a Petty Spiritus Gem: the &eSentient Sword&r."
		"It harvests Spiritus far better than daggers, and grows stronger with the Spiritus you carry."
		"&eSentient Armor&r (iron armor bound in an array) learns from what you do and grows stronger."
	]
	quest.4824FF7617285153.title: "Altar Tier 2"
	quest.4824FF7617285153.quest_desc: [
		"&eTier 2&r: a wider ring of runes one level down (24 in all) with stone pillars at the"
		"corners capped with &eBlood Stained Glass&r. The Divination Sigil confirms the tier."
		""
		"A &egold block&r on the Tier 2 altar (25,000 EV) makes the &eVeneficus Orb&r."
	]
	quest.24B69E21AF1FD349.title: "Rituals"
	quest.24B69E21AF1FD349.quest_desc: [
		"Rituals are big circles of &eRitual Stones&r around a &eMaster Ritual Stone&r."
		"The &eRitual Diviner&r places the stones for you (pick a ritual, right-click the master stone)."
		"Wake it with an &eActivation Crystal&r (Weak: a Lava Crystal on a Tier 2 altar)."
		""
		"Rituals cost EV to start and often keep drawing EV while they run: crop growth, pumping,"
		"tree felling, the &eWell of Suffering&r (EV from mobs) and many more."
	]
	quest.1CE7A15CD95C382A.title: "Edge of the Demon Realm"
	quest.1CE7A15CD95C382A.quest_desc: [
		"The ritual &eBreaching the Edge of Demon Realm&r opens a way into a dangerous dungeon."
		"Inside grows &eTau Fruit&r: refine it in the &eAthanor&r into &eWeak Blood Shards&r,"
		"the key to Tier 3 and stronger anointments. Come armed!"
	]
	quest.01A80C5B2BEDCE76.title: "Magus Orb"
	quest.01A80C5B2BEDCE76.quest_desc: [
		"Tier 3 altar (pillars crowned with Bloodstone Bricks), then a &eWeak Blood Shard&r on it"
		"(40,000 EV) makes the &eMagus Orb&r. Beyond lie Tier 4 and 5, the Demon Realm's deeper"
		"dungeons, Hellforged metal and the Divinus Orb."
	]
	quest.430AF4B571E6CC4A.title: "Where Next?"
	quest.430AF4B571E6CC4A.quest_desc: [
		"&dArs Nouveau&r and &dIron's Spells&r: spells and mana. &dOccultism&r: spirits and chalk rituals."
		"Neo Vitae's &eTeleposers&r can swap blocks and players between two linked points for EV:"
		"earned travel with a real cost (see the guide)."
	]
	chapter.3CE366D8D242BDE4.title: "Neo Vitae"
	chapter.3CE366D8D242BDE4.chapter_subtitle: ["Blood magic: an altar, your Anima and a lot of sacrifice"]
	quest.2ED5310F6A6ECEC3.title: "What is Theurgy?"
	quest.2ED5310F6A6ECEC3.quest_desc: [
		"&6Theurgy&r is classic &ealchemy&r. Every item is made of three principles:"
		"&eSulfur&r (what it is), &eSalt&r (its body) and &eMercury&r (its energy)."
		""
		"Split an ore into its principles and put them back together, and you get &aseveral ingots"
		"from one raw ore&r. Later you can even turn one material into another."
		"It all runs on simple fuel like coal: no power grid needed."
	]
	quest.27BBE6023DD4B25F.title: "The Hermetica"
	quest.27BBE6023DD4B25F.quest_desc: [
		"Craft a book with 2 sand to get &eThe Hermetica&r, Theurgy's guide. It walks you through"
		"every machine step by step, with pictures. Keep it handy: alchemy has a few steps."
	]
	quest.7AEA33CCCD31BF05.title: "Divination Rods"
	quest.7AEA33CCCD31BF05.quest_desc: [
		"A &eGlass Divination Rod&r (glass and sticks) finds blocks for you."
		"&eSneak-click&r a block (say, iron ore) to tune it, then &ehold right-click&r to search:"
		"it turns purple when it finds one and sends a glowing ball toward it."
		""
		"Iron, diamond and netherite rods are upgrades. Rods pre-tuned with an ore's Sulfur"
		"(Abundant, Common, Rare, Precious) last much longer."
	]
	quest.1B1C13315CF1DF38.title: "Pyromantic Brazier"
	quest.1B1C13315CF1DF38.quest_desc: [
		"Every heated alchemy machine sits on a &ePyromantic Brazier&r. Put fuel like coal in it."
		"You'll want 4 to start: one each for the Calcination Oven, Distiller, Liquefaction Cauldron"
		"and Incubator."
	]
	quest.58142D978E669E3E.title: "Salt: Calcination"
	quest.58142D978E669E3E.quest_desc: [
		"Right-click the &eCalcination Oven&r with minerals (ores, raw metal, ingots, or renewable"
		"&echarcoal&r), heat the brazier below, and collect &eMineral Salt&r."
	]
	quest.57938B800464750E.title: "Mercury: Distillation"
	quest.57938B800464750E.quest_desc: [
		"The &eMercury Distiller&r pulls &eMercury Shards&r out of almost anything: crops, food,"
		"ores, stone, sand. Cheap items need a bunch for one shard; valuable ones give more."
	]
	quest.2FB1BDFCF32534A8.title: "Sal Ammoniac"
	quest.2FB1BDFCF32534A8.quest_desc: [
		"The solvent for liquefaction. Put the &eAccumulator&r on top of the &eTank&r and fill it"
		"with water buckets (up to 10). Slowly the tank fills with &eSal Ammoniac&r; take it out with"
		"a bucket."
		""
		"A &eSal Ammoniac Crystal&r (mined from its ore) dropped into the accumulator speeds it up a lot."
	]
	quest.1C0D3E4C359CF7E3.title: "Sulfur: Liquefaction"
	quest.1C0D3E4C359CF7E3.quest_desc: [
		"Fill the &eLiquefaction Cauldron&r with a Sal Ammoniac bucket, put in a &eraw iron&r, heat it:"
		"out comes &eIron Sulfur&r, several from one raw ore. This is where the multiplying happens."
	]
	quest.6DA5BFE87D61AA1D.title: "Incubation: 3 Ingots from 1"
	quest.6DA5BFE87D61AA1D.quest_desc: [
		"The &eIncubator&r puts the three principles back together. Fill its &eSulfur&r, &eSalt&r and"
		"&eMercury&r vessels, heat it, and collect &a3 iron ingots&r for every raw iron you liquefied."
		""
		"It works for most ores and raw metals. Look up any Sulfur with &eU&r to see what it makes."
	]
	quest.5BC12466FB1F72BB.title: "Reformation"
	quest.5BC12466FB1F72BB.quest_desc: [
		"The &eReformation Array&r changes one Sulfur into another of the &esame type and tier&r"
		"(lapis into quartz, diamond into emerald...), using Sulfuric Flux. Then incubate the new Sulfur"
		"as usual. The Hermetica shows how to build and power the array."
	]
	quest.03E76EE2CD268833.title: "Transmutation"
	quest.03E76EE2CD268833.quest_desc: [
		"To change a material's &etype&r (gem into metal), first ferment its Sulfur into &eNiter&r in the"
		"&eFermentation Vat&r (with water and sugar or crops). Niter is a \"concept\" like \"common metal\","
		"and it can be reformed into a different type. Roughly 2 metals make 1 gem and back."
	]
	quest.4AE2399DBA7A973D.title: "Exaltation"
	quest.4AE2399DBA7A973D.quest_desc: [
		"The last secret: raising a material's &etier&r, like turning iron into gold."
		"The &eDigestion Vat&r turns 4 Niter of a lower tier into 1 of the next, with &ePurified Gold&r"
		"as a catalyst (purify gold in the Digestion Vat with salt and water first). Costly, but you can"
		"make almost anything."
	]
	quest.7D3F97A77B367D9B.title: "Mercurial Logistics"
	quest.7D3F97A77B367D9B.quest_desc: [
		"Theurgy can move items and fluids along &eMercurial Copper Wires&r: extractors pull from a"
		"container, inserters push in, and wires (with connection nodes for long runs) link them."
		"Filters and frequencies split one wire network into several. Handy for automating your alchemy."
	]
	quest.12410EE3AA60CE90.title: "Where Next?"
	quest.12410EE3AA60CE90.quest_desc: [
		"&dOccultism&r (same author): spirits that crush ores too, and a Divination Rod for Otherworld blocks."
		"&dArs Nouveau&r: magic that runs on Source. Or feed your extra ingots into the &bTech&r chapters!"
	]
	chapter.06C17FAC00190D88.title: "Theurgy"
	chapter.06C17FAC00190D88.chapter_subtitle: [
		"Alchemy: find ores, triple them, turn one thing into another"
	]
	quest.30387378FED167F6.title: "What is Vampirism?"
	quest.30387378FED167F6.quest_desc: [
		"&4Vampirism&r adds vampires, vampire hunters and (with the Werewolves add-on) werewolves."
		"They live in the world either way: vampire mobs at night and in dark forests, hunter camps,"
		"and villages that one side controls."
		""
		"&aIt's completely optional.&r You can become a &4Vampire&r, a &6Hunter&r or a &2Werewolf&r,"
		"or just stay human and ignore it. You can only belong to one side at a time,"
		"and each one has a way back out (see below)."
	]
	quest.38315D3D68CAC3D1.title: "Pick a Side (or Don't)"
	quest.38315D3D68CAC3D1.quest_desc: [
		"&4Vampire&r: drink blood instead of eating, get strong and fast at night, and learn powers like"
		"bat form and teleporting. But the sun burns, and garlic and holy water hurt."
		"&6Hunter&r: a human with garlic in their blood: crossbows, stakes, holy water and special gear."
		"&2Werewolf&r: change into a wolf form for power and speed; silver is your weakness."
		"&7Human&r: skip this chapter. Nothing forces you in."
		""
		"The &eVampirism Menu&r and &eSkill Screen&r keys are in Options > Controls."
	]
	task.200BE1E8030EC0C4.title: "Become a Vampire"
	quest.76C05DFFAB9CD9D7.title: "Moving Beyond Humanity"
	quest.76C05DFFAB9CD9D7.quest_desc: [
		"Let a vampire &ebite&r you (or right-click with a &eVampire Fang&r) to get &4Sanguinare Vampiris&r."
		"When it runs out (about a Minecraft day) you're a vampire."
		""
		"&aChanged your mind?&r Drink milk, or talk to a hunter NPC, before it ends."
	]
	task.7079D1F7319DE1CB.title: "Drink blood"
	quest.16BF098E3C787D0F.title: "Blood, Not Bread"
	quest.16BF098E3C787D0F.quest_desc: [
		"Vampires live on &cblood&r. Hold the \"Suck blood\" key (Options > Controls) behind a villager"
		"or some animals to drink. Glass bottles on your hotbar fill into &eBlood Bottles&r when your"
		"blood bar is full; drink them later."
		""
		"Store extra blood in a &eBlood Container&r. Zombies leave you alone now, but hunters don't!"
		"Stay out of water and, at higher levels, out of the sun."
	]
	quest.6E07EFA8E5EEDFD5.title: "Vampire Levels"
	quest.6E07EFA8E5EEDFD5.quest_desc: [
		"You level up with rituals &eat night&r: first at the &eAltar of Inspiration&r (planks around a"
		"Blood Container) fed with blood, later at the bigger &eAltar of Infusion&r with pillars."
		"Each level brings more health, speed and strength, plus a skill point."
		""
		"Spend points in the Skill Screen: bat form, freezing enemies, teleporting, invisibility, sunscreen..."
		"Vampire Teleport is one of those earned skills, not a free command."
	]
	quest.4F09420C77322B54.title: "Vampire's Delight"
	quest.4F09420C77322B54.quest_desc: [
		"Vampires can't enjoy normal food, so &eVampire's Delight&r cooks for them: blood pies,"
		"blood wine, blood sausages and more, made with Farmer's Delight tools."
		"There are also treats for humans and hunters (garlic soup, garlic bread)."
	]
	quest.119FA42C4759C2EE.title: "Vampires Need Umbrellas"
	quest.119FA42C4759C2EE.quest_desc: [
		"Sun getting to you? An &eumbrella&r keeps the sun off a vampire. Iron, gold, diamond and"
		"netherite ones last longer and longer, in 16 colors."
	]
	quest.296397FCA6178159.title: "Vampiric Ageing"
	quest.296397FCA6178159.quest_desc: [
		"With &eVampiric Ageing&r, vampires also gain an &eAge Rank&r over time: survive, infect other"
		"creatures and drain blood to grow older and stronger. Hit another vampire with a"
		"&eBlood Tester&r to see how old it is."
	]
	quest.4C6E1DEB32BFCD00.title: "Bloodlines"
	quest.4C6E1DEB32BFCD00.quest_desc: [
		"&eBloodlines&r lets high-level vampires join a bloodline with its own skill tree:"
		"&eNoble&r, &eZealot&r (Deep Dark shrines), &eEctotherm&r (cold and water), &eBloodknight&r"
		"and &eGravebound&r. Each has strong powers and real weaknesses, and some ways of joining can kill"
		"you if they go wrong. Look up the fangs, elixirs and injections with &eR&r before you try."
		""
		"Leave a bloodline with a &ePurity Injection&r at an Injection Chair."
	]
	quest.24ED116715D9B52D.title: "Back to Human"
	quest.24ED116715D9B52D.quest_desc: [
		"Done being a vampire? Find an &eAltar of Cleansing&r in some village churches"
		"(or craft one from vampire fangs, a book and planks) and use it to become human again."
		"&cYou lose all your vampire levels.&r"
	]
	task.0C0312F72E30DFA2.title: "Become a Vampire Hunter"
	quest.6F8AD5162C8C40D8.title: "Start Hunting"
	quest.6F8AD5162C8C40D8.quest_desc: [
		"Find a village with a &eHunter Trainer&r. Garlic grows behind their house: craft a"
		"&eGarlic Injection&r (a Syringe made of glass, plus garlic) and use it on the"
		"&eInjection Chair&r inside. Garlic in your blood makes you immune to vampire bites."
		""
		"Plant some garlic, you'll need more."
	]
	quest.0964CDD613C8F2D6.title: "Stakes and Vampire Blood"
	quest.0964CDD613C8F2D6.quest_desc: [
		"Finish vampire NPCs with a &eStake&r to collect &eVampire Blood&r."
		"Give it to a hunter NPC to train from level 1 to 4."
	]
	quest.7D41AC8D592081E1.title: "Hunter Research"
	quest.7D41AC8D592081E1.quest_desc: [
		"For higher levels, research vampires at a &eHunter Research Table&r (a vampire fang, a book,"
		"garlic and planks) to make &eHunter Intel&r, then pay a Hunter Trainer to train you."
		"Blocks placed next to the table upgrade it for the top levels."
		""
		"Each level gives a skill point: crossbows and the Weapon Table, potions, disguise and more."
		"Vampires hate &egarlic&r (a &eGarlic Diffuser&r keeps vampire mobs out of your base),"
		"&eholy water&r and fire."
	]
	quest.7B558CB9F783607F.title: "Hanging Up the Crossbow"
	quest.7B558CB9F783607F.quest_desc: [
		"To stop being a hunter, the guide says to get the garlic out of your blood: craft a"
		"&eSanguinare Injection&r (a Syringe and 8 vampire fangs) and use it on an &eInjection Chair&r."
		"That starts turning you into a vampire; drink milk before it finishes to stay human instead."
	]
	task.1619482FDA456349.title: "Become a Werewolf"
	quest.7720F1829BF65C57.title: "Teen Wolf"
	quest.7720F1829BF65C57.quest_desc: [
		"With &eWerewolves&r, a werewolf's scratch can give you &2Lupus Sanguinem&r. Sleep, and you"
		"wake up a werewolf. You change into wolf form (and are forced to at a full moon, until a skill"
		"frees you). Choose a path: &cBeast&r, &aSurvivalist&r or &eHuman&r."
		""
		"&cSilver&r is your weakness: silver weapons and bolts slow you and break your defense."
	]
	quest.6EE8C609CFF269A3.title: "Werewolf Rituals"
	quest.6EE8C609CFF269A3.quest_desc: [
		"Werewolves level up at night at a &eStone Altar&r with four Stone Altar Fire Bowls around it,"
		"with the items it asks for plus enough creatures slain (shown in the Vampirism Menu)."
	]
	quest.0014FB2E5C91EC0F.title: "Lifting the Curse"
	quest.0014FB2E5C91EC0F.quest_desc: [
		"Want your old life back? Use an empty &eSyringe&r on a werewolf to collect a strange fluid,"
		"which makes a &eStrange Injection&r. Use it at an Injection Chair to lift the curse."
	]
	quest.0DC17425B75CEF1E.title: "Silver for Everyone"
	quest.0DC17425B75CEF1E.quest_desc: [
		"Even humans should carry a little protection. &eSilver&r ore (from Werewolves) smelts into"
		"ingots for silver tools, armor and Silver Oil (on a sword, extra damage to werewolves)."
	]
	task.500173ABFC61CDA2.title: "Visit a Vampire Forest"
	quest.4FF5460C3E7F9DAA.title: "The Vampire Forest"
	quest.4FF5460C3E7F9DAA.quest_desc: [
		"Dark, misty forests full of vampires, with castles and crypts. Bring torches,"
		"holy water or a vampire friend. Somewhere deep inside sleep the &4Ancient Remains&r..."
		""
		"&eVampirism Integrations&r makes other mods' villages work with Vampirism's factions too."
	]
	quest.5BEC39DF97D78B42.title: "Where Next?"
	quest.5BEC39DF97D78B42.quest_desc: [
		"&dIron's Spells&r: vampires can cast &4Blood&r spells with their own blood, and &6Holy&r spells"
		"are a hunter's best friend. &dArs Nouveau&r and &dOccultism&r work for every side."
	]
	chapter.7163DCDAB05CA28A.title: "Vampirism"
	chapter.7163DCDAB05CA28A.chapter_subtitle: [
		"Optional: become a vampire, a hunter or a werewolf, or ignore it all"
	]
	quest.5A156090BC09847D.title: "What is Exploring?"
	quest.5A156090BC09847D.quest_desc: [
		"The Overworld in Strata is big and wild: tall mountains (Tectonic), lots of new biomes"
		"(Regions Unexplored) and rivers that wind through it all."
		""
		"Hidden in it are hundreds of &edungeons, ruins, towers, villages and sky islands&r."
		"Every one has loot, and many have their own monsters or bosses."
		""
		"This chapter shows you how to find them. Bring food, torches and a bed!"
	]
	quest.7660D6644C45FFD1.title: "Point the Way"
	quest.7660D6644C45FFD1.quest_desc: [
		"Right-click your &eExplorer's Compass&r to open a list of every structure in the world."
		"Type in the search box, pick one, and the compass needle points to the nearest one."
		"It also tells you how far away it is."
		""
		"Picked a big one? Write the spot down as a waypoint (&eU&r) so you can find it again."
	]
	quest.393FD1F85995C976.title: "Nature's Compass"
	quest.393FD1F85995C976.quest_desc: [
		"The &eNature's Compass&r does the same thing for &abiomes&r."
		"Want cherry trees, a desert, or snowy peaks? Pick it from the list and follow the needle."
		""
		"Some structures only appear in certain biomes, so the two compasses work well together."
	]
	task.53A2E50F6FC6177A.title: "Visit Poppy Fields"
	quest.6707B97BB1278EDE.title: "Somewhere New"
	quest.6707B97BB1278EDE.quest_desc: [
		"Use the Nature's Compass to find &ePoppy Fields&r, a sea of red flowers."
		""
		"When you walk into a new biome or dimension, its name fades in on your screen"
		"(&eTraveler's Titles&r). It's a nice way to know you've found somewhere new."
	]
	quest.7718DC932F36117B.title: "Loot for Everyone"
	quest.7718DC932F36117B.quest_desc: [
		"Chests in structures are &eLootr&r chests: every player gets their &aown&r loot from each one."
		"If your friend opened it first, there's still a full chest waiting for you."
		""
		"So no racing for the loot. Explore together and everyone gets a share."
	]
	task.27D16B9237A49012.title: "Explore a desert temple"
	quest.03F9FEFC8BC511A2.title: "Better Desert Temple"
	quest.03F9FEFC8BC511A2.quest_desc: [
		"&eYUNG's&r mods rebuild the classic structures: desert temples, jungle temples,"
		"dungeons, mineshafts, witch huts, ocean monuments and Nether fortresses."
		""
		"Desert temples are now full tombs with traps, puzzles and a pharaoh's treasure."
		"Watch your step, and keep an eye out for strange &5eyes&r in the chests"
		"(you'll need them later, see &5The End&r)."
	]
	task.2CFF4B1CD2FC451F.title: "Explore a jungle temple"
	quest.580BC1D468ECFDBC.title: "Better Jungle Temple"
	quest.580BC1D468ECFDBC.quest_desc: [
		"Deep in the jungle, &eYUNG's&r jungle temples hide traps, levers and secret rooms."
		"Bring a few torches to mark where you've been."
	]
	task.1B6414E76512035F.title: "Climb a lighthouse"
	quest.386912732C3E8C44.title: "When Dungeons Arise"
	quest.386912732C3E8C44.quest_desc: [
		"&eWhen Dungeons Arise&r adds huge hand-built dungeons: forts, mines, monasteries, towers,"
		"palaces and even ones floating in the sky."
		""
		"Start with a &eLighthouse&r on the coast. The big ones (look for \"heavenly\" in the"
		"Explorer's Compass list) are great targets for your first airship."
	]
	task.22CEB718B066B800.title: "Board a Victory Frigate"
	quest.5390DEFB7B30F6DD.title: "The Seven Seas"
	quest.5390DEFB7B30F6DD.quest_desc: [
		"&eSeven Seas&r puts ships on the oceans: frigates, galleons, junks and yachts."
		"Many are crewed by pirates who don't like visitors."
		""
		"Board one by boat (or drop in from above) and loot the captain's cabin."
	]
	task.0FBADD6156CEBB81.title: "Board an Illager Warship"
	quest.6393B9BA1451110F.title: "Illager Warships"
	quest.6393B9BA1451110F.quest_desc: [
		"Illagers have a navy too: big &cwarships&r on the open ocean and war triremes on"
		"warm seas. They're well armed, so bring a shield and a full stack of food."
	]
	task.54A16EC31419817E.title: "Explore a castle"
	quest.71A6E089550DF696.title: "Castles and Taverns"
	quest.71A6E089550DF696.quest_desc: [
		"&eIntegrated Dungeons and Structures&r adds castles, wizard towers, taverns, camps,"
		"sunken ships and much more. Some are friendly, some really aren't."
		""
		"Find a &eCastle&r and see who lives there."
	]
	quest.7E39141966167740.title: "New Towns, New Faces"
	quest.7E39141966167740.quest_desc: [
		"Villages come in many styles here: &eTowns and Towers&r and &eIntegrated Villages&r add"
		"regional villages and outposts."
		""
		"The countryside is dotted with little builds: farms, wells, camps, ruins and"
		"watchtowers (&eExplorify&r, &eMoog's&r structures, &eDungeons and Taverns&r)."
		"Small places often hide a chest or two."
	]
	quest.597C3343D72CF836.title: "Look Up!"
	quest.597C3343D72CF836.quest_desc: [
		"Not everything is on the ground. &eEmber's Floating Islands&r and &eMoog's Soaring"
		"Structures&r hang in the sky, and &bsky whales&r drift high above the land."
		""
		"You can't reach them by walking. Build an airship (see the Create chapters) or"
		"find another clever way up. This is what Strata's \"Fly\" is all about."
	]
	task.74304E8771B1C219.title: "Land on a sky whale"
	quest.3F8AE5F23DE765BE.title: "Whale Watching"
	quest.3F8AE5F23DE765BE.quest_desc: [
		"Sky whales float around Y 180 to 220. Spot one, fly up, and land on its back."
		"Some carry a little ship or a lighthouse. Look for the loot!"
	]
	task.71AED05F1A7D963F.title: "Find Artifact Shards"
	quest.45FE18AA41E5C2C8.title: "Dig It Up"
	quest.45FE18AA41E5C2C8.quest_desc: [
		"Look for &esuspicious sand&r and &esuspicious gravel&r in ruins, temples and dig sites."
		"Brush it gently (hold right-click with a brush) to uncover what's buried."
		""
		"&eBetter Archeology&r adds &eArtifact Shards&r, fossils and more to find."
		"An &eIron Brush&r (feather, iron, stick) is a nice upgrade."
	]
	quest.521349A430C72882.title: "The Archeology Table"
	quest.521349A430C72882.quest_desc: [
		"Craft an &eArcheology Table&r (a brush, a shard and planks)."
		""
		"Nine Artifact Shards craft an &eUnidentified Artifact&r. Study it at the table to find out"
		"what it is. Identified artifacts give you special powers."
	]
	quest.3D9E8FA0368B86D6.title: "A Mystery Solved"
	quest.3D9E8FA0368B86D6.quest_desc: [
		"Identify your first artifact. Read its tooltip to see what it does."
		""
		"Keep digging: there are lots of different ones to collect."
	]
	quest.50FA5649D1823A0E.title: "Trinkets and Treasures"
	quest.50FA5649D1823A0E.quest_desc: [
		"Dungeon chests can hold &daccessories&r from &eArtifacts&r, &eRelics&r and"
		"&eForsaken Relics&r: rings, belts, amulets, hats and charms with special powers."
		""
		"Wear them in the &eaccessory slots&r (Curios) next to your inventory."
		"Read the tooltips: Relics get stronger the more you use them."
		""
		"&cCareful:&r some chests are &cmimics&r. If a chest bites back, fight it!"
	]
	quest.4B6F56E133FDF3F4.title: "Where Next?"
	quest.4B6F56E133FDF3F4.quest_desc: [
		"You know how to find anything now. Some bigger trips:"
		""
		"&cThe Nether&r: fiery fortresses and citadels."
		"&aThe Twilight Forest&r: a magic forest with a chain of bosses."
		"&bThe Aether&r: islands in the sky."
		"&5The End&r: find 12 eyes and open the stronghold portal."
		"&cThe Pokémon World&r: if you've found a Bell Fragment."
	]
	chapter.01EF06C46B0F1EC6.title: "Explorer's Guide"
	chapter.01EF06C46B0F1EC6.chapter_subtitle: ["Compasses, dungeons, ruins and treasure"]
	quest.69686D19E9C55435.title: "What is the Nether?"
	quest.69686D19E9C55435.quest_desc: [
		"The Nether is a burning underworld under a ceiling of rock. In Strata it's much richer:"
		"&eIncendium&r and &eEternal Nether&r add new biomes, mobs and big structures,"
		"and &eYUNG's&r rebuilds the Nether fortresses."
		""
		"Bring: a stack of blocks, food, a bow, and a &eflint and steel&r to relight your portal."
		"Lava is everywhere. Fire resistance potions are your best friend."
	]
	quest.334584320691A8F2.title: "Expert Mode"
	quest.334584320691A8F2.quest_desc: [
		"Your first trip here moved the whole server to &eExpert&r difficulty."
		"Regular mobs everywhere hit a bit harder and have more health. Bosses don't change."
		""
		"It's a modest step. Upgrade your armor soon, and keep a shield in your off-hand."
		"The next step, &cMaster&r, comes after the Ender Dragon."
	]
	quest.63E001FFDB4BBB22.title: "Piglin Manners"
	quest.63E001FFDB4BBB22.quest_desc: [
		"Piglins attack anyone not wearing &6gold&r. One piece of gold armor keeps most of them calm."
		"Don't open their chests or mine gold near them, though!"
		""
		"Toss them a gold ingot to barter for random goodies."
	]
	quest.4BEEC97E31569C42.title: "Ruined Portals"
	quest.4BEEC97E31569C42.quest_desc: [
		"Broken portals are scattered through the Overworld and the Nether, and &eHopo's Better"
		"Ruined Portals&r makes them bigger and more interesting."
		""
		"Their chests often have gold, and the leftover obsidian helps you build a second portal."
	]
	task.7AE85EE86929B260.title: "Explore a Nether fortress"
	quest.7E4CFCB8C2D54009.title: "Better Nether Fortress"
	quest.7E4CFCB8C2D54009.quest_desc: [
		"&eYUNG's Better Nether Fortresses&r are huge brick mazes with bridges, towers and halls."
		"Blazes and wither skeletons live here."
		""
		"Loot every chest: some hold a &5Nether Eye&r, one of the eyes you need to reach the End."
	]
	quest.6C41D3B98C3724FB.title: "Blaze Rods"
	quest.6C41D3B98C3724FB.quest_desc: [
		"Blazes float around fortresses shooting fireballs. Snowballs hurt them a lot!"
		""
		"Blaze rods make brewing stands and blaze powder. Fire resistance potions"
		"(magma cream + awkward potion) make the Nether much easier."
	]
	quest.224FD44748F1121B.title: "Skulls of the Wither"
	quest.224FD44748F1121B.quest_desc: [
		"Wither skeletons sometimes drop their skull. Three skulls and four soul sand"
		"summon &5the Wither&r, a dangerous boss. Fight it far from your base!"
		""
		"It drops a Nether Star, and it can drop a &5Wither Eye&r for the End portal."
	]
	task.46F16108B2E4A43B.title: "Find a bastion"
	quest.0D2689E953EC0BCB.title: "Bastion Remnants"
	quest.0D2689E953EC0BCB.quest_desc: [
		"Bastions are piglin castles full of gold, and full of angry piglin brutes."
		""
		"The treasure room can hold a &5Cursed Eye&r for the End portal,"
		"and bastion chests are where you find the &eNetherite Upgrade&r smithing template."
	]
	task.4A402BAB74BAB958.title: "Visit a Withered Forest"
	quest.125847F3D50B4FD0.title: "Incendium"
	quest.125847F3D50B4FD0.quest_desc: [
		"&eIncendium&r rebuilds the Nether's biomes: withered forests, volcanic deltas, ash barrens,"
		"toxic heaps, quartz flats and more. Each has its own look and dangers."
		""
		"Use the &eNature's Compass&r here too."
	]
	task.55434EA4539C1AA1.title: "Enter the Forbidden Castle"
	quest.13896A5FF8B31BF1.title: "The Forbidden Castle"
	quest.13896A5FF8B31BF1.quest_desc: [
		"Incendium's biggest structure. Its halls are packed with tough enemies and great loot."
		"Go with friends and plenty of potions."
		""
		"Other Incendium places to find: the Sanctum, the Nether Reactor, the Infernal Altar"
		"and piglin villages."
	]
	task.3D5649D03202F595.title: "Find a Warped Citadel"
	quest.5088ACA91F846825.title: "Eternal Nether: The Citadel"
	quest.5088ACA91F846825.quest_desc: [
		"&eEternal Nether&r adds the warped &bCitadel&r, the &6Piglin Manor&r"
		"and the &8Catacomb&r, each with its own mobs."
		""
		"Look for captured &ePiglin Prisoners&r and set them free."
		"Wither Skeleton Knights and withered skeleton horses roam here too: stay on your toes."
	]
	task.21D5DDBACE69BD85.title: "Rescue a Piglin Prisoner"
	quest.16587C0EEECDBDB0.title: "Saving Private Swine"
	quest.16587C0EEECDBDB0.quest_desc: [
		"Find a captured piglin and set it free. Somebody has to be the hero!"
	]
	task.0ADA61A8B38FA490.title: "Explore a Catacomb"
	quest.05BE8A639131B313.title: "The Catacomb"
	quest.05BE8A639131B313.quest_desc: [
		"Deep, dark tunnels full of withered undead. The Catacomb is no place to go alone."
	]
	quest.7135BBA895891AA2.title: "Odd Places"
	quest.7135BBA895891AA2.quest_desc: [
		"&eMoog's Nether Structures&r adds lots of smaller builds: bridges over lava, giant skulls,"
		"arenas, wells, houses and even a train."
		""
		"Stop and poke around: many have a chest."
	]
	quest.560E19A91319A3C3.title: "Ancient Debris"
	quest.560E19A91319A3C3.quest_desc: [
		"The toughest ore in the game hides low in the Nether (around Y 15) and doesn't burn in lava."
		"Mine around it carefully: it's often next to lava."
		""
		"Smelt it into &eNetherite Scrap&r. Four scrap plus four gold make one netherite ingot."
	]
	quest.4E02BDCCDD4A3F8D.title: "Netherite Ingot"
	quest.4E02BDCCDD4A3F8D.quest_desc: [
		"Craft your first &eNetherite Ingot&r (4 scrap + 4 gold)."
		"Netherite is used by lots of mods for their better tools and machines."
	]
	quest.0501AE8210BB4A86.title: "Netherite Gear"
	quest.0501AE8210BB4A86.quest_desc: [
		"Put a diamond tool, a netherite ingot and a &eNetherite Upgrade&r template in a"
		"&esmithing table&r. Your tool keeps its enchantments and gets stronger."
		""
		"Copy the template (seven diamonds, the template and netherrack make two)"
		"so you don't need another bastion trip."
		"Netherite items don't burn in lava."
	]
	quest.0E544A1B5250F1DE.title: "Fishing in Lava"
	quest.0E544A1B5250F1DE.quest_desc: [
		"&eNether Depths Upgrade&r fills the lava with fish. Craft a &eLava Fishing Rod&r"
		"(blaze rods, chain and netherite scrap) and cast it into a lava lake."
		""
		"Bonefish, searing cod, blazefish and more. Some are great food, some are ingredients."
	]
	quest.7B1C8981176A456B.title: "Nether Cooking"
	quest.7B1C8981176A456B.quest_desc: [
		"&eMy Nether's Delight&r brings Farmer's Delight cooking to the Nether:"
		"hoglin and strider dishes, spicy peppers and a stove made of nether bricks."
	]
	quest.14038F77BDCCE0BA.title: "Where Next?"
	quest.14038F77BDCCE0BA.quest_desc: [
		"The Nether opens up a lot:"
		""
		"&bSame-dimension wireless&r tech is unlocked now (see the Tech chapters)."
		"&5The End&r: the Nether Eye and Cursed Eye are two of the 12 eyes you need."
		"&cCataclysm&r: the Ignis and the Netherite Monstrosity wait in their own lairs."
		"&cThe Pokémon World&r: the &cFire Gym&r is down here in the Nether."
	]
	chapter.20C8627B6ED3DAEC.title: "The Nether"
	chapter.20C8627B6ED3DAEC.chapter_subtitle: ["Fire, fortresses and netherite"]
	quest.6568C54DDE0B8CAD.title: "What is the Twilight Forest?"
	quest.6568C54DDE0B8CAD.quest_desc: [
		"A dimension where it's always dusk: giant trees, glowing mushrooms, fireflies, deer,"
		"squirrels and penguins. Also hedge mazes, hollow hills and towers."
		""
		"It's built like an adventure: each boss you beat lifts a curse on the next area."
		"Cursed areas hurt you (blindness, hunger, fire, cold) until you've earned them."
		""
		"Being a different dimension, mobs here are a bit tougher than at home."
	]
	task.3448A2C896343FDC.title: "Enter the Twilight Forest"
	quest.557FE8BF3C1D5555.title: "Open the Portal"
	quest.557FE8BF3C1D5555.quest_desc: [
		"Dig a &e2x2 hole&r one block deep in grass or dirt and fill it with water."
		"Ring the pool with &aflowers, grass or mushrooms&r on every side."
		"Then stand back and &ethrow a diamond&r into the water."
		""
		"Lightning strikes and the pool turns into a portal. Hop in!"
	]
	quest.2DE737E1B9060598.title: "Magic Maps"
	quest.2DE737E1B9060598.quest_desc: [
		"Ravens drop feathers, torchberries hang in caves. Combine a &eraven feather&r,"
		"&etorchberries&r and &eglowstone dust&r into a Magic Map Focus,"
		"then surround it with paper to make a &eBlank Magic Map&r."
		""
		"Use it to draw a magic map: it shows biomes and every boss structure nearby."
	]
	quest.17E2A111A94414FD.title: "The Uncrafting Table"
	quest.17E2A111A94414FD.quest_desc: [
		"Later you'll find a &eMaze Map Focus&r in the Labyrinth. With a crafting table it makes"
		"an &eUncrafting Table&r, which takes items apart again (for XP)."
		"Great for recycling armor you've outgrown."
	]
	quest.7BA30D564B505571.title: "Twilight's Flavor & Delight"
	quest.7BA30D564B505571.quest_desc: [
		"&eTwilight's Flavor & Delight&r turns Twilight ingredients into Farmer's Delight dishes:"
		"torchberry cakes, fried hydra chop, ghast burgers and more."
		""
		"Pick up boss drops and odd meats: most of them cook into something."
	]
	quest.36F52317A1D9C50F.title: "The Naga"
	quest.36F52317A1D9C50F.quest_desc: [
		"A huge snake circles a stone courtyard in the forest. It charges in straight lines,"
		"so dodge sideways and hit its head."
		""
		"Drops &eNaga Scales&r (armor) and its trophy."
		"Beating it opens the shield around the &dLich Tower&r."
	]
	quest.1348640331859DA1.title: "The Twilight Lich"
	quest.1348640331859DA1.quest_desc: [
		"At the top of a tall tower lives the &dLich&r. He hides behind magic shields"
		"and copies of himself. Hit the real one!"
		""
		"He drops &eScepters&r (twilight, life draining, zombie, fortification)."
		"His defeat lifts the curses on the &aSwamp&r, &8Dark Forest&r and &bSnowy Forest&r."
	]
	quest.1920B192182D90D8.title: "The Minoshroom"
	quest.1920B192182D90D8.quest_desc: [
		"Under the swamp lies the &eLabyrinth&r, full of minotaurs and slimes."
		"At its heart: the &eMinoshroom&r, a mushroom-headed minotaur with a big axe."
		""
		"It drops &eMeef Stroganoff&r. The Labyrinth also hides the Maze Map Focus."
	]
	task.15D522365F1DF992.title: "Eat the Meef Stroganoff"
	quest.35F7DD78DFDC2E11.title: "Mighty Stroganoff"
	quest.35F7DD78DFDC2E11.quest_desc: [
		"Eat the &eMeef Stroganoff&r. It gets your body used to the heat of the &cFire Swamp&r,"
		"so the burning curse there stops hurting you."
	]
	quest.74CD96B4C53BC319.title: "The Hydra"
	quest.74CD96B4C53BC319.quest_desc: [
		"In the Fire Swamp, a three-headed &cHydra&r guards its lair. It breathes fire and"
		"lobs mortars. Hit the heads when they open their mouths."
		""
		"It drops &eFiery Blood&r (fiery armor and tools) and hydra chops."
	]
	task.74FEF0D8C9441E52.title: "Place a trophy on the pedestal"
	quest.77C877301F85AC7B.title: "Trophied Champion"
	quest.77C877301F85AC7B.quest_desc: [
		"In the &8Dark Forest&r, find the ruined stronghold entrance with a &eTrophy Pedestal&r."
		"Place any boss trophy on it to claim your title and open the way down."
	]
	task.3F04581C1B1866B1.title: "Defeat the 6 Knight Phantoms"
	quest.428F52EFCCA087EE.title: "The Knight Phantoms"
	quest.428F52EFCCA087EE.quest_desc: [
		"Deep in the Knight Stronghold, six ghostly knights rise from their tomb and attack together."
		"Bring friends."
		""
		"Beat them all and the carminite devices in the &4Dark Tower&r start working for you."
		"The stronghold also has &eKnightmetal&r for strong armor."
	]
	quest.206EACBBAE6DE114.title: "The Ur-Ghast"
	quest.206EACBBAE6DE114.quest_desc: [
		"At the top of the Dark Tower, kill the little ghasts around the &eGhast Trap&r"
		"and turn it on to pull the &4Ur-Ghast&r down from the sky."
		""
		"It drops &eFiery Tears&r, the other half of fiery gear."
	]
	quest.37D1207B5C11F047.title: "The Alpha Yeti"
	quest.37D1207B5C11F047.quest_desc: [
		"In the Snowy Forest, a cave holds the &bAlpha Yeti&r. It throws ice and slams the ground."
		""
		"Its &eAlpha Yeti Fur&r makes &bArctic armor&r, which keeps out the Glacier's cold."
	]
	quest.732DA10645ADBFB1.title: "The Snow Queen"
	quest.732DA10645ADBFB1.quest_desc: [
		"On the Glacier stands the &bAurora Palace&r. At its top waits the &bSnow Queen&r."
		"Wear your Arctic armor and stay warm."
		""
		"Clearing her skies is one of the three steps to the Highlands."
	]
	quest.5139BEE3226C0662.title: "Trophy Hunter"
	quest.5139BEE3226C0662.quest_desc: [
		"Every boss drops a &etrophy&r: a little head to hang on your wall."
		"Collect all eight and show them off at your base!"
		""
		"With the Hydra, Ur-Ghast and Snow Queen gone, the acid rain over the &aHighlands&r clears."
		"The Highlands (troll caves, giants in the clouds) are still being finished by the mod's"
		"makers, so this is the end of the main story."
	]
	quest.07E071AECCF81CF9.title: "Where Next?"
	quest.07E071AECCF81CF9.quest_desc: [
		"Twilight loot is great for the rest of the pack:"
		""
		"&bThe Aether&r: another magic dimension, but up in the sky."
		"&5Deeper and Darker&r: the Warden's world under the deep dark."
		"&cBosses & Combat&r: Cataclysm's bosses, for when you're well geared."
	]
	chapter.3493492EEC039526.title: "The Twilight Forest"
	chapter.3493492EEC039526.chapter_subtitle: ["A magic forest and a chain of bosses"]
	quest.6DCE6EA8D0644AE4.title: "What is the Aether?"
	quest.6DCE6EA8D0644AE4.quest_desc: [
		"The Aether is a world of &bfloating islands&r high above the clouds: blue grass,"
		"golden trees, fluffy sheep and flying pigs. It's the opposite of the Nether."
		""
		"Strata is about flying, and the Aether is the sky dimension: islands, clouds and"
		"dungeons in the air. Don't fall off the edge!"
		""
		"It has its own wood, stone, ores and three dungeons with bosses."
	]
	task.6131A03B6A81D2C3.title: "Enter the Aether"
	quest.0464F36CC958AD76.title: "The Glowstone Portal"
	quest.0464F36CC958AD76.quest_desc: [
		"Build a portal frame like a Nether portal, but out of &eGlowstone&r blocks."
		"Then pour a &ebucket of water&r into it to light it."
		""
		"Glowstone comes from the Nether ceiling (or from witches)."
		"Bring a water bucket and some blocks: you'll arrive high in the sky."
	]
	quest.2426EC39340EBB3C.title: "Skyroot and Holystone"
	quest.2426EC39340EBB3C.quest_desc: [
		"Aether wood is &eSkyroot&r and its stone is &eHolystone&r."
		"Build tools from them: &eSkyroot tools&r double the drops of Holystone and Ambrosium."
		""
		"&eAmbrosium Shards&r are the Aether's coal. Eat one in a pinch for a little health."
	]
	quest.50FD96A52903969E.title: "Zanite"
	quest.50FD96A52903969E.quest_desc: [
		"Mine &eZanite Ore&r with a Holystone pickaxe or better."
		"Zanite tools are like iron, with a twist: they get &efaster&r as they wear down."
	]
	quest.5F827D32D65345F6.title: "The Altar"
	quest.5F827D32D65345F6.quest_desc: [
		"The &eAltar&r enchants and repairs things using Ambrosium as fuel."
		"The &eFreezer&r (powered by Icestone) freezes items, like water buckets into ice."
		"The &eIncubator&r hatches Moa eggs (powered by Ambrosium Torches)."
	]
	quest.62AA5506A726F646.title: "Enchanted Gravitite"
	quest.62AA5506A726F646.quest_desc: [
		"&eGravitite Ore&r is the rarest Aether ore, and it floats up when nothing is above it."
		"Put it in the Altar to make &eEnchanted Gravitite&r for the Aether's best tools and armor."
		""
		"A Gravitite pickaxe can lift stone blocks into the air with a right-click."
	]
	quest.160AA71586F06BBE.title: "Raise a Moa"
	quest.160AA71586F06BBE.quest_desc: [
		"&eMoas&r are big friendly birds. Find a &eMoa Egg&r (Silver Dungeon chests have them),"
		"put it in an &eIncubator&r with Ambrosium Torches and wait for it to hatch."
		""
		"Ride your moa: it can jump in mid-air a few times. Blue moas get 3 jumps,"
		"rare black moas get 8. Great for hopping between islands!"
	]
	quest.57B5911C854BDCDE.title: "Aether's Delight"
	quest.57B5911C854BDCDE.quest_desc: [
		"&eAether's Delight&r adds Aether cooking: blue berry muffins, ginger soup, moa stew,"
		"gingerbread cookies and a Holystone stove."
	]
	quest.78ECE67309234E5A.title: "The Deep Aether"
	quest.78ECE67309234E5A.quest_desc: [
		"&eDeep Aether&r adds new biomes to the sky: glowing aerglow forests, golden heights,"
		"lavender fields and the yagroot swamp, with new animals like the &equail&r."
		""
		"It also adds &eSkyjade&r, a gem even sharper than diamond (but fragile),"
		"and a fourth dungeon, made of brass."
	]
	quest.544C88834C4F90AE.title: "Skyjade"
	quest.544C88834C4F90AE.quest_desc: [
		"Find and mine &eSkyjade&r in the Deep Aether."
		"Skyjade tools are very strong but get slower as they wear out. Repair them often."
	]
	task.263ECA158D192C14.title: "Find an Olympic Citadel"
	quest.103A9A7F4DC15EEF.title: "Olympic Citadel"
	quest.103A9A7F4DC15EEF.quest_desc: [
		"&eAether Villages&r builds grand white citadels on the Skyroot islands."
		"A nice place to visit, trade and catch your breath."
	]
	task.66DA08873F6F9EB7.title: "Find a Sky Dungeon"
	quest.1CDB44EEF1345DD7.title: "Inventory Pets' Sky Dungeon"
	quest.1CDB44EEF1345DD7.quest_desc: [
		"Rare &eSky Dungeons&r from Inventory Pets float in the Aether too."
		"Their chests have special loot that only exists in one place: no copies for friends here,"
		"so share what you find!"
	]
	quest.021FF8AB6E8D1AC8.title: "Bronze Dungeon: The Slider"
	quest.021FF8AB6E8D1AC8.quest_desc: [
		"Bronze dungeons hide inside islands. The boss is the &eSlider&r, a huge stone block"
		"that slides at you. Only a &epickaxe&r can hurt it."
		""
		"It drops a &eBronze Key&r to open the treasure chest. The treasure can include the"
		"&eValkyrie Lance&r and the Hammer of Kingbdogz."
	]
	task.104E62B22C9FB9B7.title: "Collect 10 Victory Medals"
	quest.4D7966E2F30B257B.title: "Silver Dungeon: The Valkyrie Queen"
	quest.4D7966E2F30B257B.quest_desc: [
		"Silver dungeons sit in the clouds, guarded by &eValkyries&r."
		"Each defeated Valkyrie drops a &eVictory Medal&r. Bring &e10&r to prove to the"
		"&bValkyrie Queen&r that you're worthy, then fight her."
		""
		"Her &eSilver Key&r opens the treasure: Valkyrie gear, golden feathers and"
		"regeneration stones."
	]
	quest.6574D89E8BDD67FE.title: "Gold Dungeon: The Sun Spirit"
	quest.6574D89E8BDD67FE.quest_desc: [
		"The final Aether dungeon lies in a big island of hellfire stone."
		"The &6Sun Spirit&r burns everything near it. Watch for its &bice crystals&r:"
		"when the Spirit is frozen, that's your moment to hit it."
		""
		"It drops a &eGold Key&r and a &eSun Altar&r (it controls the time of day)."
		"The treasure room has &cPhoenix armor&r and &dLife Shards&r (an extra heart each)."
	]
	task.6BAC46E808405ACD.title: "Find the Brass Dungeon"
	quest.5D36D6EFBB2EBAE6.title: "Brass Dungeon: Eye of the Storm"
	quest.5D36D6EFBB2EBAE6.quest_desc: [
		"Deep Aether's &eBrass Dungeon&r holds the &bEye of the Storm&r, a boss made of wind."
		"\"What a wind. Maybe I should try to hit that?\""
		""
		"Deep Aether's storm weapons and heavy Stormforged armor come from this part of the sky."
	]
	quest.588EF2883FBE4327.title: "Treasure Reforging"
	quest.588EF2883FBE4327.quest_desc: [
		"&eAether Treasure Reforging&r lets you make more dungeon gear."
		"The bronze, silver and gold treasure chests can hold &eupgrade smithing templates&r:"
		"Neptune (on Zanite armor), Valkyrie (on Gravitite gear) and Phoenix (on Gravitite armor)."
		""
		"Smelt old dungeon gear down for its metal (Neptune Mesh, Valkyrum, Pyral) and reforge it."
	]
	quest.2F114C29562460FA.title: "Where Next?"
	quest.2F114C29562460FA.quest_desc: [
		"You've conquered the sky dimension. More to see:"
		""
		"&aThe Twilight Forest&r: a magic forest with eight bosses."
		"&5The End&r: the stronghold portal and the Ender Dragon."
		"&bAd Astra&r: if the sky isn't high enough, go to space."
	]
	chapter.2F776931D0304949.title: "The Aether"
	chapter.2F776931D0304949.chapter_subtitle: ["Islands in the sky"]
	quest.5B1615E5D8A7F441.title: "What is Deeper and Darker?"
	quest.5B1615E5D8A7F441.quest_desc: [
		"Far below the surface, in the &8Deep Dark&r, sculk spreads over everything."
		"&eDeeper and Darker&r goes further: beat the &3Warden&r and you can open a portal to"
		"the &3Otherside&r, a whole dimension of sculk."
		""
		"&cThis is one of the most dangerous places in Strata.&r Go when you're well geared,"
		"and preferably with friends."
	]
	quest.7322942805F8EE93.title: "Quiet Please"
	quest.7322942805F8EE93.quest_desc: [
		"Sculk &eSensors&r hear footsteps, block breaking and thrown items."
		"Sculk &eShriekers&r call the Warden if they're set off too often."
		""
		"&eSneak&r to walk silently. Wool and carpet soak up vibrations, so they're quiet to walk on."
		"Darkness is part of the place: bring night vision if you can."
	]
	task.0B875E2BCDF8049D.title: "Find an Ancient City"
	quest.147A5BB5467358D6.title: "An Ancient City"
	quest.147A5BB5467358D6.quest_desc: [
		"Ancient Cities sit deep under the mountains, near Y -50. They're huge, dark and silent."
		""
		"Their chests are some of the best in the game: &eSwift Sneak&r books, echo shards,"
		"smithing templates, and even a &dBell Fragment&r for the Pokémon World portal."
		"In the middle stands a giant frame of &8reinforced deepslate&r. Remember it."
	]
	quest.34BA13852FDF2036.title: "Echo Shards"
	quest.34BA13852FDF2036.quest_desc: [
		"Echo shards are found in ancient city chests. Eight of them and a compass make a"
		"&eRecovery Compass&r, which points to where you last died."
		""
		"You'll need them for Warden gear too."
	]
	quest.596A3EF554F0BB87.title: "The Warden"
	quest.596A3EF554F0BB87.quest_desc: [
		"The &3Warden&r is blind, smells you and hears every move. Its sonic boom goes through"
		"shields and walls. Most players should run, not fight!"
		""
		"If you do fight: bring the best armor you have, strength potions and friends."
		"Deeper and Darker gives it a &eHeart of the Deep&r and &eWarden Carapace&r to drop."
	]
	task.6CAC8DDFE8BD2ACE.title: "Enter the Otherside"
	quest.68AD927AA20DDC90.title: "The Otherside"
	quest.68AD927AA20DDC90.quest_desc: [
		"Use the &eHeart of the Deep&r on the big reinforced deepslate frame in an ancient city."
		"It fills with a dark portal to the &3Otherside&r."
		""
		"The Otherside has no sun, little light and lots of sculk monsters."
		"Mark the portal with a waypoint so you can find your way home."
	]
	quest.317F865E2C90C6D9.title: "Ancient Compass"
	quest.317F865E2C90C6D9.quest_desc: [
		"Four pieces of &eWarden Carapace&r around a compass make an &eAncient Compass&r."
		"In the Otherside it points to the nearest &eAncient Temple&r."
	]
	task.70B55326BC0767B5.title: "Explore an Ancient Temple"
	quest.5B5FCB387C5F888A.title: "The Ancient Temple"
	quest.5B5FCB387C5F888A.quest_desc: [
		"The Otherside's great temples hold its best treasure (and its guards)."
		"Search the basement, the fountain and the top of the temple."
	]
	quest.4A2ED582E7618F98.title: "Otherside Wildlife"
	quest.4A2ED582E7618F98.quest_desc: [
		"Otherside mobs drop the materials you need here:"
		"&eShattered&r drop sculk bones, &eSludges&r drop resonarium,"
		"leeches and snappers drop soul dust."
		""
		"Watch out for &cStalkers&r. Their name says it all."
	]
	quest.45842CBD2D6F59FF.title: "Resonarium Gear"
	quest.45842CBD2D6F59FF.quest_desc: [
		"Craft a &eResonarium Plate&r. With a &eResonarium Upgrade&r template (ancient city and"
		"stronghold chests) it upgrades &firon&r gear in a smithing table."
	]
	quest.4D6FB83C064B1867.title: "Reinforced Echo Shard"
	quest.4D6FB83C064B1867.quest_desc: [
		"An echo shard wrapped in Warden Carapace and phantom membranes."
		"This is the upgrade material for &3Warden&r gear."
	]
	quest.4B7FC04235C1FE9D.title: "Warden Armor"
	quest.4B7FC04235C1FE9D.quest_desc: [
		"Find a &eWarden Upgrade&r smithing template in ancient city chests, then upgrade a"
		"&enetherite&r chestplate with a Reinforced Echo Shard. Warden gear is better than netherite."
		""
		"Copy the template with diamonds and sculk so you can do the whole set."
	]
	quest.58246A8971342DEA.title: "Sonorous Staff"
	quest.58246A8971342DEA.quest_desc: [
		"Soul crystals, sculk bones and a Heart of the Deep make a &eSonorous Staff&r:"
		"your own sonic boom, just like the Warden's."
	]
	quest.7BAE4D1A5CB23E0B.title: "Where Next?"
	quest.7BAE4D1A5CB23E0B.quest_desc: [
		"You've seen the darkest place in the pack. Other big trips:"
		""
		"&5The End&r: Warden gear is a great way to face the Ender Dragon."
		"&cThe Pokémon World&r: ancient city chests are a good place to find a Bell Fragment."
		"&cBosses & Combat&r: Cataclysm's bosses."
	]
	chapter.67DA74D25631D972.title: "Deeper and Darker"
	chapter.67DA74D25631D972.chapter_subtitle: ["The Warden, its city and the Otherside"]
	quest.76D3D703D11C85A6.title: "What is Ad Astra?"
	quest.76D3D703D11C85A6.quest_desc: [
		"&eAd Astra&r lets you build rockets and fly to the &7Moon&r, &cMars&r, &6Venus&r,"
		"&eMercury&r and finally &bGlacio&r in another solar system."
		""
		"Space has no air: you need a &espace suit&r full of oxygen, and every launch burns &efuel&r."
		"Each planet has a new metal that builds the next rocket."
		""
		"Open the &eAstrodux&r guide book for the full details."
	]
	quest.3793C5BA92EA556D.title: "Etrionic Blast Furnace"
	quest.3793C5BA92EA556D.quest_desc: [
		"Ad Astra machines run on power (FE). The &eCoal Generator&r is the simplest start,"
		"but any generator from the Tech chapters works."
		""
		"The &eEtrionic Blast Furnace&r smelts four things at once and alloys iron and coal into"
		"&esteel&r. Steel from other mods (Immersive Engineering, Mekanism) is the same steel here."
	]
	quest.5A1B12F441AC3BE0.title: "Plates"
	quest.5A1B12F441AC3BE0.quest_desc: [
		"The &eCompressor&r squeezes ingots into &eplates&r. Rockets are mostly steel plates."
	]
	quest.2E4229AD54F3AAC4.title: "NASA Workbench"
	quest.2E4229AD54F3AAC4.quest_desc: [
		"Rockets are too big for a crafting table. The &eNASA Workbench&r builds them from parts:"
		"a nose cone, plates, fins, tanks and an engine."
	]
	quest.157126301037ED5D.title: "Air to Breathe"
	quest.157126301037ED5D.quest_desc: [
		"The &eOxygen Loader&r turns water into oxygen (it needs power)."
		"Fill your space suit and some &eGas Tanks&r with it before every trip."
	]
	quest.1CD48F538F919321.title: "Space Suit"
	quest.1CD48F538F919321.quest_desc: [
		"Wear the whole &eSpace Suit&r and fill it with oxygen. Without it you'll suffocate"
		"and freeze on the Moon."
		""
		"The &eTI-69&r shows the oxygen, temperature and gravity where you stand."
	]
	quest.70E7FEBA5A04F756.title: "Rocket Fuel"
	quest.70E7FEBA5A04F756.quest_desc: [
		"&eOil&r spouts up out of the ocean in some places (look for oil wells)."
		"The &eFuel Refinery&r turns oil into &eFuel&r."
		""
		"A launch takes about &e3 buckets&r of fuel. Always carry another 3 for the trip home!"
	]
	quest.0553F9DF55E24AF6.title: "Tier 1 Rocket"
	quest.0553F9DF55E24AF6.quest_desc: [
		"Build a &eTier 1 Rocket&r in the NASA Workbench and a &eLaunch Pad&r to put it on."
		"Fuel it up (sneak + right-click the rocket to open its inventory)."
		""
		"Before you launch, pack a &espare launch pad&r, fuel for the return, oxygen tanks,"
		"food and soul torches (normal torches go out on the Moon)."
	]
	task.0B660BE96B2C2602.title: "Land on the Moon"
	quest.6BEA6C13D3E01829.title: "One Small Step"
	quest.6BEA6C13D3E01829.quest_desc: [
		"Climb in and press &ejump&r to launch. Pick the Moon on the planet screen."
		""
		"You land in a lander. Don't lose it: your rocket is inside!"
		"The Moon is cold and airless: water freezes and plants die without an"
		"&eOxygen Distributor&r in a sealed room."
	]
	quest.542BE739851703C4.title: "Desh"
	quest.542BE739851703C4.quest_desc: [
		"&eDesh&r ore is found under the Moon's surface. Desh builds better machines,"
		"space stations and the &eTier 2 Rocket&r."
		""
		"Look for the &eLunarians&r: moon villagers living underground. They trade useful"
		"space gear for emeralds."
	]
	quest.2F1C9DB9A70C6322.title: "Is It Made of Cheese?"
	quest.2F1C9DB9A70C6322.quest_desc: [
		"Yes! There's &echeese ore&r on the Moon. Mine it and smelt it."
	]
	quest.221BC9E07FBAE811.title: "Moon Rover"
	quest.221BC9E07FBAE811.quest_desc: [
		"The &eRover&r drives fast over rough ground, seats two and has a radio."
		"It runs on fuel."
	]
	quest.252F73DA968F6C69.title: "Space Station"
	quest.252F73DA968F6C69.quest_desc: [
		"From the planet screen you can build a &eSpace Station&r in orbit if you have the"
		"materials. It's a starter platform you can expand into a base among the stars."
		"In orbit there's no gravity: you float around, so build carefully."
	]
	task.7B970239FCA2B6FA.title: "Land on Mars"
	quest.249652D8D12B707E.title: "Tier 2 Rocket: Mars"
	quest.249652D8D12B707E.quest_desc: [
		"The &eTier 2 Rocket&r is built from Desh parts and reaches &cMars&r."
		"Strata gates this rocket behind &cIgnis&r (Cataclysm): beat it first."
		""
		"On Mars, mine &eOstrum&r for even better gear."
	]
	quest.3F161A0825F51B58.title: "Netherite Space Suit"
	quest.3F161A0825F51B58.quest_desc: [
		"Venus and Mercury are &cburning hot&r. The &eNetherite Space Suit&r gives permanent"
		"fire resistance and more protection. You'll die fast without it there."
	]
	task.07E9F5CDCD0493CE.title: "Land on Venus"
	task.0C842F68E6C0404B.title: "Land on Mercury"
	quest.47E822A37E43BAAB.title: "Tier 3 Rocket: Venus and Mercury"
	quest.47E822A37E43BAAB.quest_desc: [
		"Ostrum parts build the &eTier 3 Rocket&r, which can stand the heat of &6Venus&r"
		"and &eMercury&r. Gated behind the &cNetherite Monstrosity&r (Cataclysm)."
		""
		"Venus has &eCalorite&r, the last rocket metal. Mercury's sun makes solar panels shine."
	]
	task.7B6499AF1162D97F.title: "Land on Glacio"
	quest.0E02A4FB5EAD2C6C.title: "Tier 4 Rocket: Glacio"
	quest.0E02A4FB5EAD2C6C.quest_desc: [
		"The &eTier 4 Rocket&r, built from Calorite, leaves our solar system for"
		"&bProxima Centauri&r. Gated behind the &5Ender Guardian&r (Cataclysm)."
		""
		"&bGlacio&r is freezing cold, but it has air: you can take your helmet off."
	]
	quest.2388657740BB05D7.title: "The Jet Suit"
	quest.2388657740BB05D7.quest_desc: [
		"The very best Ad Astra armor is the &eJet Suit&r: more protection, more oxygen and"
		"&bflight&r. Flight burns the suit's stored &epower&r, so recharge it in an Energizer."
		"It's one of the most expensive things in the pack, a true late-game reward."
	]
	quest.34BEB6E711D5EA04.title: "Where Next?"
	quest.34BEB6E711D5EA04.quest_desc: [
		"Space is a long road with boss gates on the way:"
		""
		"&cBosses & Combat&r: Ignis, the Netherite Monstrosity and the Ender Guardian (Cataclysm)"
		"unlock the bigger rockets."
		"&bTech&r: better generators make space machines easier to run."
	]
	chapter.0C1846FAB1F67B50.title: "Ad Astra"
	chapter.0C1846FAB1F67B50.chapter_subtitle: ["Rockets, space suits and other planets"]
	quest.715AC9DE038B7686.title: "What is the End?"
	quest.715AC9DE038B7686.quest_desc: [
		"The End is a dark dimension of floating end-stone islands, home of the &5Ender Dragon&r."
		""
		"Getting there is a real quest in Strata. The portal is deep inside a giant"
		"&eIntegrated Stronghold&r, and it needs &e12 different magic eyes&r from"
		"&eEnd Remastered&r, gathered from all over the world."
		""
		"This chapter tells you where every eye comes from."
	]
	quest.236EBDDB0F644A14.title: "Not Your Usual Eyes"
	quest.236EBDDB0F644A14.quest_desc: [
		"&cVanilla Eyes of Ender don't work here.&r They can't open the portal and won't fly"
		"toward the stronghold when thrown."
		""
		"Instead there are &e16 different End Remastered eyes&r. You need &e12 different ones&r:"
		"one for each of the 12 frames around the portal."
		"The quests below show where to find them. Collect as a team!"
	]
	quest.03517C30EA185420.title: "Eyes of the Old World"
	quest.03517C30EA185420.quest_desc: [
		"&eOld Eye&r: desert temple chests and dungeon chests."
		"&eRogue Eye&r: jungle temple chests."
		"&eLost Eye&r: mineshaft chests and dungeon chests."
		""
		"YUNG's desert temples, jungle temples and dungeons count."
	]
	quest.134273CA31BAD4C9.title: "Eyes of Sea and Snow"
	quest.134273CA31BAD4C9.quest_desc: [
		"&eBlack Eye&r: buried treasure and shipwreck treasure chests (treasure maps help!)."
		"&eCold Eye&r: igloo chests (check for the hidden basement)."
		"&eCorrupted Eye&r: pillager outpost chests."
	]
	quest.02A8D9A58EC477C7.title: "Eyes of the Nether"
	quest.02A8D9A58EC477C7.quest_desc: [
		"&eNether Eye&r: Nether fortress chests."
		"&eCursed Eye&r: the treasure room of a bastion remnant."
		""
		"See the &cThe Nether&r chapter for both places."
	]
	quest.4F2ED499D2E5CCC6.title: "Eyes of the Mighty"
	quest.4F2ED499D2E5CCC6.quest_desc: [
		"&eMagical Eye&r: dropped by &eEvokers&r (woodland mansions and raids), and found in"
		"woodland mansion chests."
		"&eGuardian Eye&r: dropped by the &eElder Guardian&r in ocean monuments."
		"&eWither Eye&r: dropped by &5the Wither&r."
	]
	quest.6FBD8A0F9924EBA9.title: "Eyes You Make"
	quest.6FBD8A0F9924EBA9.quest_desc: [
		"&eWitch Eye&r: an Eye of Ender plus a &eWitch Pupil&r (witches drop them)."
		"&eUndead Eye&r: an &eUndead Soul&r (from skeleton horses) with a phantom membrane,"
		"bone, rotten flesh and ghast tear."
		"&eExotic Eye&r: an Eye of Ender with two &econduits&r, two glow ink sacs and four corals."
		""
		"So vanilla eyes are still useful as an ingredient! Press &eR&r on an eye for its recipe."
	]
	quest.6D264E5C108F4DE9.title: "Strange Eyes"
	quest.6D264E5C108F4DE9.quest_desc: [
		"&eEvil Eye&r: some &eCleric&r villagers sell one (emeralds and a rabbit's foot)."
		"&eCryptic Eye&r: very rarely appears in your inventory when you &eenchant&r"
		"something at an enchanting table. Keep enchanting!"
	]
	task.63C169EE7E205894.title: "Find the stronghold"
	quest.68F92998FAC6D0FA.title: "Integrated Stronghold"
	quest.68F92998FAC6D0FA.quest_desc: [
		"Since eyes don't fly, use the &eExplorer's Compass&r to find the stronghold."
		""
		"&eIntegrated Stronghold&r is &chuge&r: libraries, prisons, halls and"
		"Create-powered puzzles and traps. Bring lots of torches, food and friends,"
		"and set waypoints as you go so you can find the way out."
	]
	task.29FD8ECFE606127D.title: "Enter the End"
	quest.2E741F46B79C4891.title: "Twelve Eyes"
	quest.2E741F46B79C4891.quest_desc: [
		"Deep inside, the portal room has a ring of &e12 Ancient Portal Frames&r."
		"Put a &edifferent&r End Remastered eye in each frame. When all 12 are in, the portal opens."
		""
		"&cThere's no easy way back&r until you beat the dragon (or die). Bring a bed? No!"
		"Beds explode in the End. Bring blocks, a bow, potions and a pumpkin"
		"to wear so endermen leave you alone."
	]
	quest.5E75F524FF7A94CC.title: "The Ender Dragon"
	quest.5E75F524FF7A94CC.quest_desc: [
		"The dragon heals from the &dEnd Crystals&r on top of the obsidian towers."
		"Shoot or break the crystals first (some are in cages), then fight the dragon when it"
		"lands on the portal. &eYUNG's Better End Island&r makes the main island and its"
		"towers grander than usual."
		""
		"&cWhen the dragon dies, the whole server moves to Master difficulty.&r"
		"Regular mobs everywhere get much tougher. Bosses stay as they are."
		"Make sure your friends are ready before you strike the final blow!"
	]
	quest.145D0A13C975E69D.title: "Master Mode"
	quest.145D0A13C975E69D.quest_desc: [
		"You're in &cMaster&r difficulty now. Upgrade your gear, use Apotheosis gems and"
		"affixes, and keep your armor repaired."
		""
		"The dragon's defeat also opens the way to the late game: top-tier Draconic Evolution"
		"and Extended Crafting recipes need it (with a Cataclysm boss)."
	]
	task.24D6B1EB806B4CEE.title: "Visit the Crystal Peaks"
	quest.3AC1D988D35F91DA.title: "The Outer Islands"
	quest.3AC1D988D35F91DA.quest_desc: [
		"After the dragon dies, small &eEnd Gateways&r appear around the main island."
		"Throw an ender pearl into one to reach the outer islands."
		""
		"&eNullscape&r reshapes the outer End: tall crystal peaks, void barrens and dark"
		"shadowlands. Chorus fruit teleports you a short way when eaten."
	]
	quest.494C6E6B0082D282.title: "Moog's End Structures"
	quest.494C6E6B0082D282.quest_desc: [
		"The outer islands are dotted with &eMoog's End Structures&r: spires, towers, gardens,"
		"shrines and even crashed sky ships."
		""
		"The &bPokémon World&r's psychic and dragon gyms are out here in the End too!"
	]
	task.1BC1E9F50DBD777C.title: "Explore an End City"
	quest.6AB5B049A1AA7DAD.title: "End City"
	quest.6AB5B049A1AA7DAD.quest_desc: [
		"Tall purple towers full of &eshulkers&r. Their bullets make you float, so fight near"
		"the ground or keep milk handy."
		""
		"Some End Cities have an &eEnd Ship&r floating next to them. That's where the"
		"&eElytra&r is."
	]
	quest.13A2FAE22B655DE7.title: "Shulker Boxes"
	quest.13A2FAE22B655DE7.quest_desc: [
		"Shulkers drop &eShulker Shells&r. Two shells and a chest make a &eShulker Box&r:"
		"a chest that keeps its items when you break it."
	]
	quest.3EE901DAF546034E.title: "Elytra"
	quest.3EE901DAF546034E.quest_desc: [
		"The &eElytra&r lets you glide, and &efirework rockets&r boost you through the air."
		""
		"It &ccosts&r you: every flight wears down its durability, and every boost burns a rocket."
		"Repair it with &ephantom membranes&r at an anvil (or Mending)."
		"Gliding is a fast way to travel, but airships still carry your friends and cargo."
	]
	quest.39AFFA04EBA96910.title: "Where Next?"
	quest.39AFFA04EBA96910.quest_desc: [
		"The End is beaten, but the pack isn't:"
		""
		"&cBosses & Combat&r: the &5Ender Guardian&r (Cataclysm) unlocks cross-dimension wireless."
		"&bAd Astra&r: rockets to other planets."
		"&bTech&r: the late tiers of Mekanism, AE2 and Draconic Evolution."
	]
	chapter.75980EB7BF20EBD4.title: "The End"
	chapter.75980EB7BF20EBD4.chapter_subtitle: ["Twelve eyes, a huge stronghold and the Ender Dragon"]
	quest.1FF724B7E9C746A5.title: "What is the Pokémon World?"
	quest.1FF724B7E9C746A5.quest_desc: [
		"Somewhere beyond a bell's chime is a whole world just for &dPokémon&r (Cobblemon)."
		"It looks like a calm, classic Minecraft world, but wild Pokémon live everywhere:"
		"in the grass, the trees, the caves and the sea."
		""
		"Wild Pokémon only appear there. Once you've caught some, they can come with you"
		"anywhere, even home to your base."
		""
		"First, you need to build the way in. You already have a &eBell Fragment&r!"
	]
	quest.2E48E0C0B55D28BE.title: "The Johto Bell"
	quest.2E48E0C0B55D28BE.quest_desc: [
		"Craft the &eJohto Bell&r: a regular &eBell&r, &e3 gold ingots&r and your"
		"&eBell Fragment&r on top."
		""
		"Village bells can be picked up with a pickaxe (the villagers won't mind... much)."
		"The Johto Bell is &areusable&r: ringing the portal never uses it up."
	]
	quest.69741161528D082E.title: "Poké Portal Frames"
	quest.69741161528D082E.quest_desc: [
		"Craft red-and-white &ePoké Portal Frame&r blocks: red dye, redstone, iron,"
		"a diamond and white dye make &e8&r at a time."
		""
		"You need enough for a frame the shape of a Nether portal: at least 4 wide and 5 tall."
		"Leave the corners out if you're short."
	]
	task.6DFA391C7EBF3E69.title: "Enter the Pokémon World"
	quest.3B4607E3934952D7.title: "Ring the Bell"
	quest.3B4607E3934952D7.quest_desc: [
		"Build the frame (like a Nether portal, but with Poké Portal Frames) and use the"
		"&eJohto Bell&r on it. The portal fills with red light. Step in!"
		""
		"A matching portal is built on the other side, and it leads straight back to the"
		"Overworld at the same spot. Your Pokémon party HUD only shows inside the Pokémon World."
	]
	quest.2F0CDA013A2FEA45.title: "Choose Your Partner"
	quest.2F0CDA013A2FEA45.quest_desc: [
		"The first time you arrive, a screen opens to pick your &dstarter Pokémon&r."
		"Take your time: every region's starters are there. This is your partner for the journey!"
		""
		"Closed the screen by accident? It opens again the next time you log in there."
		"Your Pokémon's keys (send out, select) are in Options > Controls."
	]
	quest.6B03781B3AA78F5E.title: "Poké Balls"
	quest.6B03781B3AA78F5E.quest_desc: [
		"&eApricorn trees&r grow all over the Pokémon World. Red apricorns make &ePoké Balls&r"
		"(4 at a time); other colors make other balls. Press &eR&r on a ball to see its recipe."
		""
		"Grab some &eapricorn sprouts&r too, so you can grow your own trees at home."
	]
	task.3C54928C9B197FF5.title: "Catch your first Pokémon"
	quest.11DC4758842897C9.title: "Gotcha!"
	quest.11DC4758842897C9.quest_desc: [
		"Find a wild Pokémon and send out your partner to battle it."
		"When it's weak, throw a Poké Ball at it. Wiggle... wiggle... click!"
		""
		"Craft a &ePokédex&r (press &eR&r on it for the recipe) to keep track of every"
		"Pokémon you've seen and caught."
	]
	task.47AB49E3621AC8AC.title: "Have six Pokémon in your party"
	quest.4CC97184E9095F64.title: "A Full Team"
	quest.4CC97184E9095F64.quest_desc: [
		"Catch more until your party is full: &esix Pokémon&r."
		"Mix their types (water, fire, grass, flying...) so you're ready for any battle."
	]
	task.38368557F662FD73.title: "Heal at a Healing Machine"
	quest.40A37540F915F3D3.title: "The Pokécenter"
	quest.40A37540F915F3D3.quest_desc: [
		"Pokécenters stand in Pokémon World villages and on their own. Inside is a"
		"&eHealing Machine&r: put your team in and they're good as new."
		""
		"There's a &ePC&r too, to store the Pokémon that don't fit in your party."
		"You can craft your own PC (and later a Healing Machine) for your base."
	]
	task.58D00DEBFC5A2222.title: "Harvest an apricorn"
	quest.6BE35B7486F5DA5E.title: "Berry Patch"
	quest.6BE35B7486F5DA5E.quest_desc: [
		"Plant your apricorn sprouts and watch them grow into trees."
		"Berry bushes grow in the Pokémon World too: many heal or help in battle,"
		"and they look lovely in a garden."
	]
	task.54368B36DCD83447.title: "Evolve a Pokémon"
	quest.04BCDE00F47981CA.title: "Evolution!"
	quest.04BCDE00F47981CA.quest_desc: [
		"Most Pokémon evolve by levelling up in battle. Some need an &eevolution stone&r instead:"
		"Fire, Water, Thunder, Leaf, Moon, Sun and more."
		""
		"Evolution stone ores are found underground in the Pokémon World. Mine them,"
		"then use the stone on the Pokémon."
	]
	task.4D2E8FB9C6E23A42.title: "Ride a Pokémon"
	quest.4D2AAF75529F5102.title: "Ride Along"
	quest.4D2AAF75529F5102.quest_desc: [
		"Some Pokémon can carry you on their back: on land, through water, or into the sky."
		""
		"Riding is allowed in &aevery dimension&r. Flying Pokémon get tired: they use"
		"&estamina&r, so you'll need to land and rest now and then."
	]
	task.4E2A209716DD6C0D.title: "Use a Pasture Block"
	quest.5615546B3994586B.title: "Home Sweet Pasture"
	quest.5615546B3994586B.quest_desc: [
		"A &ePasture Block&r lets your Pokémon out of the PC to wander around your base."
		"Build them a cozy garden in the Overworld: they'll be happy to live with you."
	]
	quest.4B529064010D7F2C.title: "Trainer Card"
	quest.4B529064010D7F2C.quest_desc: [
		"&eRadical Cobblemon Trainers&r: trainers wander the Pokémon World. If one spots you,"
		"they'll want to battle!"
		""
		"Your Pokémon's &elevel cap&r starts at &e15&r and rises as you beat trainers."
		"Pokémon above the cap won't fight for you yet. The &eTrainer Card&r shows your progress."
	]
	quest.78845305DEC54DA8.title: "CobbleDollars"
	quest.78845305DEC54DA8.quest_desc: [
		"Winning battles against wild Pokémon and trainers earns &eCobbleDollars&r."
		"Your balance shows in the corner of the screen."
		""
		"Spend them with a &eCobble Merchant&r (a villager with that job) on Poké Balls,"
		"medicine and more. Merchants can also trade CobbleDollars and emeralds."
	]
	task.6FEC86EC4F3AEBCD.title: "Visit the Normal Gym"
	quest.2E8D916B5BF9FE11.title: "Your First Gym"
	quest.2E8D916B5BF9FE11.quest_desc: [
		"&eIntegrated Cobblemon&r gyms are scattered across the Pokémon World, one for each type."
		"Each gym has three trainers: &abeginner&r, &eintermediate&r and &chard&r."
		"Beat all three to complete that gym's badge series. Gym chests have goodies too."
		""
		"Use the Explorer's Compass to find them. Try the &eNormal Gym&r first."
	]
	task.382EAA141FFEDFAF.title: "Find the Fire Gym"
	quest.113954CADB2869F9.title: "The Fire Gym"
	quest.113954CADB2869F9.quest_desc: [
		"Not every gym is in the Pokémon World! The &cFire Gym&r is down in &cthe Nether&r."
		"Bring water-type Pokémon and fire resistance potions."
	]
	task.6B8FD491B0BA3E6F.title: "Find the Psychic Gym"
	task.0DF5888361BE1835.title: "Find the Dragon Gym"
	quest.27C06605AE913279.title: "Gyms Beyond the Stars"
	quest.27C06605AE913279.quest_desc: [
		"The &dPsychic&r and &5Dragon&r gyms are out in &5the End&r."
		"These are the toughest gyms of all. Good luck, Champion!"
	]
	quest.746C5DDD022E55BF.title: "Where Next?"
	quest.746C5DDD022E55BF.quest_desc: [
		"The Pokémon World is yours to explore at your own pace:"
		""
		"Look for &eruins, towers and habitats&r: some hold rare Pokémon."
		"Catch a flying partner and explore the &aOverworld&r from above."
		"&cThe Nether&r and &5The End&r chapters lead to the far-away gyms."
	]
	chapter.50AE8F5C17F0FC59.title: "The Pokémon World"
	chapter.50AE8F5C17F0FC59.chapter_subtitle: ["Build a portal, pick a partner, catch them all"]
	quest.2278F8B050E916A0.title: "What is Combat & Gear?"
	quest.2278F8B050E916A0.quest_desc: [
		"Fighting in Strata feels different from vanilla:"
		""
		"&eBetter Combat&r: every weapon type swings its own way, with combos and reach."
		"&eCombat Roll&r: a quick dodge-roll."
		"&eApotheosis&r: random loot with &6rarities&r, gems you socket into gear, and a much"
		"deeper enchanting table."
		""
		"This chapter walks you through all of it. Start anywhere."
	]
	quest.13DD672665736D9E.title: "Every Weapon Swings Differently"
	quest.13DD672665736D9E.quest_desc: [
		"With &eBetter Combat&r, hold attack and keep swinging: each weapon has a &ecombo&r of"
		"different swings (slash, stab, overhead), and its own &ereach&r (shown on the tooltip as"
		"Attack Range)."
		""
		"Swings hit everything in their arc, so a wide slash can clip several mobs at once."
		"Craft an &eIron Longsword&r (Simply Swords) and try a combo on a zombie."
	]
	quest.71CEDD8BC67481E6.title: "Big Swings"
	quest.71CEDD8BC67481E6.quest_desc: [
		"Some weapons are &eTwo-Handed&r (it says so on the tooltip): claymores, katanas,"
		"twinblades, greathammers. You can't use your off-hand with them, but they hit hard"
		"and reach far."
		""
		"One-handed weapons can be &edual-wielded&r: put a second one in your off-hand and your"
		"swings alternate between hands."
		""
		"&eFeint&r cancels a swing you started. Set its key in Options > Controls."
	]
	quest.50431CA20BCA5387.title: "Dodge Roll"
	quest.50431CA20BCA5387.quest_desc: [
		"&eCombat Roll&r: press the roll key (set it in Options > Controls) to dash a few blocks"
		"in the direction you're moving. An arrow on your HUD shows when it's ready again."
		""
		"&eThe rules here:&r a roll takes &e4 seconds&r to recharge, needs more than"
		"&e3 drumsticks&r of food, and costs a little hunger. It moves you out of the way,"
		"but you're &cnot invulnerable&r while rolling, so roll early."
		""
		"Enchantments help: &eAcrobat&r (chestplate, faster recharge), &eLongfooted&r (boots, longer"
		"rolls) and &eMulti-Roll&r (helmet, extra rolls)."
	]
	task.26EA7676479A5D22.title: "Find a Runic Tablet"
	quest.2696AA538E0852AC.title: "Simply Swords"
	quest.2696AA538E0852AC.quest_desc: [
		"&eSimply Swords&r adds 15 weapon types (chakram, glaive, halberd, rapier, scythe...)"
		"in iron, gold, diamond and netherite. Look them up with &eU&r on an iron ingot."
		""
		"Dungeon chests can hold &6unique&r named weapons with special powers, and &eRunic Tablets&r."
		"Bring a tablet back: it's the smithing template for runic weapons."
	]
	quest.2F8E58A5B4853E90.title: "Runic Weapons"
	quest.2F8E58A5B4853E90.quest_desc: [
		"In a &eSmithing Table&r: Runic Tablet + a &enetherite&r Simply Swords weapon + a diamond"
		"gives its &erunic&r version, which carries a rune power."
		""
		"Every weapon type works the same way. Pick the one whose combo you like best."
	]
	task.1B618FD9289D34E4.title: "Pick up an affix item"
	quest.31681F5877EA7BA0.title: "Gear With Colours"
	quest.31681F5877EA7BA0.quest_desc: [
		"&eApotheosis&r gear drops from mobs, sits in chests, and is sold by wandering traders."
		"Its name colour is its &erarity&r:"
		""
		"&7Common&r (grey): one bonus stat."
		"&aUncommon&r (green): two stats, maybe a socket."
		"&9Rare&r (blue): two stats plus a special effect, up to two sockets."
		"&5Epic&r (purple): three stats, an effect and an &eAbility&r, always a socket."
		"&6Mythic&r (orange): four stats, two effects, an Ability and extra bonuses."
		""
		"A beam of light shines up from good drops. Pick one up! Your stats (crit chance,"
		"life steal...) are on the small button at the &etop right&r of your inventory."
	]
	quest.54A475CB9A1ECB61.title: "Elites and Invaders"
	quest.54A475CB9A1ECB61.quest_desc: [
		"&6Apothic Elites&r are named, empowered versions of normal mobs. They're rare near spawn"
		"and more common far out and in other dimensions. They can drop affix gear."
		""
		"&cApothic Invaders&r arrive with a loud noise, a chat message and a beam of light."
		"They're mini-bosses that always drop a special affix item and often gems."
		"Invaders never appear while your World Tier is &eHaven&r."
	]
	task.43D2BB04031BA783.title: "Unlock Frontier"
	quest.3A399FBC4B396A71.title: "World Tiers (Ctrl+T)"
	quest.3A399FBC4B396A71.quest_desc: [
		"Press &eCtrl+T&r for the &eWorld Tier&r screen. Tiers are &eper player&r:"
		"&aHaven&r > &eFrontier&r > &6Ascent&r > &cSummit&r > &5Pinnacle&r."
		""
		"A higher tier makes mobs around &eyou&r tougher and loot better (it also raises the max"
		"enchanting level). Unlocking a tier doesn't switch it on: you choose when, and can"
		"switch back. Hover a tier's icon to see what unlocks it."
		""
		"&eFrontier&r unlocks when you wear four affix armor pieces and hold an affix weapon."
	]
	task.48FABDDBD6AFB9C4.title: "Unlock Ascent"
	quest.6507C945F91B273E.title: "World Tier: Ascent"
	quest.6507C945F91B273E.quest_desc: [
		"Wear a full set of &aUncommon&r affix armor, hold an Uncommon weapon, and defeat an"
		"&cApothic Invader&r."
		""
		"Only activate it when you're ready: Invaders and Elites get more common."
	]
	task.6A8C0D9280E92618.title: "Unlock Summit"
	quest.3560C883825FA029.title: "World Tier: Summit"
	quest.3560C883825FA029.quest_desc: [
		"A full set of &9Rare&r affix gear, and the &cWither&r defeated."
		""
		"The last tier, &5Pinnacle&r, needs a full set of &5Epic&r gear and the Ender Dragon"
		"defeated: the best loot and the toughest mobs."
	]
	quest.088A01960AF3EC4F.title: "Not a Diamond"
	quest.088A01960AF3EC4F.quest_desc: [
		"&eGems&r drop from mobs and bosses and sit in chests. Socket one into gear for a strong"
		"bonus (each gem says which items it fits)."
		""
		"&eSocketing:&r put the item and the gem in a &eSmithing Table&r, or just right-click the"
		"gem onto the item in your inventory. The item needs a free socket."
		""
		"Your first &eGem Dust&r: drop a spare gem on the ground and let an &eanvil&r fall on it."
	]
	quest.30C8A66DD260707C.title: "Salvaging Table"
	quest.30C8A66DD260707C.quest_desc: [
		"Breaks affix gear (and gems) you don't want into &erarity materials&r:"
		""
		"&7Mysterious Scrap Metal&r, &aTimeworn Fabric&r, &9Luminous Crystal Shard&r,"
		"&5Arcane Sands&r and &6Godforged Pearl&r, one per rarity."
		"Gems salvage into Gem Dust. Don't throw old gear away: salvage it."
	]
	quest.36668B3A3DBE6957.title: "Gem Cutting Table"
	quest.36668B3A3DBE6957.quest_desc: [
		"Gems have a &epurity&r: Cracked, Chipped, Flawed, Normal, Flawless and &6Perfect&r."
		""
		"To upgrade a gem: put in the gem, a &esecond copy of the same gem and purity&r,"
		"Gem Dust and rarity materials. Higher purities cost more. Press &eR&r on a gem"
		"to see the exact cost."
	]
	quest.00E16C8C02156C14.title: "More Sockets"
	quest.00E16C8C02156C14.quest_desc: [
		"A &eSigil of Socketing&r adds a socket to an item in the Smithing Table (up to two this way)."
		"It's made from Gem-Fused Slate (deepslate + gem dust)."
		""
		"Changed your mind? A &eSigil of Withdrawal&r pops all the gems back out, and you keep"
		"both the item and the gems."
	]
	quest.36564D3C2AC92CBE.title: "Reforging"
	quest.36564D3C2AC92CBE.quest_desc: [
		"Don't like your item's bonuses? &eReforge&r it. Put the item in the middle, rarity"
		"materials top-left and &eSigils of Rebirth&r bottom-right, then pick one of three"
		"new versions. It costs a few levels."
		""
		"The Simple Reforging Table goes up to &9Rare&r and works on plain gear too."
		"Upgrade it into a &eReforging Table&r (netherite + &5Arcane Sands&r) for Epic and Mythic."
	]
	quest.3973241512F9633F.title: "Augmenting Table"
	quest.3973241512F9633F.quest_desc: [
		"The end-game table: upgrade one affix by 25% or reroll just that one, keeping the rest."
		"Built from a &eNether Star&r and two &6Godforged Pearls&r; it runs on Sigils of"
		"Enhancement and a lot of levels. Worth it only for Mythic (maybe Epic) gear."
	]
	task.1433B0CA2379EDA9.title: "Enchant at level 30 or higher"
	quest.2D839A51326FFC56.title: "A Deeper Enchanting Table"
	quest.2D839A51326FFC56.quest_desc: [
		"&eApothic Enchanting&r gives the table three stats (hover a shelf to see what it adds):"
		""
		"&aEterna&r: the max level. Each vanilla bookshelf gives 2, so 15 reach level 30."
		"&cQuanta&r: randomness. More swing, up or down."
		"&dArcana&r: rarer enchantments and more of them."
		""
		"The table can go past 30, all the way to &e100&r. Click the &e?&r in the table's screen to"
		"see which enchantments you can roll. Candles add Arcana, skulls add Quanta."
	]
	quest.375B751CD8AEC5B7.title: "Hellshelves and Seashelves"
	quest.375B751CD8AEC5B7.quest_desc: [
		"To get past level 30 you need better shelves. &eHellshelves&r (nether bricks, blaze rod,"
		"a potion of regeneration) or &eSeashelves&r (from the ocean) push Eterna to 45."
		""
		"Then &einfuse&r them: put a shelf in the enchanting table with enough stats and the third"
		"slot does an &eInfusion&r instead of an enchantment. Press &eR&r on an infused shelf to"
		"see the stats it needs."
	]
	quest.5AE49F058171F140.title: "Infusion"
	quest.5AE49F058171F140.quest_desc: [
		"An &eInfused Hellshelf&r needs 45 Eterna and 30 Quanta at the table. Infused shelves"
		"upgrade into &eBlazing&r / &eGlowing&r Hellshelves (or Heart-Forged / Crystalline Seashelves)"
		"for level 60."
		""
		"After that: Deepshelves (deepslate, the Deep Dark, the Warden) for 80, and"
		"Endshelves (Dragon's Breath, a Dragon Head) for 100."
	]
	quest.59DC4B0E3A82433B.title: "Enchantment Library"
	quest.59DC4B0E3A82433B.quest_desc: [
		"Feed spare enchanted books into an &eEnchantment Library&r: it stores them all in one"
		"block, and you take out the enchantment you need as a book."
		"Put one in your base and give it every book you find."
	]
	quest.170B2FB928310F29.title: "Take the Spawner Home"
	quest.170B2FB928310F29.quest_desc: [
		"&eApothic Spawners&r: mine a dungeon spawner with a &eSilk Touch&r pickaxe to take it"
		"with you (it costs a big chunk of the pickaxe's durability)."
		""
		"Mobs also have a small chance to drop their spawn egg with the &eCapturing&r enchantment."
	]
	task.67F7FD71E00D73C1.title: "Modify a spawner"
	quest.0395007A13FEB220.title: "Tune a Spawner"
	quest.0395007A13FEB220.quest_desc: [
		"Right-click a spawner with an item to change it:"
		""
		"&eSugar&r / &eClock&r: spawns faster. &eFermented Spider Eye&r: more mobs per spawn."
		"&eGhast Tear&r: more mobs allowed nearby. &ePiston&r: bigger spawn area."
		"&eComparator&r: only runs on redstone. &eSoul Lantern&r: ignores light."
		""
		"Press &eU&r on the spawner to see every modifier. Hold Shift on the spawner's tooltip"
		"for its stats."
	]
	quest.7D3E8D1C834319D7.title: "Looking Good"
	quest.7D3E8D1C834319D7.quest_desc: [
		"&eCosmetic Armor Reworked&r: your inventory has a &eCosmeticArmor&r button that opens a"
		"second set of armor slots. Whatever you put there is what other players &esee&r; your"
		"real armor still protects you."
		""
		"Wear your best-stat gear and still look the way you want."
	]
	quest.0470C030A5886336.title: "Where Next?"
	quest.0470C030A5886336.quest_desc: [
		"Gear up, then go hunting:"
		""
		"&cL_Ender's Cataclysm&r: the big boss line, and the key to late-game tech."
		"&cIce and Fire&r: dragons, dragonsteel and other mythical beasts."
		"&cBoss Hunter&r: bosses from many mods, all over the world."
		""
		"&dIron's Spells&r has its own Apotheosis gems and affixes for spellcasters."
	]
	chapter.6B35C68669169B11.title: "Combat & Gear"
	chapter.6B35C68669169B11.chapter_subtitle: ["Weapons, dodging, Apotheosis loot, gems and enchanting"]
	quest.2842BDBFC2178FC0.title: "What is Cataclysm?"
	quest.2842BDBFC2178FC0.quest_desc: [
		"&cL_Ender's Cataclysm&r adds huge boss fights, each in its own lair:"
		"a forge in the Nether, an arena of fire, a pyramid, a factory, a sunken city, a frozen prison,"
		"a sky-high temple and a citadel in the End."
		""
		"&6Why it matters:&r killing these bosses is how Strata unlocks the late game."
		"Top Mekanism and AE2 tiers and &ecross-dimension wireless&r wait behind them."
		""
		"Bosses keep their designed strength. Bring good gear, food, and friends."
	]
	quest.0F9D5C15C1C8C87D.title: "Eyes That Point the Way"
	quest.0F9D5C15C1C8C87D.quest_desc: [
		"Each lair has its own &eEye&r. Throw it like an Eye of Ender and it flies toward the"
		"nearest lair of that kind. Press &eR&r on each to see the recipe:"
		""
		"&cMonstrous&r (Soul Forge), &6Flame&r (Burning Arena), &eDesert&r (Cursed Pyramid),"
		"&7Mech&r (Ancient Factory), &3Abyss&r (Sunken City), &bCurse&r (Frosted Prison),"
		"&9Storm&r (Acropolis), &5Void&r (Ruined Citadel)."
		""
		"Start with the &cEye of Monstrous&r."
	]
	quest.2748A0FA657B7536.title: "The Netherite Monstrosity"
	quest.2748A0FA657B7536.quest_desc: [
		"A giant war machine guarding the &cSoul Forge&r, a blackstone smithy in the Nether."
		""
		"It's slow but hits like a truck and throws lava. Keep moving, stay out of the lava,"
		"and never fight it in a corner."
		""
		"&6Drops:&r the &eInfernal Forge&r (a hammer-pickaxe), the &eMonstrous Horn&r and a Lava Power Cell."
		"&6Unlocks:&r late Mekanism and AE2 quest lines."
	]
	quest.123C7FF82BF34B0B.title: "Monstrous Helm"
	quest.123C7FF82BF34B0B.quest_desc: [
		"Smithing Table: Netherite Upgrade template + netherite helmet + &eMonstrous Horn&r."
		"When you drop below half health the helm knocks"
		"back everything nearby and gives you extra defence and regeneration."
	]
	quest.32A320D6DFBF28C2.title: "Burning Ashes"
	quest.32A320D6DFBF28C2.quest_desc: [
		"Ignis has to be called. You need &eBurning Ashes&r: craft them from 4 &eDying Embers&r,"
		"dropped by &eIgnited Berserkers&r in Nether fortresses. Ignited Revenants drop ashes directly."
		""
		"Then craft an &6Eye of Flame&r to find the &cBurning Arena&r in the Nether Wastes."
	]
	quest.087C51290A82D487.title: "Ignis, the Flame"
	quest.087C51290A82D487.quest_desc: [
		"Place the Burning Ashes on the &eAltar of Fire&r in the arena and Ignis rises: a burning"
		"knight who gets more dangerous as the fight goes on."
		""
		"Fire resistance helps, but it won't save you from everything."
		""
		"&6Drops:&r &eIgnitium Ingots&r (armor and weapons above netherite)."
		"&6Unlocks:&r late Mekanism and AE2 quest lines."
	]
	quest.79033A51F4E7B595.title: "Ignitium Gear"
	quest.79033A51F4E7B595.quest_desc: [
		"In a Smithing Table, the &eIgnitium Upgrade&r template + an Ignitium Ingot turns netherite"
		"armor into Ignitium. Each piece has a perk: lava walking, flame reflex, and a helmet that"
		"brands enemies you look at."
	]
	quest.2A7D25606C6D5EC5.title: "The Cursed Pyramid"
	quest.2A7D25606C6D5EC5.quest_desc: [
		"In the desert stands the &eCursed Pyramid&r (an &eEye of Desert&r finds it). Inside,"
		"use a &eBrush&r on the suspicious sand: one of the finds is the &eNecklace of the Desert&r."
		""
		"Watch for Koboletons: they steal your stuff."
	]
	quest.46A6A066322B15C9.title: "The Ancient Remnant"
	quest.46A6A066322B15C9.quest_desc: [
		"Use the Necklace inside the pyramid to wake the &eAncient Remnant&r, a huge skeletal"
		"beast that calls sandstorms."
		""
		"&6Drops:&r &eSandstorm in a Bottle&r, the &eRemnant's Skull&r (summons a tameable"
		"Modern Remnant) and Ancient Metal."
	]
	quest.4536D5D5D3BF9BE2.title: "The Harbinger"
	quest.4536D5D5D3BF9BE2.quest_desc: [
		"Deep underground lies the &7Ancient Factory&r (find it with an &eEye of Mech&r)."
		"The Harbinger sits dormant inside; it needs a &eNether Star&r to wake, so beat the"
		"Wither first."
		""
		"It fires missiles and lasers, so use cover."
		""
		"&6Drops:&r &eWitherite&r for the Wither Assault Shoulder Weapon, Laser Gatling and more."
	]
	quest.5B528F573625EF80.title: "Abyssal Sacrifice"
	quest.5B528F573625EF80.quest_desc: [
		"The &3Sunken City&r lies at the bottom of a deep ocean (use an &eEye of Abyss&r)."
		"Water breathing and night vision are a must."
		""
		"To call its boss you need an &eAbyssal Sacrifice&r. Its pieces: an &eAthame&r from"
		"Deepling Priests or Warlocks, &eCrystallized Coral&r (from Coral Golem fragments),"
		"a Heart of the Sea, a nautilus shell and blocks of diamond, emerald, iron, gold and amethyst."
	]
	quest.65395D14D670A02E.title: "The Leviathan"
	quest.65395D14D670A02E.quest_desc: [
		"Place the Sacrifice on the &eAltar of Abyss&r. The Leviathan is huge, fast underwater,"
		"and can't be hurt outside the water."
		""
		"&6Drops:&r &eTidal Claws&r (a grappling hook) and the &eAbyssal Egg&r."
	]
	quest.4DCA0ED080A8AD77.title: "Maledictus"
	quest.4DCA0ED080A8AD77.quest_desc: [
		"In snowy plains stands the &bFrosted Prison&r (use an &eEye of Curse&r). Fight through"
		"the Draugr; the &eAptrgangr&r drops the &eStrange Key&r that opens sealed doors."
		"Deep inside, wake Maledictus at the &eCursed Tombstone&r."
		""
		"&6Drops:&r &eCursium Ingots&r (another armor set above netherite)."
	]
	quest.1C8B59A2E6C633E6.title: "Scylla, the Storm Empress"
	quest.1C8B59A2E6C633E6.quest_desc: [
		"Over warm oceans stands the &9Acropolis&r (use an &eEye of Storm&r). Scylla fights"
		"with water and lightning."
		""
		"&6Drops:&r &eEssence of the Storm&r and &eLacrima&r, for the Ceraunus and Astrape weapons."
	]
	quest.56FA35177D30E54E.title: "The Ender Guardian"
	quest.56FA35177D30E54E.quest_desc: [
		"Out on the End's outer islands (past the Dragon's gateway) stands the &5Ruined Citadel&r."
		"An &eEye of Void&r points the way. Ender Golems guard it, and so does the Ender Guardian."
		""
		"&6Drops:&r the &eGauntlet of Guard&r (pulls enemies to you)."
		"&6Unlocks:&r &ecross-dimension wireless&r (the AE2 Quantum Network Bridge)."
	]
	task.377CBD57623E7E34.title: "Defeat every Cataclysm boss"
	quest.0B240502643A3717.title: "The Cataclysmfarer"
	quest.0B240502643A3717.quest_desc: [
		"Beat every Cataclysm boss. You've reached the summit of Cataclysm!"
	]
	quest.43FFDD96AFF89A7A.title: "Integrated Cataclysm"
	quest.43FFDD96AFF89A7A.quest_desc: [
		"In Strata the lairs are rebuilt with &eIntegrated Cataclysm&r: they use blocks from other"
		"mods, including working Create parts, and some Cataclysm gear is built with Create machines"
		"(for example the Harbinger's weapons on a &eMechanical Crafter&r)."
		""
		"If a recipe looks odd, press &eR&r on it: this pack's version is the one shown."
	]
	quest.164C47E492C368F7.title: "A Proper Entrance"
	quest.164C47E492C368F7.quest_desc: [
		"Two client-side extras: &eCinematic Cataclysm&r plays an intro cutscene for some bosses,"
		"and &eGTBC's Cataclysmic Boss UI&r shows a boss screen before the fight starts."
	]
	quest.40035D0AF4C12153.title: "Cataclysm Delight"
	quest.40035D0AF4C12153.quest_desc: [
		"&eL_Ender's Cataclysm Delight&r adds over 50 foods made from Cataclysm creatures:"
		"crab legs, lionfish rolls, even a Netherite Monstrosity sandwich. Cook them with"
		"Farmer's Delight tools. Press &eU&r on a Cataclysm mob drop to see what it makes."
	]
	quest.4E3F97934C0EDF13.title: "Cataclysm: Spellbooks"
	quest.4E3F97934C0EDF13.quest_desc: [
		"For spellcasters: &eCataclysm: Spellbooks&r links these bosses to &dIron's Spells&r."
		"Bosses drop &emanuscripts&r that teach their spells (Ignis's Burning Manuscript,"
		"the Monstrosity's Encoded Print...), and there are new spellbooks and mage armor sets."
		""
		"See the &dIron's Spells&r chapter for how spellcasting works."
	]
	quest.53DE2D46F18BDACB.title: "Where Next?"
	quest.53DE2D46F18BDACB.quest_desc: [
		"With bosses down, go claim what they unlocked:"
		""
		"&bMekanism&r and &bAE2&r: their late tiers open after the Netherite Monstrosity or Ignis."
		"Cross-dimension wireless opens after the Ender Guardian."
		"&cBoss Hunter&r: many more bosses from other mods."
		"&cIce and Fire&r: dragons."
	]
	chapter.1B43247ADAE7E6DC.title: "L_Ender's Cataclysm"
	chapter.1B43247ADAE7E6DC.chapter_subtitle: [
		"Eight great bosses, their lairs, and the late game they unlock"
	]
	quest.774FAD0489602A73.title: "What is Ice and Fire?"
	quest.774FAD0489602A73.quest_desc: [
		"&cIce and Fire&r fills the world with mythical creatures: &cfire&r, &bice&r and"
		"&elightning&r dragons, hydras, cyclopes, gorgons, sea serpents, sirens and more."
		""
		"Dragons are the big prize: their bones, blood and scales make the strongest gear here."
		"They are also &cvery&r dangerous, and they burn, freeze and smash terrain."
		"Don't build your base next to a roost."
	]
	quest.1714C91A438D9826.title: "The Bestiary"
	quest.1714C91A438D9826.quest_desc: [
		"&eManuscripts&r turn up in Ice and Fire lairs and chests. Three make a &eBestiary&r:"
		"a guide to every creature, how to fight it, and what it drops."
		""
		"More manuscripts unlock more pages: put the Bestiary and manuscripts into a"
		"&eBestiary Lectern&r."
	]
	quest.25601C7B14ACF5B8.title: "Here Be Dragons"
	quest.25601C7B14ACF5B8.quest_desc: [
		"Dragons grow through &e5 stages&r. Most dragons you meet are &estage 3&r, living in"
		"&eroosts&r on the surface: piles of gold, scorched or frozen ground, bones."
		""
		"Older stage 4 and 5 dragons sleep in big &ecaves&r underground with their treasure,"
		"and female dragons guard their eggs there. Those are much harder."
		""
		"&cFire&r: deserts, jungles, savannas, badlands, plains and meadows."
		"&bIce&r: snowy and frozen biomes. &eLightning&r: swamps, jungles, badlands, savannas."
		""
		"Bring fire or frost resistance, a bow, and lots of food."
	]
	quest.6AE895F520886A6B.title: "Slay a Fire Dragon"
	quest.6AE895F520886A6B.quest_desc: [
		"Fire dragons breathe a stream of flame and, from stage 3, throw fire charges."
		"Potions of fire resistance help. Watch for wind-ups: the tail slam and the breath"
		"both charge before they hit."
	]
	quest.0DF80C8C03B69484.title: "Slay an Ice Dragon"
	quest.0DF80C8C03B69484.quest_desc: [
		"Ice dragons breathe frost that can freeze you solid. Keep moving and keep your distance"
		"when they inhale."
	]
	quest.35EF84EEEA9E7EB2.title: "Slay a Lightning Dragon"
	quest.35EF84EEEA9E7EB2.quest_desc: [
		"Lightning dragons strike with lightning instead of flame. Fight them away from your base."
	]
	quest.61B493A71DB9E8E7.title: "Dragon Spoils"
	quest.61B493A71DB9E8E7.quest_desc: [
		"A dead dragon drops &eDragon Bones&r, &eScales&r, its &eBlood&r, &eFlesh&r, its &eHeart&r"
		"and its &eSkull&r. Keep everything:"
		""
		"&eBones&r: Dragon Bone tools and the bow, and the forge."
		"&eScales&r: dragon scale armor."
		"&eBlood&r: elemental Dragon Bone swords, and dragonsteel."
		"&eHeart&r: the heart of a dragon forge."
	]
	quest.213EBA33B63868E6.title: "Dragon Bone Sword"
	quest.213EBA33B63868E6.quest_desc: [
		"Craft a &eDragon Bone Sword&r, then add dragon blood to it (shapeless) for a"
		"&cFlamed&r, &bIced&r or &eLightning&r version with an elemental bite."
	]
	quest.6F232E64162EBB83.title: "The Dragon Forge"
	quest.6F232E64162EBB83.quest_desc: [
		"A &eDragon Forge&r turns iron into &6dragonsteel&r. You need, all of one element:"
		""
		"&e1 forge core&r (8 forge bricks around a dragon heart), &e1 aperture&r (bricks + iron),"
		"&e8 blocks of dragon bone&r and &e17 forge bricks&r (stone bricks + scale blocks)."
		"The Bestiary's Dragonforge pages show the 3-layer build."
		""
		"It runs on &edragon breath&r: put a tame dragon, or a wild one held with &eChain Lines&r"
		"on a Dragon Bone Wall, right in front of the aperture."
	]
	quest.61FFBA883D28907C.title: "Fire Dragonsteel"
	quest.61FFBA883D28907C.quest_desc: [
		"Iron ingot + &cFire Dragon Blood&r in a fire forge. Fire dragonsteel sets attackers"
		"aflame and knocks them far back."
	]
	quest.243B960C7FE840EC.title: "Ice Dragonsteel"
	quest.243B960C7FE840EC.quest_desc: [
		"Iron ingot + &bIce Dragon Blood&r in an ice forge. Ice dragonsteel freezes targets"
		"in a block of ice."
	]
	quest.2F38EB9A577587D3.title: "Lightning Dragonsteel"
	quest.2F38EB9A577587D3.quest_desc: [
		"Iron ingot + &eLightning Dragon Blood&r in a lightning forge."
		""
		"All dragonsteel armor also protects you well against dragon breath."
	]
	quest.05A0B109F643173B.title: "A Clutch of Eggs"
	quest.05A0B109F643173B.quest_desc: [
		"Female dragons in &ecaves&r guard their eggs. Beat the mother (a stage 4 or 5 dragon)"
		"and take one home."
		""
		"&cFire&r egg: place it on a fire that keeps burning (netherrack)."
		"&bIce&r egg: place it in water."
		"&eLightning&r egg: under open sky, in the rain."
		""
		"It takes a long while. The baby belongs to whoever placed the egg."
	]
	quest.7A5BB4C2080C6C2C.title: "Raising a Dragon"
	quest.7A5BB4C2080C6C2C.quest_desc: [
		"Baby dragons eat meat. &eDragon Meal&r (bones and meat) makes them grow much faster."
		"Right-click your dragon to see its age, stage and hunger."
		""
		"A &eDragon Command Staff&r (a dragon skull on sticks) tells it to stay or wander."
		"Two grown tame dragons can even be bred for more eggs (see the Bestiary)."
	]
	quest.04F69D19F3617A37.title: "Dragon Rider"
	quest.04F69D19F3617A37.quest_desc: [
		"Riding a dragon is the reward at the very end of this road: a dragon you hatched,"
		"fed and raised to full size yourself, after the Ender Dragon has fallen."
		""
		"Sneak and right-click a big enough tame dragon to mount it. Jump to take off,"
		"sneak to come down; your breath-attack key is in Options > Controls."
		""
		"A dragon gets hungry, and even a tame one wrecks the land where it fights."
		"In Strata, dragons are the late-game mount, not a shortcut."
	]
	quest.00C6860F86601DFD.title: "Other Beasts"
	quest.00C6860F86601DFD.quest_desc: [
		"Dragons aren't alone. The Bestiary covers all of these:"
		""
		"&eHydra&r in swamp hills, &eCyclopes&r in sea caves on beaches, &eGorgons&r under"
		"beach temples, &eSea Serpents&r in the ocean, &eSirens&r on ocean rocks, &eDread&r undead"
		"from frozen Mausoleums, plus trolls, death worms, cockatrices, stymphalian birds,"
		"pixies and hippogryphs."
		""
		"Silver ore (for silver weapons, great against undead) and sapphires are new ores too."
	]
	quest.68B34314E0250826.title: "The Hydra"
	quest.68B34314E0250826.quest_desc: [
		"Cut off a head and two grow back, unless the Hydra is &con fire&r. Burning stops the"
		"regrowth and its healing. It only dies with one head left."
		""
		"&6Drops:&r Hydra Fangs (life-stealing poison arrows) and the &eHydra Heart&r, which heals"
		"you more the more hurt you are, just by sitting in your hotbar."
	]
	quest.08DD9B236624B301.title: "The Cyclops"
	quest.08DD9B236624B301.quest_desc: [
		"A giant shepherd in a beach cave. One bite can kill. Shoot it in the &eeye&r to blind it,"
		"or sneak up wearing &eSheep Disguise&r armor."
		""
		"&6Drops:&r the &eEye of Cyclops&r and its skull."
	]
	quest.2D735EC6ACF1C705.title: "The Gorgon"
	quest.2D735EC6ACF1C705.quest_desc: [
		"&cDon't look at her eyes&r: her gaze turns you to stone. She waits under a temple on"
		"the shore, behind a trapdoor opened by hidden switches."
		""
		"Wear a &eBlindfold&r. Her head turns any creature you point it at to stone, once."
	]
	quest.0690BDAD767A0126.title: "Sea Serpent"
	quest.0690BDAD767A0126.quest_desc: [
		"Fast, savage, and happy to leap out of the water at your boat."
		""
		"&6Drops:&r scales and fangs: &eTide Guardian&r armor (water breathing, and more strength"
		"in water) and arrows that fly through water."
	]
	quest.55C0236503E0E5DC.title: "The Dread Lich"
	quest.55C0236503E0E5DC.quest_desc: [
		"In the coldest lands, &eMausoleums&r of unbreakable Dreadstone hold an ancient evil."
		"Dread Liches roam outside, summoning thralls, ghouls and beasts."
		""
		"A Lich sometimes drops a &eGravemaster's Key&r, which opens a Mausoleum's gate."
	]
	quest.44F426E82F4FC258.title: "Where Next?"
	quest.44F426E82F4FC258.quest_desc: [
		"&cCombat & Gear&r: socket gems into your dragonsteel."
		"&cL_Ender's Cataclysm&r and &cBoss Hunter&r: more giant fights."
		"&5The End&r: the Ender Dragon, which you need before riding your own."
	]
	chapter.28963DABDE025A71.title: "Ice and Fire"
	chapter.28963DABDE025A71.chapter_subtitle: ["Dragons, dragonsteel and mythical beasts"]
	quest.3498B3B6B39E8EA3.title: "What is Boss Hunter?"
	quest.3498B3B6B39E8EA3.quest_desc: [
		"Strata has bosses from many mods, scattered all over the world. This chapter is a"
		"hunting list: one branch per mod, with where to look."
		""
		"Every boss keeps its designed strength (the world's difficulty steps don't touch them)."
		"Most are built for a group: bring friends, food, and a way home."
		""
		"&eTip:&r an &eExplorer's Compass&r finds structures by name, and many mods add an"
		"\"Eye\" that you throw to point the way."
	]
	quest.41BE5C4E4454A209.title: "Mowzie's Mobs"
	quest.41BE5C4E4454A209.quest_desc: [
		"Hand-animated bosses with lots of personality. Each one lives in its own spot in the"
		"Overworld and fights with clear, readable attacks: learn the pattern, then strike."
	]
	quest.58FD9E8ED041E5D8.title: "Ferrous Wroughtnaut"
	quest.58FD9E8ED041E5D8.quest_desc: [
		"A living suit of armor in a &eWrought Chamber&r underground (around Y 20 to 50)."
		"Its armor shrugs off hits from the front: dodge its axe swing, then get behind it."
		""
		"&6Drops:&r the &eAxe of a Thousand Metals&r and the &eWrought Helm&r."
	]
	quest.70E5C5F0EFC9926F.title: "Frostmaw"
	quest.70E5C5F0EFC9926F.quest_desc: [
		"A huge ice beast asleep in open snowy biomes. Don't wake it unprepared."
		""
		"&6Drops:&r the &eIce Crystal&r (frost breath of your own), if it still has it when it dies."
	]
	quest.6574426802E22EF2.title: "Umvuthi, the Sunbird"
	quest.6574426802E22EF2.quest_desc: [
		"Leader of the masked Umvuthana, in a grove in the &esavanna&r. Its masked followers"
		"fight at its side."
		""
		"&6Drops:&r the &eSol Visage&r mask."
	]
	quest.28EE282866F4F267.title: "Tongbi, the Sculptor"
	quest.28EE282866F4F267.quest_desc: [
		"Lives in a monastery on &emountain peaks&r. First its challenge: climb its stone course"
		"to the top without placing or breaking blocks, flying or teleporting."
		""
		"&6Drops:&r the &eGeomancer Staff&r and the Geomancer armor set."
	]
	quest.4A9FC587933E287F.title: "Naga"
	quest.4A9FC587933E287F.quest_desc: [
		"Flying serpents of &erocky shores&r and beach cliffs. Bring a bow."
		""
		"&6Drops:&r &eNaga Fangs&r for a poison dagger."
	]
	quest.4AE2A0B748ACBE37.title: "Bosses of Mass Destruction"
	quest.4AE2A0B748ACBE37.quest_desc: [
		"Four bosses, each with its own arena: one in cold lands, one deep in the Overworld,"
		"one in the Nether and one in the End. Their drops craft some powerful blocks."
	]
	quest.12981FAA91CBFC62.title: "The Night Lich"
	quest.12981FAA91CBFC62.quest_desc: [
		"Haunts a tall tower in &ecold biomes&r. Fight it at night at your own risk."
		""
		"&6Drops:&r &eAncient Anima&r."
	]
	quest.14DC1F5E2F680169.title: "The Void Blossom"
	quest.14DC1F5E2F680169.quest_desc: [
		"A giant plant boss hidden in the Overworld. Craft a &eVoid Lily&r (lily of the valley +"
		"amethyst shard) and watch where its pollen leads."
		""
		"&6Drops:&r &eVoid Thorns&r and &eCrystal Fruit&r (brief regeneration and resistance)."
	]
	quest.3DEB5FA343326DFB.title: "The Nether Gauntlet"
	quest.3DEB5FA343326DFB.quest_desc: [
		"A giant living gauntlet in an arena deep in the &cNether&r. Its treasure holds the"
		"&eBlazing Eye&r."
	]
	quest.1589A286AB8C54D6.title: "The Obsidilith"
	quest.1589A286AB8C54D6.quest_desc: [
		"An obsidian pillar that comes alive in an arena on the &5End&r islands. Its treasure"
		"holds the &eObsidian Heart&r."
	]
	quest.7F2BCE8E5A5BAF67.title: "Bosses'Rise"
	quest.7F2BCE8E5A5BAF67.quest_desc: [
		"Souls-like boss fights: big telegraphed attacks, dodge (Combat Roll!) and punish."
		"Five bosses, each in its own lair."
	]
	quest.4DA19326C01D8CB3.title: "Sirok, the Sandworm"
	quest.4DA19326C01D8CB3.quest_desc: [
		"Lurks in a nest in the &edesert&r."
		""
		"&6Drops:&r the Sandworm Gauntlet."
	]
	quest.02CB64D8E8EC31FB.title: "Skor, the Yeti"
	quest.02CB64D8E8EC31FB.quest_desc: [
		"Hides out in the &esnowy plains&r and throws ice."
		""
		"&6Drops:&r the Skor Gauntlet."
	]
	quest.31CD926F70994CC6.title: "Nerakyss, the Kraken"
	quest.31CD926F70994CC6.quest_desc: [
		"Its lair is a ship in the &edeep ocean&r."
		""
		"&6Drops:&r Kraken Teeth."
	]
	quest.7FA88873F136B7DC.title: "Ashlord, the Infernal Dragon"
	quest.7FA88873F136B7DC.quest_desc: [
		"Rules a tower in plains, jungles, swamps and savannas. Its guards drop"
		"&eAncient Trial Keys&r: keep them."
		""
		"&6Drops:&r Ashlord's bones and skull."
	]
	quest.610697DFCC958617.title: "Helvar, the Underworld Knight"
	quest.610697DFCC958617.quest_desc: [
		"Waits in an arena in the &cNether&r (nether wastes and soul sand valleys). Soul skeletons"
		"and wither knights drop the &eUnderworld Arena Key&r."
		""
		"&6Drops:&r &eHelvar's Sword&r."
	]
	quest.0C037D787CB7E126.title: "Qliphoth Awakening"
	quest.0C037D787CB7E126.quest_desc: [
		"Three hard, mechanic-heavy bosses. Craft the &eQliphothic Codex&r (a book, logs and"
		"glowstone): it's the boss guide, with each boss and its attacks."
		""
		"Each has a craftable &eEye&r that points to its arena."
	]
	quest.1A9433EF8E9F5A57.title: "Malkuth"
	quest.1A9433EF8E9F5A57.quest_desc: [
		"A fallen fire-and-ice king in an arena by the &edeep ocean&r (Eye of Malkuth: ice,"
		"magma and an Eye of Ender). You'll be weak to fire or ice in turns: the crosshair shows"
		"which. Use the cannons on your side. Leaving mid-fight is deadly."
		"The developer says: fight him at night."
	]
	quest.0945A097FE597641.title: "Chesed"
	quest.0945A097FE597641.quest_desc: [
		"A sculk-corroded rock giant with huge lightning powers, in an arena deep underground"
		"(Y -30 to -50; Eye of Chesed: sculk around an Eye of Ender). It can't be hurt directly:"
		"read the Codex for how to turn its power against it. Diamond axes are recommended."
	]
	quest.18D09C822ABBFE50.title: "Geburah"
	quest.18D09C822ABBFE50.quest_desc: [
		"A divine judge construct in an arena in the &5End&r, near End Cities"
		"(Eye of Geburah: gold and blackstone bricks)."
	]
	quest.7999400B1B471EEA.title: "Legendary Monsters"
	quest.7999400B1B471EEA.quest_desc: [
		"Lots of bosses, each guarding a temple, ruin or nest. Their drops are rare crafting"
		"parts and weapons. Here are the main ones."
	]
	quest.04F7F6E43E76CB01.title: "Overgrown Colossus"
	quest.04F7F6E43E76CB01.quest_desc: [
		"Lurks in a mossy temple in the &ejungle&r. &6Drops:&r a Nature Crystal."
	]
	quest.58A51CB79C8851B2.title: "Dune Sentinel"
	quest.58A51CB79C8851B2.quest_desc: [
		"Guards a ruined pyramid in the &edesert&r, with bombers for company."
		"&6Drops:&r the Crystal of Sandstorm."
	]
	quest.30F6528B7CBC31BF.title: "Frostbitten Golem"
	quest.30F6528B7CBC31BF.quest_desc: [
		"In a frozen temple in &esnowy&r plains, taiga and ice spikes. &6Drops:&r a Frozen Rune."
	]
	quest.32650611BBE686C4.title: "Cumulonimbus"
	quest.32650611BBE686C4.quest_desc: [
		"A storm-cloud golem at the top of the Cloudy Temple on &emountain peaks&r, with"
		"Hovering Hurricanes on the way up. &6Drops:&r an Air Rune."
	]
	quest.50CA71A2EE5E2706.title: "Ancient Guardian"
	quest.50CA71A2EE5E2706.quest_desc: [
		"Deep in an Ancient Stronghold under &edark forests&r and taigas, past the Ambushers."
	]
	quest.00FB7110AB839E0B.title: "Possessed Paladin"
	quest.00FB7110AB839E0B.quest_desc: [
		"The last stand of a Collapsed Kingdom in &eplains and forests&r, guarded by haunted"
		"knights. &6Drops:&r a Corrupted Soul and the Soul Great Sword."
	]
	quest.380B912CCDCE130F.title: "Lava Eater"
	quest.380B912CCDCE130F.quest_desc: [
		"Lives in the &cNether Wastes&r. &6Drops:&r Lava Eater's Skin."
	]
	quest.777E2093B19EFBA6.title: "Withered Abomination"
	quest.777E2093B19EFBA6.quest_desc: [
		"In the remains of a soul fortress, in &cSoul Sand Valleys&r and Nether Wastes."
	]
	quest.315662857C984419.title: "Shulker Mimic"
	quest.315662857C984419.quest_desc: [
		"Not every shulker is a shulker. Climb the Shulker Tower on the &5End&r's outer islands."
	]
	quest.699BD4CF19F6EE51.title: "Annihilation Pursuer"
	quest.699BD4CF19F6EE51.quest_desc: [
		"The boss of the &5End&r's Space Station, full of flameborn guards and wandering eyes."
		"&6Drops:&r Enderitium Gems."
	]
	quest.2180673070990FB1.title: "Apocalyptic Bosses"
	quest.2180673070990FB1.quest_desc: [
		"Over 25 bosses, most of them in dungeons with rich treasure."
		""
		"&cCareful:&r a few of them, like the Gargoyle, the Golem King and mutant zombies, wander"
		"the forests and plains on their own. If one shows up early, run."
	]
	quest.1D36FC8251838220.title: "Furacas"
	quest.1D36FC8251838220.quest_desc: ["Waits in its dungeon in the &edesert&r."]
	quest.717FF03B8435B80D.title: "Ice Lord"
	quest.717FF03B8435B80D.quest_desc: ["Rules a dungeon in the &eIce Spikes&r."]
	quest.3306B5B056E0DF07.title: "T-Rex"
	quest.3306B5B056E0DF07.quest_desc: ["Yes, really. Look for its dungeon in the &ejungle&r."]
	quest.023ABAFD92B4D961.title: "The Silence Death"
	quest.023ABAFD92B4D961.quest_desc: [
		"Deep under the &emountains&r, in a sculk dungeon with the Echo King and sculk creatures."
	]
	quest.1229957AD54F065C.title: "Lava Lord"
	quest.1229957AD54F065C.quest_desc: ["Lives underground in the &cNether&r."]
	quest.72E222D0A0530683.title: "Skeleton God"
	quest.72E222D0A0530683.quest_desc: ["Holds court in a dungeon in the &cSoul Sand Valley&r."]
	quest.5E9529DDE7738A78.title: "The Chaos"
	quest.5E9529DDE7738A78.quest_desc: ["Hidden underground in the &cNether&r."]
	quest.0B0432729EA8CAF7.title: "The Queen of the Abyss"
	quest.0B0432729EA8CAF7.quest_desc: [
		"The final boss, in a dungeon in the &5End&r, guarded by Abyssal Knights."
	]
	task.1C42BA1685DA3099.title: "A Catacomb (Soul Sand Valley)"
	task.048D92FD5B6BE270.title: "A Citadel (Warped Forest)"
	task.52E6130D67213344.title: "A Piglin Manor (Crimson Forest)"
	quest.2B414F8F37C60682.title: "Eternal Nether"
	quest.2B414F8F37C60682.quest_desc: [
		"&eEternal Nether&r has no single boss. Instead it adds three dangerous strongholds and"
		"tough new mobs: Wither Skeleton Knights, Wraithers, Corpors, Warped Endermen and"
		"Piglin Hunters. Visit all three. Some piglins are prisoners: rescue them."
	]
	task.07BAA636CB159558.title: "Enter the Ice Maze"
	quest.6B4E1D973CC5E7B7.title: "The Ice Maze"
	quest.6B4E1D973CC5E7B7.quest_desc: [
		"&eAquamirae&r covers &eDeep Frozen Oceans&r with the &bIce Maze&r: icebergs, frozen pirate"
		"ships and nasty sea creatures. Bring warm gear, a boat and torches."
	]
	quest.06AC3C6DB03314F4.title: "Maze Mother"
	quest.06AC3C6DB03314F4.quest_desc: [
		"A giant creature of the Ice Maze waters. &6Drops:&r &eAbyssal Amethyst&r for the"
		"Abyssal armor upgrade."
	]
	quest.00C72B9D3DBD20F7.title: "The Shell Horn"
	quest.00C72B9D3DBD20F7.quest_desc: [
		"Frozen pirate ships in the Ice Maze hold a &eShell Horn&r. Blow it near water in the"
		"Ice Maze to summon a ghost."
	]
	quest.585D6EAD1DEF27F7.title: "Ghost of Captain Cornelia"
	quest.585D6EAD1DEF27F7.quest_desc: [
		"The restless ghost of a pirate captain. &6Drops:&r the &eFrozen Key&r and Salvager gear."
	]
	task.7997ADB3C5A48D32.title: "Meet the Shipbreaker"
	quest.4C2C94426B256696.title: "The Shipbreaker"
	quest.4C2C94426B256696.quest_desc: [
		"The most fearsome thing in the Ice Maze. It finds you, not the other way round."
		"Survive."
	]
	quest.61DF64BC56C2440E.title: "Where Next?"
	quest.61DF64BC56C2440E.quest_desc: [
		"&cL_Ender's Cataclysm&r: the bosses that unlock late tech."
		"&cIce and Fire&r: dragons."
		"&cCombat & Gear&r: salvage and reforge the loot you've collected."
	]
	chapter.17453874FC2A4812.title: "Boss Hunter"
	chapter.17453874FC2A4812.chapter_subtitle: ["Bosses from every corner of the world"]
	quest.08210F8B88F1BABF.title: "What is Farmer's Delight?"
	quest.08210F8B88F1BABF.quest_desc: [
		"Welcome to the kitchen! &eFarmer's Delight&r turns food into a real hobby:"
		"new crops, a cutting board, a skillet, a cooking pot and big feasts to share."
		""
		"Cooked meals fill you up much more than plain bread, and many give nice effects."
		"Even better: eating lots of &adifferent&r foods gives you extra hearts (see \"A Varied Diet\")."
		""
		"Nothing here is hard. Follow the quests one at a time and you'll be a chef in no time!"
	]
	quest.41DB76794B6741B3.title: "Every Chef Needs a Knife"
	quest.41DB76794B6741B3.quest_desc: [
		"Knives are the heart of Farmer's Delight. They cut food on the cutting board,"
		"and they're also handy weapons."
		""
		"A &eFlint Knife&r is the cheapest. Iron, gold and diamond knives come later."
		"Tip: breaking tall grass with a knife can give you &eStraw&r."
	]
	quest.2D200BC1E522DE11.title: "Wild Veggies"
	quest.2D200BC1E522DE11.quest_desc: [
		"Look for wild plants out in the world: &eWild Cabbage&r, &eWild Onion&r and"
		"&eTomato Shrubs&r grow in different biomes. Break them for crops and seeds."
		""
		"Plant the seeds on farmland like wheat. Onions are planted whole, like potatoes."
		"Hover a crop and press &eU&r to see everything you can cook with it."
	]
	quest.7EBF0F478AE89465.title: "Rice Paddies"
	quest.7EBF0F478AE89465.quest_desc: [
		"&eWild Rice&r grows in shallow water near rivers and swamps."
		""
		"Rice is planted &ein water&r, one block deep, on top of dirt or grass."
		"When it's tall and golden, harvest the panicles. Rice goes into sushi, fried rice and more."
	]
	task.00C7F93902DB8C52.title: "Harvest a tomato that climbed a rope"
	quest.2D0021AF753E6B25.title: "Tomatoes on a Rope"
	quest.2D0021AF753E6B25.quest_desc: [
		"Tomatoes love to climb! Place a &eRope&r above a tomato plant and it grows up the rope,"
		"giving you more tomatoes from one spot."
		""
		"Ropes are made from straw. You can also climb ropes yourself."
	]
	quest.7F7DAA10E504440C.title: "Rich Soil"
	quest.7F7DAA10E504440C.quest_desc: [
		"Craft &eOrganic Compost&r and place it on the ground. Over time it turns into"
		"&eRich Soil&r all by itself."
		""
		"Rich soil makes crops grow faster. Mushrooms planted on it grow into big colonies"
		"you can harvest again and again."
	]
	quest.36B72BC3E6B62642.title: "The Turning Seasons"
	quest.36B72BC3E6B62642.quest_desc: [
		"The overworld has &aspring, summer, autumn and winter&r (Serene Seasons)."
		"Each season lasts a few weeks of in-game days."
		""
		"Crops planted &cout of season&r grow very slowly. Hover over a seed: its tooltip lists the"
		"seasons it likes. Deep underground (below about &eY 48&r) crops grow all year round."
		""
		"A &eCalendar&r shows the current season and day. A &eSeason Sensor&r gives a redstone signal."
		""
		"Village farmers here are smarter too: they harvest and replant modded crops."
	]
	quest.5D21F2C5D9E92C53.title: "The Cutting Board"
	quest.5D21F2C5D9E92C53.quest_desc: [
		"Place the &eCutting Board&r, put an item on it, then right-click it with your knife."
		""
		"It slices meat, chops cabbage into leaves, turns pumpkins into slices and strips bark"
		"from logs. Other tools work too: try an axe on a log!"
	]
	task.13C807F9D043B15D.title: "Place a Cooking Pot"
	quest.02DFBEAE86898B4A.title: "Cooking Pot Time"
	quest.02DFBEAE86898B4A.quest_desc: [
		"The &eCooking Pot&r makes soups, stews and meals. It needs &cheat underneath&r:"
		"a campfire, or a &eStove&r (which can also cook six things on top)."
		""
		"Put the ingredients in, and a bowl if the meal needs one. Wait a moment and the"
		"meal appears on the right. Shift-click it out."
		""
		"Not sure what you can make? Hover the pot and press &eU&r."
	]
	quest.3FA7BC00D112B479.title: "Sizzle!"
	quest.3FA7BC00D112B479.quest_desc: [
		"The &eSkillet&r cooks food fast. Place it on something hot and drop food in,"
		"or hold it in your hand and right-click to cook while standing near heat."
		""
		"It's also a surprisingly good frying-pan weapon. Bonk!"
	]
	quest.53B7CC0E649A80ED.title: "Cook Five Dishes"
	quest.53B7CC0E649A80ED.quest_desc: [
		"Time to show off! Cook these five dishes."
		""
		"Salads and sandwiches are crafted, soups and fried rice come from the pot."
		"Press &eR&r on each one to see its recipe."
		""
		"Each new dish you eat also counts toward your &aFood Diversity&r. Tasty &oand&r useful."
	]
	task.4D511FDEFADF35B0.title: "Place a feast"
	quest.0D0F37CDCDDB9A38.title: "A Feast for Friends"
	quest.0D0F37CDCDDB9A38.quest_desc: [
		"Feasts are big meals you &eplace on a table&r: Roast Chicken, Stuffed Pumpkin,"
		"Honey Glazed Ham, Shepherd's Pie and Rice Roll Medley."
		""
		"Right-click a feast with an empty bowl to serve a portion. One feast feeds the"
		"whole group, so cook one and invite everyone over!"
	]
	quest.25D0290239883655.title: "Treats for Pets"
	quest.25D0290239883655.quest_desc: [
		"&eDog Food&r feeds and heals tamed wolves, and &eHorse Feed&r heals horses."
		"Spoil your friends! See the &aPets & Critters&r chapter."
	]
	quest.5F0241BC1E057665.title: "A Varied Diet"
	quest.5F0241BC1E057665.quest_desc: [
		"&eSpice of Life&r rewards a varied diet. It remembers the last foods you ate:"
		"the more &adifferent&r foods, the higher your &eFood Diversity&r."
		""
		"As it rises you unlock bonuses: &cextra hearts&r first, then things like strength,"
		"regeneration and speed. Eating the same thing over and over lowers it,"
		"and it resets when you die."
		""
		"The &eFood Book&r (book + potato) shows your diversity and what's next."
		"There's also an &eSOL&r button in your inventory. A &eLunchbag&r carries lots of snacks."
	]
	quest.37EC9F070ABA48DF.title: "Cooking for Blockheads"
	quest.37EC9F070ABA48DF.quest_desc: [
		"Too many recipes? The &eCooking for Blockheads&r book shows food you can make"
		"&eright now&r from what's in your inventory."
		""
		"Later it becomes the brain of a whole kitchen."
	]
	quest.06189901DF3ADD44.title: "Build a Kitchen"
	quest.06189901DF3ADD44.quest_desc: [
		"The &eCooking Table&r is the centre of a multiblock kitchen. Connect counters,"
		"a fridge, a sink (free water), an oven, a spice rack and a tool rack to it."
		""
		"Open the table and click any dish to cook it from everything stored in the whole kitchen."
		"Dye the blocks to match your house!"
	]
	quest.019D048602AC7C2C.title: "Croptopia: So Many Crops"
	quest.019D048602AC7C2C.quest_desc: [
		"&eCroptopia&r adds dozens of crops and fruit trees: strawberries, corn, coffee, bananas,"
		"lemons and many more. You'll find its seeds and fruit trees out in the world"
		"as you explore different biomes."
		""
		"It has its own cooking tools too (frying pan, food press, mortar and pestle)."
		"Every new crop is a new food for your diet!"
	]
	quest.7EF6F8B2B5684176.title: "Grapes of Joy"
	quest.7EF6F8B2B5684176.quest_desc: [
		"&e[Let's Do] Vinery&r is all about grapes and wine. Wild grape bushes grow in"
		"many biomes (red and white, plus jungle, savanna and taiga kinds)."
		""
		"Plant the seeds. Planting them on a &eGrapevine Stem&r gives a bigger harvest,"
		"and jungle grapes like to climb a &eLattice&r."
	]
	quest.5F29B87EC3A61C10.title: "Squish!"
	quest.5F29B87EC3A61C10.quest_desc: [
		"Grapes become juice in a &eGrapevine Pot&r. Apples have their own &eApple Press&r."
		"Juice is tasty by itself, but it's even better as wine."
	]
	quest.3DB97582BAFE48D8.title: "A Fine Vintage"
	quest.3DB97582BAFE48D8.quest_desc: [
		"Fill a &eFermentation Barrel&r with juice, add the extra ingredients and an empty"
		"&eWine Bottle&r, and wait."
		""
		"Wine keeps getting better with age, so store some in a wine rack and forget about it."
		"Different wines give different effects. Press &eR&r on a wine to see what it needs."
	]
	quest.5B141910673A91E1.title: "Brewin' and Chewin'"
	quest.5B141910673A91E1.quest_desc: [
		"The &eKeg&r ferments drinks (mead, kombucha, rice wine) and makes cheese,"
		"jam and pickles. It cares about temperature:"
		"some recipes want it warm, others cold."
		""
		"Big cheese wheels age slowly when you place them. Pizza and quiche are worth the wait!"
	]
	quest.76DF40EB15E69336.title: "Delights Everywhere"
	quest.76DF40EB15E69336.quest_desc: [
		"Almost every world in Strata has its own Farmer's Delight add-on. When you visit, bring"
		"your knife and a pot:"
		""
		"&5End&r: chorus pies and shulker dishes (Ender's Delight)."
		"&cNether&r: hot sauce, hoglin feasts and spicy peppers (My Nether's Delight)."
		"&aTwilight Forest&r, &bAether&r: their own meals (Twilight's Flavor, Aether's Delight)."
		"&dArs Nouveau&r: magical fruit pies and teas. &4Vampirism&r: blood-themed treats."
		"Cataclysm bosses even drop ingredients for wild dishes (L_Ender's Cataclysm Delight)."
		""
		"Every one is a new food for your diet!"
	]
	quest.46B51114E32BA33C.title: "Spicy!"
	quest.46B51114E32BA33C.quest_desc: [
		"&eBullet Peppers&r grow in the Nether. They spice up My Nether's Delight recipes,"
		"which bring hot dogs, chili dogs and hoglin feasts."
	]
	quest.47804A0CA0FA5682.title: "Strange Snacks"
	quest.47804A0CA0FA5682.quest_desc: [
		"End cooking! Chorus fruit becomes a pie in Ender's Delight."
		"Some End foods have funny side effects. Read the tooltip before you eat!"
	]
	quest.6E9B5732FA7A4EAE.title: "Where Next?"
	quest.6E9B5732FA7A4EAE.quest_desc: [
		"Your kitchen is open for business! Where to now?"
		""
		"&aPets & Critters&r: tame a friend and feed it treats."
		"&aBuilding & Decorating&r: give your kitchen a cosy home."
		"&aFishing&r: fish are great food (Ocean's Delight has seafood recipes)."
		"&bCreate&r chapters: automate your farm and kitchen with machines later on."
	]
	chapter.4D2C5E2A05400DB9.title: "Farming & Food"
	chapter.4D2C5E2A05400DB9.chapter_subtitle: ["Grow it, cook it, share it. Eating well makes you stronger!"]
	quest.54257CD45A6BC403.title: "What's Out There?"
	quest.54257CD45A6BC403.quest_desc: [
		"Strata's world is full of animals: otters, red pandas, ducks, frogs that run"
		"their own villages, butterflies, snails, giraffes and lots more."
		""
		"Many can be &etamed&r, some can be &ebred&r, and a few will even live in your pocket."
		"This chapter is a gentle tour. Go at your own pace and say hi to everyone!"
	]
	task.1170FAA896EB65C4.title: "Tame any animal"
	quest.5B764381AAC1F3CF.title: "A Best Friend"
	quest.5B764381AAC1F3CF.quest_desc: [
		"Wolves love &ebones&r, cats love &eraw fish&r, parrots love seeds."
		"Keep feeding until you see hearts."
		""
		"In Strata you can also tame &efoxes&r and win over &ehorses&r with patience (Redomesticate)."
		"Your swings pass right through your own pets, so you won't bonk them by accident."
	]
	task.594E051C4B5E0FB8.title: "Craft and place a Pet Bed"
	quest.500669146C6DFD48.title: "A Bed for Your Pet"
	quest.500669146C6DFD48.quest_desc: [
		"Here's the most important pet tip: give your pet a &ePet Bed&r."
		""
		"If a pet with a bed dies, it &arespawns at its bed&r instead of being gone forever."
		"Look at a bed (Jade shows it) to see whose bed it is."
		""
		"Pet beds come in every color. Put one somewhere cozy at home."
	]
	quest.36C7770BE836D1B8.title: "Sit! Stay! Follow!"
	quest.36C7770BE836D1B8.quest_desc: [
		"The &eCommand Drum&r tells your nearby pets to &ewander&r, &estay&r or &efollow&r,"
		"all at once. Great when you have a whole pack."
		""
		"Redomesticate also adds pet-only enchantments that turn up as books in loot."
		"Check them out with &eU&r if you find one."
	]
	quest.2FF5092CF12ABFF3.title: "Play Time"
	quest.2FF5092CF12ABFF3.quest_desc: [
		"A &eFeather on a Stick&r. Wave it around and see who comes running!"
	]
	task.7D21A9211A642FD1.title: "Breed two animals"
	quest.527757E732BCC4F2.title: "Baby Animals"
	quest.527757E732BCC4F2.quest_desc: [
		"Feed two adult animals of the same kind their favorite food and a baby pops out."
		""
		"Not sure what an animal eats? Hover over a food and press &eU&r: the"
		"&eBreeding&r and &eTaming&r tabs (Just Enough Breeding) show who likes it."
	]
	quest.55CB5323039FBCFB.title: "Horse Sense"
	quest.55CB5323039FBCFB.quest_desc: [
		"Horses are your first fast way to travel. But which horse is best?"
		""
		"Wear the &eMonocle&r and look at a horse, donkey or other mount to see its"
		"&ehealth, speed and jump height&r. Breed the fastest ones for even faster foals."
	]
	quest.3C638394DD29C484.title: "Call Your Horse"
	quest.3C638394DD29C484.quest_desc: [
		"&eSneak + use&r the &eCopper Horn&r on your horse to bind it."
		"Then &euse&r the horn and your horse comes to you, as long as it can hear the horn:"
		"it has to be nearby and in the same dimension."
		""
		"Horses can also be hitched with a lead, and mounted horses handle more smoothly here."
	]
	task.39035EB3F79DAC78.title: "Get your first Inventory Pet"
	quest.2EAEB13007DBA1D1.title: "Pets in Your Pocket"
	quest.2EAEB13007DBA1D1.quest_desc: [
		"&eInventory Pets&r are tiny helpers that live in your inventory. Each one has a"
		"little power. Some cute ones to start with:"
		""
		"&eChicken Pet&r: a speed boost, and it lays eggs for you."
		"&eCow Pet&r: clears bad potion effects and fills buckets with milk."
		"&eSiamese Pet&r: brings you little gifts."
		"&eHeart Pet&r: heals your friends and pets."
		""
		"Each pet has a &afavorite food&r (look at its tooltip). Keep some in your inventory."
	]
	quest.64F6BE2D96AF4F37.title: "Snack Pack"
	quest.64F6BE2D96AF4F37.quest_desc: [
		"The &eFeed Bag&r holds pet food, so your pocket pets stay fed without"
		"clogging up your inventory."
	]
	task.19A971B240F4C220.title: "Collect five Inventory Pets"
	quest.490063265F5E24D9.title: "Pet Collector"
	quest.490063265F5E24D9.quest_desc: [
		"Collect five different pocket pets! Good ones for cozy players:"
		"the Sheep, Mooshroom, Banana, Jukebox, Bed and Crafting Table pets."
		""
		"Press &eR&r on a pet to see its recipe and &eU&r on its food."
	]
	task.03914571C3B810EF.title: "Visit a Tree Top"
	quest.4C2A84DBE0B7E5CC.title: "Find a Pet Dungeon"
	quest.4C2A84DBE0B7E5CC.quest_desc: [
		"Inventory Pets has its own little dungeons with pet goodies inside."
		"&eTree Tops&r are hidden high up in big trees. Keep your eyes on the canopy!"
		""
		"Watch out: they're guarded, and some chests are booby-trapped."
	]
	task.6BF66EA0E8F1A66D.title: "Visit an Underground Dungeon"
	quest.05C6B6CFA35C86FD.title: "Underground Pet Dungeon"
	quest.05C6B6CFA35C86FD.quest_desc: [
		"There are &eUnderground Dungeons&r too, plus sea caves and stranger ones."
		"Bring torches and a friend."
	]
	task.7B6A11D209BCC4F0.title: "Pick up a villager"
	quest.36E7D6EE21BED3E0.title: "Villager in a Box"
	quest.36E7D6EE21BED3E0.quest_desc: [
		"&eSneak + right-click&r a villager to pick it up as an item (Easy Villagers)!"
		"No more pushing villagers through fields with boats."
		""
		"Put one into a &eTrader&r block for a neat one-block shop, or into a"
		"&eFarmer&r or &eBreeder&r block for little villager farms."
		""
		"&eGuard Villagers&r patrol villages and protect them from raids. Be nice to them."
	]
	quest.697FA0C02A6A1D52.title: "The Animal Dictionary"
	quest.697FA0C02A6A1D52.quest_desc: [
		"&eAlex's Mobs&r adds dozens of real and strange animals: elephants, raccoons,"
		"hummingbirds, kangaroos, crows and many more. Some can be tamed!"
		""
		"The &eAnimal Dictionary&r tells you about every one: where it lives, what it eats,"
		"and whether it's friendly. Hover it and press &eR&r to see how to make one."
	]
	quest.67FE371B97B0CA08.title: "Bug Catcher"
	quest.67FE371B97B0CA08.quest_desc: [
		"&eNaturalist&r fills forests, swamps and savannas with snails, ducks, butterflies,"
		"fireflies, bears, giraffes and more."
		""
		"A &eCapture Net&r (bamboo and string) catches small critters like butterflies"
		"so you can carry them home to your garden."
	]
	task.5DBD7FD935EF1425.title: "Build a Copper Golem"
	quest.05C9B21F3A505DE2.title: "Friends and Foes"
	quest.05C9B21F3A505DE2.quest_desc: [
		"&eFriends & Foes&r brings back mobs from the Minecraft mob votes: flower cows"
		"(&eMooblooms&r), little &eGlares&r that find dark spots, crabs, penguins and more."
		""
		"Build a &eCopper Golem&r the way you'd build a snow golem, from a copper block,"
		"a carved pumpkin and a lightning rod. It wanders around pressing copper buttons!"
	]
	quest.0050ECD1B076C7A5.title: "Flower Crown"
	quest.0050ECD1B076C7A5.quest_desc: [
		"&eCreatures and Beasts&r adds lizards, sporelings, cute cindershells and more."
		"Pick three &eMinipad Flowers&r from lily ponds and craft a pretty &eFlower Crown&r."
	]
	quest.5B75A94A5DCE2076.title: "Tiny Companions"
	quest.5B75A94A5DCE2076.quest_desc: [
		"&eCritters and Companions&r adds the cutest little animals: &eotters&r,"
		"&ered pandas&r, &eferrets&r, &ekoi fish&r, &edragonflies&r, sea bunnies,"
		"tiny Shima Enaga birds and more."
		""
		"Some can be tamed and will follow you around. Go meet them!"
	]
	task.119034C0AC8C7F56.title: "Visit a Ribbit village"
	quest.1422B53A7DFED007.title: "The Frog Village"
	quest.1422B53A7DFED007.quest_desc: [
		"Deep in the swamps live the &eRibbits&r: friendly frog people with their own"
		"little villages among the toadstools and lily pads."
		""
		"There are fishermen, gardeners, a merchant and even a sorcerer. Say hello!"
	]
	task.4377819D66588031.title: "Find a Kobold den"
	quest.565371CA537A3C4C.title: "Kobold Den"
	quest.565371CA537A3C4C.quest_desc: [
		"&eKobolds&r are small lizard-folk who live in dens. There are warriors, engineers,"
		"enchanters and even pirates. Not all of them are friendly, so look before you leap."
	]
	task.108F0EE2CA771A44.title: "Defeat any royal mob"
	quest.02B6B096AFE31BC6.title: "Long Live the King?"
	quest.02B6B096AFE31BC6.quest_desc: [
		"Very rarely you'll meet a &6royal&r zombie, skeleton, creeper or enderman wearing a crown."
		"These kings are mini-bosses, much tougher than normal mobs."
		""
		"Fight them with friends and good gear. Their drops are worth it."
	]
	task.11767933BE2EA232.title: "Craft any plushie"
	quest.4FC8BE756DDB47BE.title: "Plushies!"
	quest.4FC8BE756DDB47BE.quest_desc: [
		"Soft, squishy plushies of almost every mob in the game, from cats and foxes"
		"to wardens and dragons. Made from wool and string."
		""
		"Search &e@plushies&r in the item list, press &eR&r on one you like, and craft it."
		"Put them on shelves, beds and windowsills. Collect them all!"
	]
	quest.57CF65389CD82A98.title: "Where Next?"
	quest.57CF65389CD82A98.quest_desc: [
		"You've made lots of new friends! What now?"
		""
		"&aFarming & Food&r: cook Dog Food and Horse Feed for your pets."
		"&aBuilding & Decorating&r: build your pets a cozy home."
		"&aFishing&r: cats love fish, and there are hundreds to catch."
		"&aExplorer's Guide&r: the farther you go, the stranger the animals."
	]
	chapter.70A7A127DD644E5C.title: "Pets & Critters"
	chapter.70A7A127DD644E5C.chapter_subtitle: ["Tame a friend, meet the wildlife, collect plushies"]
	quest.791208BAC6B60C6B.title: "What Can I Build?"
	quest.791208BAC6B60C6B.quest_desc: [
		"Pretty much anything! Strata has thousands of extra blocks: furniture, roofs, windows,"
		"lamps, paths, bridges and fancy stone and wood patterns."
		""
		"Tip: search the item list by mod. &e@mcw&r shows Macaw's blocks,"
		"&e@handcrafted&r furniture, &e@supplementaries&r all the little decorations."
		""
		"These quests show you the best tools. Then build your dream house!"
	]
	quest.4B4702FEB8F9F4CB.title: "One Block, Many Looks"
	quest.4B4702FEB8F9F4CB.quest_desc: [
		"&eChipped&r workbenches turn a plain block into dozens of new versions."
		"Put planks in the &eCarpenter's Table&r and pick the look you like."
		""
		"Other benches handle other blocks: the &eMason Table&r (stone), &eGlassblower&r (glass),"
		"&eLoom Table&r (wool and carpet), &eBotanist's Workbench&r (plants) and more."
	]
	quest.4731AB5132C87C29.title: "Stonework"
	quest.4731AB5132C87C29.quest_desc: [
		"The &eMason Table&r gives stone, bricks and more a whole new set of looks."
	]
	quest.4995B74033826A86.title: "Rechiseled"
	quest.4995B74033826A86.quest_desc: [
		"The &eChisel&r turns blocks into patterns: tiles, bricks, beams, mosaics and more."
		"Right-click with it to open it, put your blocks in, then choose a pattern."
		""
		"Many patterns &aconnect&r to each other when placed side by side."
	]
	quest.44168294F53DDB9A.title: "Framed Blocks"
	quest.44168294F53DDB9A.quest_desc: [
		"A &eFramed Block&r copies the look of any block you right-click it with."
		"Want stairs, slabs or doors that look like diamond blocks, glass or leaves? Easy!"
		""
		"There are framed versions of almost every shape. The &eFramed Hammer&r takes the"
		"block back out."
	]
	quest.3A2124EFF7DD6E2E.title: "Handcrafted Furniture"
	quest.3A2124EFF7DD6E2E.quest_desc: [
		"&eHandcrafted&r adds chairs, tables, couches, beds, shelves, cupboards, plates, cups and"
		"mob trophies, in every kind of wood. You can &esit&r on the chairs and couches."
		""
		"The &eHammer&r changes a furniture block's look or shape: right-click (or sneak +"
		"right-click) to cycle through the options."
	]
	quest.3A8DD09B28D07FA8.title: "Comfy Cushions"
	quest.3A8DD09B28D07FA8.quest_desc: [
		"Make a &eCouch&r for your living room. Add a cushion or a sheet to change its colour."
	]
	quest.6E1695F0A17C035C.title: "Macaw's Furniture"
	quest.6E1695F0A17C035C.quest_desc: [
		"&eMacaw's&r is a whole family of mods. &eFurniture&r has desks, drawers, wardrobes,"
		"kitchen cabinets and bookshelves. Many open up and store items!"
		""
		"Make a &eWardrobe&r for your clothes. Fancy!"
	]
	quest.437A8BB95378634A.title: "A Roof Over Your Head"
	quest.437A8BB95378634A.quest_desc: [
		"&eMacaw's Roofs&r has proper sloped roof pieces: plain, attic, steep, lower and more."
		"No more stair-block roofs (unless you like them)!"
	]
	quest.23AC8B9F5125787B.title: "Windows and Doors"
	quest.23AC8B9F5125787B.quest_desc: [
		"&eMacaw's Windows&r: windows that open, shutters, curtains and blinds."
		"Big windows connect into one when placed together."
		"&eMacaw's Doors&r: cottage doors, barn doors, Japanese doors, stable doors."
		""
		"There are Macaw's &etrapdoors, fences, stairs, bridges, paths, lights&r and"
		"&epaintings&r too. Search &e@mcw&r!"
	]
	quest.2647941D62D41D5E.title: "Let There Be Lamps"
	quest.2647941D62D41D5E.quest_desc: [
		"&eMacaw's Lights & Lamps&r: hanging lanterns, paper lamps, street lamps,"
		"tiki torches and lava lamps. A cozy house needs warm lights!"
	]
	quest.70E3224746EC9E2E.title: "Garden Paths"
	quest.70E3224746EC9E2E.quest_desc: [
		"&eMacaw's Paths & Pavings&r turns stone into pretty garden paths."
		"&eMacaw's Bridges&r has rope bridges and stone bridges for crossing rivers."
	]
	quest.6CA9C679562543A0.title: "Another Furniture"
	quest.6CA9C679562543A0.quest_desc: [
		"&eAnother Furniture&r has sofas, curtains, shutters, stools, benches, shelves,"
		"planter boxes and a &eService Bell&r for your shop counter. Ding!"
		""
		"Shelves hold items on display: right-click to place things on them."
	]
	quest.69D8C9521B15D6C5.title: "Every Wood, Every Style"
	quest.69D8C9521B15D6C5.quest_desc: [
		"Found a pretty new wood in another biome or dimension? Good news: &eEvery Compat&r"
		"makes Macaw's, Handcrafted, Another Furniture and other furniture in &aevery wood type&r"
		"from every mod. Search for the wood's name to see them all."
	]
	quest.19A231EB3DF2353A.title: "Little Things"
	quest.19A231EB3DF2353A.quest_desc: [
		"&eSupplementaries&r is full of charming details: &ejars&r (for cookies, fireflies or fish),"
		"sacks, globes, flags, wind vanes, notice boards, signposts, clocks, pedestals,"
		"hourglasses and a &eblackboard&r you can draw on."
		""
		"Put a cookie or a fish in a jar and place it on a shelf. Adorable."
	]
	quest.5FB1C0F28CF27D85.title: "Little Tweaks"
	quest.5FB1C0F28CF27D85.quest_desc: [
		"&eAmendments&r makes vanilla blocks nicer: lanterns can hang on &ewalls&r,"
		"flower pots can &ehang&r from the ceiling, carpets come as stairs and slabs,"
		"banners can hang from ceilings, and you can dye things in a cauldron."
	]
	quest.3292964F7F94CA7A.title: "Pictures from the Internet"
	quest.3292964F7F94CA7A.quest_desc: [
		"A &eWaterFrames Frame&r shows a picture or video from a web link. Put a photo of your"
		"group on the wall, or a TV in your living room! Some websites may not be allowed."
	]
	quest.281E74A5FE4C8423.title: "Sleep Anywhere"
	quest.281E74A5FE4C8423.quest_desc: [
		"A &eSleeping Bag&r is a bed you can carry. Use it while crouching to put it down,"
		"then rest through the night on your adventures."
		""
		"&eHammocks&r are for naps during the &eday&r. Hang one between two"
		"&eRope and Nail&r blocks."
	]
	quest.2F1D18C4F205A098.title: "A Building Wand"
	quest.2F1D18C4F205A098.quest_desc: [
		"A &eBuilding Wand&r places a whole row or wall of blocks at once, copying the blocks"
		"you're looking at. Great for floors and walls."
		""
		"Better wands (iron, diamond, netherite) place more at a time and have more modes."
	]
	quest.753BC9ECAB18DF84.title: "Effortless Building"
	quest.753BC9ECAB18DF84.quest_desc: [
		"&eEffortless Building&r lets you build &elines, walls, floors, circles, spheres&r"
		"and more with a few clicks, using blocks from your inventory. It also has undo and redo!"
		""
		"Open its build-mode menu with its key (set it in &eOptions > Controls&r)."
		"The &eRandomizer Tool&r places random blocks from a mix, great for natural-looking walls."
	]
	quest.28138884B05ABB37.title: "Building Gadgets"
	quest.28138884B05ABB37.quest_desc: [
		"The &eBuilding Gadget&r places big shapes of blocks from a distance, and later gadgets"
		"can copy and paste whole buildings or swap one block for another."
		""
		"Gadgets run on &cpower&r (FE): charge them in a charger from the tech chapters."
	]
	quest.0DE1CA761A658287.title: "No More Monsters at Home"
	quest.0DE1CA761A658287.quest_desc: [
		"Tired of creepers in your garden? The &eMega Torch&r stops hostile monsters from"
		"naturally spawning in a huge area: &e64 blocks in every direction&r around it."
		""
		"It doesn't stop mob spawners or monsters walking in from outside. The &eDread Lamp&r does"
		"the same for passive animals like bats and squid."
	]
	task.3215F01BE60A220D.title: "Build and decorate a house you love"
	quest.2D697EE6293222DE.title: "Decorate a House"
	quest.2D697EE6293222DE.quest_desc: [
		"Time to put it all together! Build a house and make it feel like home:"
		""
		"a roof and windows, comfy chairs and a table, lamps, a bed (or a pet bed!),"
		"a kitchen, plants in pots, and maybe a plushie or two."
		""
		"Show it off to your friends, then click the checkmark. There's no wrong way to do it."
	]
	quest.3A4C73989588ECBE.title: "Where Next?"
	quest.3A4C73989588ECBE.quest_desc: [
		"Your house looks great! Next:"
		""
		"&aStorage&r: chests, drawers and a storage system to keep it tidy."
		"&aFarming & Food&r: a kitchen and a garden to go with it."
		"&aPets & Critters&r: someone to share it with."
		"&bCreate&r chapters: Create Deco adds industrial blocks (and a Create house is fun too)."
	]
	chapter.3F317967CDFC610F.title: "Building & Decorating"
	chapter.3F317967CDFC610F.chapter_subtitle: [
		"Thousands of blocks, comfy furniture and tools that build for you"
	]
	quest.175419932E3D45E9.title: "Where Does It All Go?"
	quest.175419932E3D45E9.quest_desc: [
		"Modded Minecraft means a &elot&r of stuff. Luckily there are great ways to store it:"
		""
		"&eSophisticated Storage&r: chests and barrels that upgrade and get bigger."
		"&eFunctional Storage&r: drawers that hold huge amounts of one item."
		"&eTom's Simple Storage&r: one screen to see and search all your chests."
		""
		"Start small: a few good chests are plenty for a while."
	]
	quest.038E1858CFA6FFBF.title: "A Bigger Backpack"
	quest.038E1858CFA6FFBF.quest_desc: [
		"Your backpack can grow! Craft your backpack with metal around it to upgrade it:"
		"&ecopper&r, &eiron&r, &egold&r, &ediamond&r and finally &enetherite&r."
		"Everything inside stays put, and each tier adds more slots and upgrade slots."
		""
		"Press &eR&r on the Iron Backpack to see the recipe."
	]
	quest.794D9BF15FCD965A.title: "Backpack Upgrades"
	quest.794D9BF15FCD965A.quest_desc: [
		"Upgrades go in the slots on the side of your backpack. Favorites:"
		""
		"&eMagnet&r: pulls nearby items into the backpack."
		"&eCrafting&r: a crafting grid inside your backpack."
		"&eRestock&r and &eDeposit&r: fill up from, or empty into, a chest you click."
		"&eTool Swapper&r: picks the right tool for the block you're mining."
		""
		"Most upgrades start from an &eUpgrade Base&r."
	]
	quest.6446E074F10EE787.title: "Craft on the Go"
	quest.6446E074F10EE787.quest_desc: [
		"A crafting table that lives in your backpack. Never carry a crafting table again!"
	]
	quest.2A35CFD2A4D92C5A.title: "Sophisticated Chests"
	quest.2A35CFD2A4D92C5A.quest_desc: [
		"&eSophisticated Storage&r chests and barrels work like normal ones, but they can be"
		"upgraded and fitted with upgrades, just like your backpack."
		""
		"Paint them with the &ePaintbrush&r or restyle them at the &eDecoration Table&r."
	]
	quest.5FC0848215F14761.title: "Upgrade in Place"
	quest.5FC0848215F14761.quest_desc: [
		"&eTier Upgrades&r turn a chest or barrel into a bigger one &ewithout emptying it&r."
		"Just right-click the chest with the upgrade."
		""
		"Got old vanilla chests? A &eBasic Tier Upgrade&r turns them into sophisticated ones."
	]
	quest.3D672F202C4B6C5A.title: "Smart Chests"
	quest.3D672F202C4B6C5A.quest_desc: [
		"Chest upgrades: &eCompacting&r turns nuggets into ingots and ingots into blocks,"
		"&eSmelting&r cooks what you put in, &eHopper&r pulls items in and out, &eVoid&r deletes junk."
	]
	quest.0B1FFDFAEA02CC1B.title: "Moving House"
	quest.0B1FFDFAEA02CC1B.quest_desc: [
		"Use &ePacking Tape&r on a full chest, then break it: it keeps everything inside,"
		"so you can carry a whole chest to your new base. Each roll has a few uses."
	]
	quest.18E0EC2AE2BEA2C8.title: "Storage Controller"
	quest.18E0EC2AE2BEA2C8.quest_desc: [
		"Build a wall of sophisticated chests and barrels touching each other, then place a"
		"&eStorage Controller&r against them. Now they're one big storage:"
		"put items in through the controller and they go to the right place."
		""
		"Hoppers and pipes can feed the controller too."
	]
	quest.41D985B34AEE11C3.title: "Drawers"
	quest.41D985B34AEE11C3.quest_desc: [
		"A &eDrawer&r holds &elots&r of one kind of item, and shows it on the front."
		"Right-click to put items in, left-click to take a stack out."
		""
		"Perfect for cobblestone, dirt, seeds and other things you collect by the hundreds."
		"2-slot and 4-slot drawers hold several kinds."
	]
	quest.601A9953F62F8E95.title: "Drawer Controller"
	quest.601A9953F62F8E95.quest_desc: [
		"A wall of drawers with a &eStorage Controller&r acts like one: put anything into the"
		"controller and it goes to the matching drawer."
		""
		"Use the &eLinking Tool&r: click the controller, then click your drawers to connect them."
	]
	quest.6CAD30A141EF053A.title: "Squish It Down"
	quest.6CAD30A141EF053A.quest_desc: [
		"A &eCompacting Drawer&r turns nuggets into ingots into blocks automatically,"
		"and gives you whichever size you need."
	]
	quest.3BB285943D1E2F26.title: "Drawer Upgrades"
	quest.3BB285943D1E2F26.quest_desc: [
		"Storage upgrades (copper, gold, diamond, netherite) make each drawer hold far more."
		"There are also &epuller&r, &epusher&r and &evoid&r upgrades."
	]
	quest.1DD53B0B1D8C1FB9.title: "One Screen for Everything"
	quest.1DD53B0B1D8C1FB9.quest_desc: [
		"&eTom's Simple Storage&r: place an &eInventory Connector&r touching your chests"
		"(or link more chests with &eInventory Cable&r), then put a &eStorage Terminal&r on it."
		""
		"The terminal shows &eeverything&r in all connected chests. Search, sort, and take"
		"what you need. Drawers and sophisticated chests work too!"
	]
	quest.53A9557C86F6A159.title: "Crafting Terminal"
	quest.53A9557C86F6A159.quest_desc: [
		"A terminal with a crafting grid. It pulls ingredients straight out of your storage."
		"Press &eR&r on an item and use EMI's &e+&r button to fill the grid for you."
	]
	quest.2A33D17E4DEFC683.title: "You've Got Mail!"
	quest.2A33D17E4DEFC683.quest_desc: [
		"Send gifts to your friends! Place a &eMailbox&r at your house and give it a name."
		""
		"At a &ePost Box&r, pick a mailbox from the list (type &e@name&r to find a player),"
		"put items in the package, add a message, and press &eSend&r."
		"Your friend finds the package waiting in their mailbox."
	]
	quest.7BB598B7828E499E.title: "Handy Helpers"
	quest.7BB598B7828E499E.quest_desc: [
		"Two small things that make life easier:"
		""
		"&eShulker Box Tooltip&r: hover over a shulker box (and other containers)"
		"to peek inside without opening it."
		"&eLocked In Slots&r: lock a hotbar or inventory slot so you never drop or move"
		"that item by mistake. Find its key in &eOptions > Controls&r."
		""
		"Inventory Profiles Next also adds a &esort&r button to every chest."
	]
	quest.228C325FDE18B972.title: "Where Next?"
	quest.228C325FDE18B972.quest_desc: [
		"Your stuff is safe and tidy! When you outgrow chests:"
		""
		"&bApplied Energistics 2&r (in the Tech chapters) stores items as data on drives."
		"Thousands of items in one computer, with autocrafting!"
		""
		"&aBuilding & Decorating&r: make your storage room look nice too."
	]
	chapter.0E77E388D0A9F0D1.title: "Storage"
	chapter.0E77E388D0A9F0D1.chapter_subtitle: [
		"Bigger chests, drawers, a storage terminal and mail for friends"
	]
	quest.35079D9D82841DCA.title: "Gone Fishing"
	quest.35079D9D82841DCA.quest_desc: [
		"Fishing in Strata is a whole hobby! &eTide&r adds a &efishing journal&r with"
		"over a hundred fish to discover, and &eAquaculture&r adds more fish, hooks and tools."
		""
		"Different fish live in different places: rivers, oceans, caves, lava, even the End."
		"Time of day, weather and the moon matter too."
		""
		"Grab a rod and find a quiet pond. It's a great way to relax!"
	]
	task.14EB403C15642AAB.title: "Catch a fish"
	quest.5593EDB730F985FC.title: "First Catch"
	quest.5593EDB730F985FC.quest_desc: [
		"Cast your rod into water and wait for a bite."
		""
		"When a fish bites, a little &eminigame&r appears: keep up with the fish to reel it in."
		"Bigger, rarer fish fight harder. Don't worry if one gets away, there are plenty more!"
	]
	quest.257E8EB054A914BC.title: "The Fishing Journal"
	quest.257E8EB054A914BC.quest_desc: [
		"Craft a &eFishing Journal&r (a book and any fish). Every new fish you catch gets its own"
		"page with a picture and a fun fact."
		""
		"Can you fill it? Some fish only bite at night, in the rain, or in special places."
	]
	quest.73C74234D2EB29E1.title: "Bait"
	quest.73C74234D2EB29E1.quest_desc: [
		"Fish bite faster with &eBait&r. Craft it from a plant, rotten flesh, seeds and bone meal."
		""
		"Tide rods have &ebait slots&r: in your inventory, pick up the bait and"
		"right-click it onto your rod. Special baits add luck or a better chance of crates"
		"(the tooltip says what each one does)."
	]
	quest.62E11347F6675C1A.title: "The Angling Table"
	quest.62E11347F6675C1A.quest_desc: [
		"At the &eAngling Table&r you customise your rod with a &ebobber&r, a &ehook&r and a"
		"&eline&r. Lines make fish easier to catch, special hooks let you fish in new places,"
		"and bobbers just look cute. Try the duck!"
	]
	quest.638B5BF16CEA794E.title: "A Stronger Line"
	quest.638B5BF16CEA794E.quest_desc: [
		"An &eIron Line&r makes fish easier to catch. Diamond lines are even better,"
		"and golden lines add some luck. Put it on your rod at the Angling Table."
	]
	quest.794740CE2EA800D0.title: "A Better Rod"
	quest.794740CE2EA800D0.quest_desc: [
		"Upgrade your rod at a &eSmithing Table&r: a fishing rod, an iron ingot and string"
		"make an &eIron Fishing Rod&r. Gold, diamond and netherite rods come after."
		""
		"Better rods reel in faster and handle tougher fish."
	]
	task.106000E16E1C8FB3.title: "Reel in a crate"
	quest.6AE87F164CF5B52D.title: "That's No Fish!"
	quest.6AE87F164CF5B52D.quest_desc: [
		"Sometimes you'll hook a &ecrate&r instead of a fish. Open it for treasure:"
		"supplies, fishing gear and sometimes rare loot."
	]
	quest.66718EEE5A78EE3E.title: "Show It Off"
	quest.66718EEE5A78EE3E.quest_desc: [
		"Caught a whopper? Put it on a &eFish Display&r and hang it on your wall."
	]
	quest.4E2C3F9B9CE59C81.title: "Fish Satchel"
	quest.4E2C3F9B9CE59C81.quest_desc: [
		"Right-click a &eFish Satchel&r to open it. While it's open,"
		"fish you catch go straight inside. Tidy!"
	]
	task.4DC6067947531E3B.title: "Fish in lava"
	quest.4BC32DC5C3B3C1F3.title: "Fishing in Lava"
	quest.4BC32DC5C3B3C1F3.quest_desc: [
		"With a &eLavaproof Hook&r on your rod you can fish in &clava&r! The Nether has its own"
		"fiery fish. Bring fire resistance, and maybe a friend."
	]
	task.2523E54AA14DDA8B.title: "Complete half the fishing journal"
	quest.72CF50B8DA2A09F1.title: "Aquatic Archivist"
	quest.72CF50B8DA2A09F1.quest_desc: [
		"Fill &ehalf&r of your fishing journal. That's a lot of fish!"
		"Check the journal for hints about where and when the missing ones bite."
	]
	quest.528EFF2B28E74A25.title: "Aquaculture"
	quest.528EFF2B28E74A25.quest_desc: [
		"&eAquaculture&r adds its own fish (catfish, tuna, piranhas, turtles and more)"
		"and its own fishing rods."
		""
		"Aquaculture rods take &ehooks&r, &ebait&r, a &eline&r and a &ebobber&r."
		"Each hook does something: the gold hook adds luck, the light hook casts farther,"
		"the double hook can catch two things at once."
	]
	quest.4C06D6FD7350B569.title: "Wiggly Worms"
	quest.4C06D6FD7350B569.quest_desc: [
		"&eWorms&r are Aquaculture's favorite bait. A &eWorm Farm&r (made with dirt) gives you"
		"a steady supply. Put bait on your Aquaculture rod to catch fish faster."
	]
	quest.70EC6C72DAFBCF05.title: "Tackle Box"
	quest.70EC6C72DAFBCF05.quest_desc: [
		"The &eTackle Box&r stores all your hooks, bait and bobbers, and it's where you put"
		"them on your Aquaculture rod. Place it by your favorite fishing spot."
	]
	quest.5F9DBF9F639CBB25.title: "Fish Fillets"
	quest.5F9DBF9F639CBB25.quest_desc: [
		"Craft a fish together with a &eFillet Knife&r to cut it into &eFish Fillets&r."
		"Cook them for a tasty, filling meal. Big fish give more fillets."
	]
	quest.7184375B78E1BA55.title: "Neptune's Treasure"
	quest.7184375B78E1BA55.quest_desc: [
		"Very rarely you'll fish up &eNeptunium&r, or a &eNeptune's Bounty&r chest full of it."
		"Neptunium gear is made for the sea: armor that lets you breathe and swim fast underwater,"
		"tools that work at full speed under water, and a rod that fish love."
	]
	quest.237C79F3D80403D7.title: "Life Under the Sea"
	quest.237C79F3D80403D7.quest_desc: [
		"&eUpgrade Aquatic&r makes the water more alive: pike, perch and lionfish to catch,"
		"glowing &ejellyfish&r, nautiluses, new coral and driftwood on the beaches."
		""
		"Jellyfish make pretty &eJelly Torches&r that work underwater."
		"Beachgrass and driftwood are great for a seaside cottage!"
	]
	quest.3548DCC2AFC0A8F3.title: "Seafood Feast"
	quest.3548DCC2AFC0A8F3.quest_desc: [
		"Cook your catch! &eOcean's Delight&r adds seafood recipes for Farmer's Delight:"
		"squid rings, stuffed cod, guardian soup, fugu rolls and more."
		""
		"Cut squid on a cutting board for tentacles, then cook them up."
		"Farmer's Delight's &eFish Stew&r is a cozy classic."
	]
	quest.4BFFED305499B246.title: "Where Next?"
	quest.4BFFED305499B246.quest_desc: [
		"You're a real angler now! Where next?"
		""
		"&aFarming & Food&r: fish count toward your varied diet."
		"&aPets & Critters&r: cats love fish, and otters live by rivers."
		"&aExplorer's Guide&r: new dimensions mean new fish for the journal."
	]
	chapter.47D27CD163EA5FE4.title: "Fishing"
	chapter.47D27CD163EA5FE4.chapter_subtitle: [
		"Hundreds of fish, a fishing journal and a quiet afternoon by the water"
	]
}
